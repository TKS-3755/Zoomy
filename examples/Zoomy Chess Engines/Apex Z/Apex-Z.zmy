    set item 468 of tb_kk to 378
    set item 469 of tb_kk to 379
    set item 470 of tb_kk to 380
    set item 471 of tb_kk to 381
    set item 475 of tb_kk to 448
    set item 476 of tb_kk to 382
    set item 477 of tb_kk to 383
    set item 478 of tb_kk to 384
    set item 479 of tb_kk to 385
    set item 484 of tb_kk to 449
    set item 485 of tb_kk to 386
    set item 486 of tb_kk to 387
    set item 487 of tb_kk to 388
    set item 493 of tb_kk to 450
    set item 494 of tb_kk to 389
    set item 495 of tb_kk to 390
    set item 502 of tb_kk to 451
    set item 503 of tb_kk to 391
    set item 511 of tb_kk to 452
    set item 512 of tb_kk to 453
    set item 513 of tb_kk to 392
    set item 514 of tb_kk to 393
    set item 515 of tb_kk to 394
    set item 516 of tb_kk to 395
    set item 517 of tb_kk to 396
    set item 518 of tb_kk to 397
    set item 519 of tb_kk to 398
    set item 524 of tb_kk to 399
    set item 525 of tb_kk to 400
    set item 526 of tb_kk to 401
    set item 527 of tb_kk to 402
    set item 532 of tb_kk to 403
    set item 533 of tb_kk to 404
    set item 534 of tb_kk to 405
    set item 535 of tb_kk to 406
    set item 540 of tb_kk to 407
    set item 541 of tb_kk to 408
    set item 542 of tb_kk to 409
    set item 543 of tb_kk to 410
    set item 548 of tb_kk to 454
    set item 549 of tb_kk to 411
    set item 550 of tb_kk to 412
    set item 551 of tb_kk to 413
    set item 557 of tb_kk to 455
    set item 558 of tb_kk to 414
    set item 559 of tb_kk to 415
    set item 566 of tb_kk to 456
    set item 567 of tb_kk to 416
    set item 575 of tb_kk to 457
    set item 576 of tb_kk to 458
    set item 577 of tb_kk to 417
    set item 578 of tb_kk to 418
    set item 579 of tb_kk to 419
    set item 580 of tb_kk to 420
    set item 581 of tb_kk to 421
    set item 582 of tb_kk to 422
    set item 583 of tb_kk to 423
    set item 585 of tb_kk to 459
    set item 586 of tb_kk to 424
    set item 587 of tb_kk to 425
    set item 588 of tb_kk to 426
    set item 589 of tb_kk to 427
    set item 590 of tb_kk to 428
    set item 591 of tb_kk to 429
    set item 597 of tb_kk to 430
    set item 598 of tb_kk to 431
    set item 599 of tb_kk to 432
    set item 605 of tb_kk to 433
    set item 606 of tb_kk to 434
    set item 607 of tb_kk to 435
    set item 613 of tb_kk to 436
    set item 614 of tb_kk to 437
    set item 615 of tb_kk to 438
    set item 621 of tb_kk to 460
    set item 622 of tb_kk to 439
    set item 623 of tb_kk to 440
    set item 630 of tb_kk to 461
    set item 631 of tb_kk to 441
    set item 639 of tb_kk to 462

routine tb_init_tables:
    run tb_init_consts
    Let a number be called f
    Let a number be called l
    Let a number be called s
    set item 0 of tb_wdl2map to 1
    set item 1 of tb_wdl2map to 3
    set item 2 of tb_wdl2map to 0
    set item 3 of tb_wdl2map to 2
    set item 4 of tb_wdl2map to 0
    set item 0 of tb_paflags to 8
    set item 4 of tb_paflags to 4
    set tb_min to 1
    shift tb_min left by 63 bits
    for r from 0 to 7:
        for c from 0 to 7:
            set item ((r * 8) + c) of tb_flipdiag to (c * 8) + r
            if r is greater than c:
                set item ((r * 8) + c) of tb_offdiag to 1
            if r is less than c:
                set item ((r * 8) + c) of tb_offdiag to -1
    for k from 0 to 6:
        for n from 0 to 63:
            set f to 1
            set l to 1
            for j from 0 to k - 1:
                set f to f * (n - j)
                set l to l * (j + 1)
            set item ((k * 64) + n) of tb_binom to f / l
    for i from 0 to 5:
        set s to 0
        for j from 0 to 23:
            set item ((i * 24) + j) of tb_pidx to s
            add item ((i * 64) + item (((1 + (j mod 6)) * 8) + (j / 6)) of tb_twist) of tb_binom to s
            if (j + 1) mod 6 is 0:
                set item ((i * 4) + (j / 6)) of tb_pff to s
                set s to 0
    for i from 0 to 5:
        set s to 0
        for j from 0 to 23:
            set item (144 + (i * 24) + j) of tb_pidx to s
            add item ((i * 64) + item (64 + ((1 + (j / 4)) * 8) + (j mod 4)) of tb_twist) of tb_binom to s
            if (j + 1) mod 4 is 0:
                set item ((i * 6) + (j / 4)) of tb_pfr to s
                set s to 0

(Port of init_enc_info - reads the piece order of one side of one table from the header)
define tb_init_enc with eb and foff and shf and t:
    Let a number be called morep
    Let a number be called i
    Let a number be called j
    Let a number be called k
    Let a number be called order
    Let a number be called order2
    Let a number be called n
    Let a number be called f
    Let a number be called v
    Let a number be called n0
    Let a number be called nk
    set morep to 0
    if tb_haspawns is 1 and tb_p1 is greater than 0:
        set morep to 1
    for i from 0 to tb_num - 1:
        set v to tb_at8(foff + i + 1 + morep)
        if shf is 4:
            set v to v / 16
        else:
            set v to v mod 16
        set item (eb + i) of tb_pool to v
        set item (eb + 7 + i) of tb_pool to 0
    set v to tb_at8(foff)
    if shf is 4:
        set order to v / 16
    else:
        set order to v mod 16
    set order2 to 15
    if morep is 1:
        set v to tb_at8(foff + 1)
        if shf is 4:
            set order2 to v / 16
        else:
            set order2 to v mod 16
    if tb_haspawns is 1:
        set k to tb_p0
    else if tb_kkenc is 1:
        set k to 2
    else:
        set k to 3
    set item (eb + 7) of tb_pool to k
    if morep is 1:
        set item (eb + 7 + k) of tb_pool to tb_p1
        add tb_p1 to k
    set i to k
    while i is less than tb_num:
        set j to i
        while j is less than tb_num and item (eb + j) of tb_pool is item (eb + i) of tb_pool:
            add 1 to item (eb + 7 + i) of tb_pool
            add 1 to j
        add item (eb + 7 + i) of tb_pool to i
    set n to 64 - k
    set f to 1
    set i to 0
    set n0 to item (eb + 7) of tb_pool
    while k is less than tb_num or i is order or i is order2:
        if i is order:
            set item (eb + 14) of tb_pool to f
            if tb_haspawns is 1:
                set f to f * item (((n0 - 1) * 4) + t) of tb_pff
            else if tb_kkenc is 1:
                set f to f * 462
            else:
                set f to f * 31332
        else if i is order2:
            set item (eb + 14 + n0) of tb_pool to f
            set f to f * tb_subfactor(item (eb + 7 + n0) of tb_pool, 48 - n0)
        else:
            set nk to item (eb + 7 + k) of tb_pool
            set item (eb + 14 + k) of tb_pool to f
            set f to f * tb_subfactor(nk, n)
            subtract nk from n
            add nk to k
        add 1 to i
    give back f

(Port of setup_pairs - the compressed-block header at foff.  Leaves the position after itab in tb_np and)
(the three region sizes in tb_sz0 tb_sz1 tb_sz2.  The symbol tables are read later, on first use.)
define tb_setup_pairs with foff and tbsize and type:
    Let a number be called pr
    Let a number be called flags
    Let a number be called blk
    Let a number be called ib
    Let a number be called real
    Let a number be called nblocks
    Let a number be called maxl
    Let a number be called minl
    Let a number be called h
    Let a number be called nsyms
    Let a number be called x
    Let a number be called pw
    set pr to tb_alloc(112)
    set flags to tb_at8(foff)
    set item (pr + 7) of tb_pool to flags
    if flags is at least 128:
        set item (pr + 0) of tb_pool to 1
        set item (pr + 1) of tb_pool to 0
        set item (pr + 6) of tb_pool to 0
        if type is 0:
            set item (pr + 6) of tb_pool to tb_at8(foff + 1)
        set tb_np to foff + 2
        set tb_sz0 to 0
        set tb_sz1 to 0
        set tb_sz2 to 0
        give back pr
    set blk to tb_at8(foff + 1)
    set ib to tb_at8(foff + 2)
    set real to tb_at32(foff + 4)
    set nblocks to real + tb_at8(foff + 3)
    set maxl to tb_at8(foff + 8)
    set minl to tb_at8(foff + 9)
    set h to (maxl - minl) + 1
    if h is greater than 48 or h is less than 1:
        give back -1
    set nsyms to tb_at16(foff + 10 + (2 * h))
    for i from 0 to h - 1:
        set item (pr + 14 + i) of tb_pool to tb_at16(foff + 10 + (2 * i))
    set item (pr + 0) of tb_pool to 0
    set item (pr + 1) of tb_pool to ib
    set item (pr + 2) of tb_pool to blk
    set item (pr + 3) of tb_pool to minl
    set item (pr + 4) of tb_pool to h
    set item (pr + 5) of tb_pool to nsyms
    set item (pr + 11) of tb_pool to foff + 12 + (2 * h)
    set tb_np to foff + 12 + (2 * h) + (3 * nsyms) + (nsyms mod 2)
    set pw to 1
    shift pw left by ib bits
    set x to (tbsize + pw) - 1
    shift x right by ib bits
    set tb_sz0 to 6 * x
    set tb_sz1 to 2 * nblocks
    set x to real
    shift x left by blk bits
    set tb_sz2 to x
    give back pr

(Symbol length, by recursion over the symbol pairs)
define tb_symlen with pr and s:
    Let a number be called w
    Let a number be called s1
    Let a number be called s2
    Let a number be called slen
    Let a number be called spat
    Let a number be called slbase
    set spat to item (pr + 13) of tb_pool
    set slbase to item (pr + 12) of tb_pool
    set w to item (spat + s) of tb_pool
    set s2 to ((w / 65536) * 16) + (((w / 256) mod 256) / 16)
    if s2 is 4095:
        set item (slbase + s) of tb_pool to 1
        give back 0
    set s1 to (((w / 256) mod 16) * 256) + (w mod 256)
    if item (slbase + s1) of tb_pool is 0:
        call tb_symlen with pr and s1
    if item (slbase + s2) of tb_pool is 0:
        call tb_symlen with pr and s2
    set slen to (item (slbase + s1) of tb_pool - 1) + (item (slbase + s2) of tb_pool - 1) + 1
    set item (slbase + s) of tb_pool to slen + 1
    give back slen

(First use of a pair - read the symbol table, work out the symbol lengths and the code bases)
define tb_pair_prep with pr:
    Let a number be called ns
    Let a number be called spat
    Let a number be called slen
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called h
    Let a number be called mlen
    Let a number be called bs
    Let a number be called nx
    Let a number be called sh
    set ns to item (pr + 5) of tb_pool
    set slen to tb_alloc(ns + 2)
    set spat to tb_alloc(ns + 2)
    set item (pr + 12) of tb_pool to slen
    set item (pr + 13) of tb_pool to spat
    move to byte (item (pr + 11) of tb_pool) of the file
    for s from 0 to ns - 1:
        read the next byte into b0
        read the next byte into b1
        read the next byte into b2
        set item (spat + s) of tb_pool to b0 + (b1 * 256) + (b2 * 65536)
        set item (slen + s) of tb_pool to 0
    for s from 0 to ns - 1:
        if item (slen + s) of tb_pool is 0:
            call tb_symlen with pr and s
    set h to item (pr + 4) of tb_pool
    set mlen to item (pr + 3) of tb_pool
    set bs to 0
    set item (pr + 62 + h - 1) of tb_pool to tb_min
    for i from h - 2 to 0 step -1:
        set nx to bs + item (pr + 14 + i) of tb_pool - item (pr + 15 + i) of tb_pool
        set bs to nx / 2
        set sh to 64 - (mlen + i)
        set nx to bs
        shift nx left by sh bits
        bitwise xor nx with tb_min
        set item (pr + 62 + i) of tb_pool to nx
    set sh to 64 - (mlen + h - 1)
    set nx to 0
    bitwise xor nx with tb_min
    set item (pr + 62 + h - 1) of tb_pool to nx
    set item (pr + 0) of tb_pool to 1
    give back 0

(Name of table file for the material in tb_cnt - dir/KQRvKB.rtbw  flip 1 puts the black pieces first)
define tb_put with ch:
    set item tb_fl of tb_fn to ch
    add 1 to tb_fl
    give back 0

define tb_letter with code:
    if code is 6:
        give back 75
    if code is 5:
        give back 81
    if code is 4:
        give back 82
    if code is 3:
        give back 66
    if code is 2:
        give back 78
    give back 80

define tb_name with flip and ty and di:
    Let a number be called i
    Let a number be called col
    set tb_fl to 0
    set i to item di of tb_dstart
    while item i of tb_dirs is not 0 and item i of tb_dirs is not 58:
        call tb_put with item i of tb_dirs
        add 1 to i
    call tb_put with 47
    for side from 0 to 1:
        set col to side
        if flip is 1:
            set col to 1 - side
        for code from 6 to 1 step -1:
            for k from 1 to item ((col * 8) + code) of tb_cnt:
                call tb_put with tb_letter(code)
        if side is 0:
            call tb_put with 118
    call tb_put with 46
    call tb_put with 114
    call tb_put with 116
    call tb_put with 98
    if ty is 0:
        call tb_put with 119
    else:
        call tb_put with 122
    call tb_put with 0
    give back 0

(Tries every directory - gives back the directory number + 1 and leaves the file open, or 0)
define tb_open_table with flip and ty:
    for di from 0 to tb_dirn - 1:
        call tb_name with flip and ty and di
        open the file named by tb_fn for reading
        if input_ok is 1:
            give back di + 1
    give back 0

(Port of init_table - reads the header of the file for the material in tb_cnt into the meta record at mb.)
(Leaves the file open when itab gives back 1.)
define tb_load with key2 and ty and mb:
    Let a number be called found
    Let a number be called flip
    Let a number be called sym
    Let a number be called c
    Let a number be called j
    Let a number be called numt
    Let a number be called split
    Let a number be called eb
    Let a number be called foff
    Let a number be called t
    Let a number be called pr
    Let a number be called q
    Let a number be called morep
    Let a number be called fl
    Let a number be called tmp
    Let a number be called ts0
    Let a number be called ts1
    Let a number be called mb2
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called b3
    Let a number be called mp
    Let a number be called nflip
    set item mb of tb_meta to key2 + 1
    set item (mb + 1) of tb_meta to 0
    set item (mb + 2) of tb_meta to ty
    set sym to 1
    for c from 1 to 6:
        if item c of tb_cnt is not item (c + 8) of tb_cnt:
            set sym to 0
    set flip to 0
    set found to tb_open_table(0, ty)
    if found is 0 and sym is 0:
        set found to tb_open_table(1, ty)
        set flip to 1
    if found is 0:
        give back 0
    (the own piece counts of the file - its white side first)
    set tb_num to 0
    set j to 0
    for c from 1 to 14:
        if c is 7 or c is 8:
            skip
        set q to item c of tb_cnt
        if flip is 1:
            if c is at most 6:
                set q to item (c + 8) of tb_cnt
            else:
                set q to item (c - 8) of tb_cnt
        add q to tb_num
        if q is 1:
            add 1 to j
    set tb_kkenc to 0
    if j is 2:
        set tb_kkenc to 1
    set tb_haspawns to 0
    set tb_p0 to item 1 of tb_cnt
    set tb_p1 to item 9 of tb_cnt
    if flip is 1:
        set tb_p0 to item 9 of tb_cnt
        set tb_p1 to item 1 of tb_cnt
    if tb_p0 is greater than 0 or tb_p1 is greater than 0:
        set tb_haspawns to 1
        if tb_p1 is greater than 0 and (tb_p0 is 0 or tb_p0 is greater than tb_p1):
            set tmp to tb_p0
            set tb_p0 to tb_p1
            set tb_p1 to tmp
    if tb_num is greater than 7:
        give back 0
    (check the magic number)
    set tmp to tb_at32(0)
    if ty is 0 and tmp is not 1562634353:
        give back 0
    if ty is 2 and tmp is not 2769053399:
        give back 0
    set split to 0
    if ty is not 2:
        set tmp to tb_at8(4)
        set split to tmp mod 2
    set numt to 1
    if tb_haspawns is 1:
        set numt to 4
    set eb to tb_alloc(24 * 2 * numt)
    set foff to 5
    set morep to 0
    if tb_haspawns is 1 and tb_p1 is greater than 0:
        set morep to 1
    for t from 0 to numt - 1:
        set ts0 to tb_init_enc(eb + (24 * t), foff, 0, t)
        set item (eb + 22 + (24 * t)) of tb_pool to ts0
        if split is 1:
            set ts1 to tb_init_enc(eb + (24 * (numt + t)), foff, 4, t)
            set item (eb + 22 + (24 * (numt + t))) of tb_pool to ts1
        add tb_num + 1 + morep to foff
    add foff mod 2 to foff
    (the compressed block headers)
    for t from 0 to numt - 1:
        set pr to tb_setup_pairs(foff, item (eb + 22 + (24 * t)) of tb_pool, ty)
        if pr is less than 0:
            give back 0
        set item (eb + 21 + (24 * t)) of tb_pool to pr
        set item (pr + 8) of tb_pool to tb_sz0
        set item (pr + 9) of tb_pool to tb_sz1
        set item (pr + 10) of tb_pool to tb_sz2
        set foff to tb_np
        set item (mb + 14 + t) of tb_meta to item (pr + 7) of tb_pool
        if split is 1:
            set pr to tb_setup_pairs(foff, item (eb + 22 + (24 * (numt + t))) of tb_pool, ty)
            if pr is less than 0:
                give back 0
            set item (eb + 21 + (24 * (numt + t))) of tb_pool to pr
            set item (pr + 8) of tb_pool to tb_sz0
            set item (pr + 9) of tb_pool to tb_sz1
            set item (pr + 10) of tb_pool to tb_sz2
            set foff to tb_np
    (the DTZ value maps)
    set item (mb + 13) of tb_meta to foff
    set mp to foff
    if ty is 2:
        for t from 0 to numt - 1:
            set fl to item (mb + 14 + t) of tb_meta
            if (fl / 2) mod 2 is 1:
                if (fl / 16) mod 2 is 0:
                    for i from 0 to 3:
                        set item (mb + 18 + (4 * t) + i) of tb_meta to (foff + 1) - mp
                        set tmp to tb_at8(foff)
                        add 1 + tmp to foff
                else:
                    add foff mod 2 to foff
                    for i from 0 to 3:
                        set item (mb + 18 + (4 * t) + i) of tb_meta to ((foff + 2) - mp) / 2
                        set tmp to tb_at16(foff)
                        add 2 + (2 * tmp) to foff
        add foff mod 2 to foff
    (index tables, size tables, data blocks)
    for t from 0 to numt - 1:
        set pr to item (eb + 21 + (24 * t)) of tb_pool
        set tmp to item (pr + 8) of tb_pool
        set item (pr + 8) of tb_pool to foff
        add tmp to foff
        if split is 1:
            set pr to item (eb + 21 + (24 * (numt + t))) of tb_pool
            set tmp to item (pr + 8) of tb_pool
            set item (pr + 8) of tb_pool to foff
            add tmp to foff
    for t from 0 to numt - 1:
        set pr to item (eb + 21 + (24 * t)) of tb_pool
        set tmp to item (pr + 9) of tb_pool
        set item (pr + 9) of tb_pool to foff
        add tmp to foff
        if split is 1:
            set pr to item (eb + 21 + (24 * (numt + t))) of tb_pool
            set tmp to item (pr + 9) of tb_pool
            set item (pr + 9) of tb_pool to foff
            add tmp to foff
    for t from 0 to numt - 1:
        set foff to ((foff + 63) / 64) * 64
        set pr to item (eb + 21 + (24 * t)) of tb_pool
        set tmp to item (pr + 10) of tb_pool
        set item (pr + 10) of tb_pool to foff
        add tmp to foff
        if split is 1:
            set foff to ((foff + 63) / 64) * 64
            set pr to item (eb + 21 + (24 * (numt + t))) of tb_pool
            set tmp to item (pr + 10) of tb_pool
            set item (pr + 10) of tb_pool to foff
            add tmp to foff
    set item (mb + 3) of tb_meta to tb_num
    set item (mb + 4) of tb_meta to tb_haspawns
    set item (mb + 5) of tb_meta to sym
    set item (mb + 6) of tb_meta to tb_kkenc
    set item (mb + 7) of tb_meta to tb_p0
    set item (mb + 8) of tb_meta to tb_p1
    set item (mb + 9) of tb_meta to split
    set item (mb + 10) of tb_meta to numt
    set item (mb + 11) of tb_meta to flip
    set item (mb + 12) of tb_meta to found - 1
    set item (mb + 34) of tb_meta to eb
    set item (mb + 1) of tb_meta to 1
    give back 1

(Port of encode - the index of the position held in tb_p, for the piece order at eb)
define tb_encode with eb and enc:
    Let a number be called n
    Let a number be called i
    Let a number be called j
    Let a number be called k
    Let a number be called idx
    Let a number be called s1
    Let a number be called s2
    Let a number be called tmp
    Let a number be called t
    Let a number be called s
    Let a number be called sq
    Let a number be called skips
    Let a number be called f0
    Let a number be called twb
    set n to tb_num
    set f0 to item (eb + 14) of tb_pool
    if (item 0 of tb_p / 4) mod 2 is 1:
        for i from 0 to n - 1:
            bitwise xor item i of tb_p with 7
    if enc is 0:
        if (item 0 of tb_p / 32) mod 2 is 1:
            for i from 0 to n - 1:
                bitwise xor item i of tb_p with 56
        for i from 0 to n - 1:
            if item (item i of tb_p) of tb_offdiag is not 0:
                if item (item i of tb_p) of tb_offdiag is greater than 0:
                    set tmp to 3
                    if tb_kkenc is 1:
                        set tmp to 2
                    if i is less than tmp:
                        for j from 0 to n - 1:
                            set item j of tb_p to item (item j of tb_p) of tb_flipdiag
                stop
        if tb_kkenc is 1:
            set idx to item ((item (item 0 of tb_p) of tb_triangle * 64) + item 1 of tb_p) of tb_kk - 1
            set k to 2
        else:
            set s1 to 0
            if item 1 of tb_p is greater than item 0 of tb_p:
                set s1 to 1
            set s2 to 0
            if item 2 of tb_p is greater than item 0 of tb_p:
                add 1 to s2
            if item 2 of tb_p is greater than item 1 of tb_p:
                add 1 to s2
            if item (item 0 of tb_p) of tb_offdiag is not 0:
                set idx to (item (item 0 of tb_p) of tb_triangle * 63 * 62) + ((item 1 of tb_p - s1) * 62) + (item 2 of tb_p - s2)
            else if item (item 1 of tb_p) of tb_offdiag is not 0:
                set idx to (6 * 63 * 62) + (item (item 0 of tb_p) of tb_diag * 28 * 62) + (item (item 1 of tb_p) of tb_lower * 62) + item 2 of tb_p - s2
            else if item (item 2 of tb_p) of tb_offdiag is not 0:
                set idx to (6 * 63 * 62) + (4 * 28 * 62) + (item (item 0 of tb_p) of tb_diag * 7 * 28) + ((item (item 1 of tb_p) of tb_diag - s1) * 28) + item (item 2 of tb_p) of tb_lower
            else:
                set idx to (6 * 63 * 62) + (4 * 28 * 62) + (4 * 7 * 28) + (item (item 0 of tb_p) of tb_diag * 7 * 6) + ((item (item 1 of tb_p) of tb_diag - s1) * 6) + (item (item 2 of tb_p) of tb_diag - s2)
            set k to 3
        set idx to idx * f0
    else:
        for i from 1 to tb_p0 - 1:
            for j from i + 1 to tb_p0 - 1:
                if item (item i of tb_p) of tb_twist is less than item (item j of tb_p) of tb_twist:
                    set tmp to item i of tb_p
                    set item i of tb_p to item j of tb_p
                    set item j of tb_p to tmp
        set k to tb_p0
        set idx to item (((k - 1) * 24) + item (item 0 of tb_p) of tb_flap) of tb_pidx
        for i from 1 to k - 1:
            add item (((k - i) * 64) + item (item i of tb_p) of tb_twist) of tb_binom to idx
        set idx to idx * f0
        if tb_p1 is greater than 0:
            set t to k + tb_p1
            for i from k to t - 1:
                for j from i + 1 to t - 1:
                    if item i of tb_p is greater than item j of tb_p:
                        set tmp to item i of tb_p
                        set item i of tb_p to item j of tb_p
                        set item j of tb_p to tmp
            set s to 0
            for i from k to t - 1:
                set sq to item i of tb_p
                set skips to 0
                for j from 0 to k - 1:
                    if sq is greater than item j of tb_p:
                        add 1 to skips
                add item ((((i - k) + 1) * 64) + ((sq - skips) - 8)) of tb_binom to s
            add s * item (eb + 14 + k) of tb_pool to idx
            set k to t
    while k is less than n:
        set t to k + item (eb + 7 + k) of tb_pool
        for i from k to t - 1:
            for j from i + 1 to t - 1:
                if item i of tb_p is greater than item j of tb_p:
                    set tmp to item i of tb_p
                    set item i of tb_p to item j of tb_p
                    set item j of tb_p to tmp
        set s to 0
        for i from k to t - 1:
            set sq to item i of tb_p
            set skips to 0
            for j from 0 to k - 1:
                if sq is greater than item j of tb_p:
                    add 1 to skips
            add item ((((i - k) + 1) * 64) + (sq - skips)) of tb_binom to s
        add s * item (eb + 14 + k) of tb_pool to idx
        set k to t
    give back idx

(Port of decompress_pairs - the two bytes stored for index idx, as w0 + 256 * w1)
define tb_decode with pr and idx:
    Let a number be called ib
    Let a number be called main
    Let a number be called lit
    Let a number be called block
    Let a number be called pw
    Let a number be called low
    Let a number be called itab
    Let a number be called stab
    Let a number be called mlen
    Let a number be called l
    Let a number be called code
    Let a number be called cb
    Let a number be called bitcnt
    Let a number be called sym
    Let a number be called slen
    Let a number be called spat
    Let a number be called x
    Let a number be called tmp
    Let a number be called w
    Let a number be called s1
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called b3
    Let a number be called ptr
    Let a number be called going
    set ib to item (pr + 1) of tb_pool
    if ib is 0:
        give back item (pr + 6) of tb_pool
    if item (pr + 0) of tb_pool is 0:
        call tb_pair_prep with pr
    set itab to item (pr + 8) of tb_pool
    set stab to item (pr + 9) of tb_pool
    set slen to item (pr + 12) of tb_pool
    set spat to item (pr + 13) of tb_pool
    set mlen to item (pr + 3) of tb_pool
    set main to idx
    shift main right by ib bits
    set pw to 1
    shift pw left by ib bits
    set low to idx
    set tmp to pw - 1
    bitwise and low with tmp
    set lit to low - (pw / 2)
    set tmp to itab + (6 * main)
    set block to tb_at32(tmp)
    add tb_at16(tmp + 4) to lit
    if lit is less than 0:
        while lit is less than 0:
            subtract 1 from block
            add tb_at16(stab + (2 * block)) + 1 to lit
    else:
        set x to tb_at16(stab + (2 * block))
        while lit is greater than x:
            subtract x + 1 from lit
            add 1 to block
            set x to tb_at16(stab + (2 * block))
    set ptr to item (pr + 10) of tb_pool
    set x to block
    shift x left by item (pr + 2) of tb_pool bits
    add x to ptr
    move to byte ptr of the file
    set code to 0
    for i from 1 to 8:
        read the next byte into b0
        set code to (code * 256) + b0
    set bitcnt to 0
    set going to 1
    while going is 1:
        set l to mlen
        set cb to code
        bitwise xor cb with tb_min
        while cb is less than item (pr + 62 + (l - mlen)) of tb_pool:
            add 1 to l
        set x to cb - item (pr + 62 + (l - mlen)) of tb_pool
        set tmp to 64 - l
        shift x right by tmp bits
        set sym to item (pr + 14 + (l - mlen)) of tb_pool + x
        if lit is less than item (slen + sym) of tb_pool:
            set going to 0
        else:
            subtract item (slen + sym) of tb_pool from lit
            shift code left by l bits
            add l to bitcnt
            if bitcnt is at least 32:
                subtract 32 from bitcnt
                read the next byte into b0
                read the next byte into b1
                read the next byte into b2
                read the next byte into b3
                set x to (((((b0 * 256) + b1) * 256) + b2) * 256) + b3
                shift x left by bitcnt bits
                bitwise or code with x
    while item (slen + sym) of tb_pool is not 1:
        set w to item (spat + sym) of tb_pool
        set s1 to (((w / 256) mod 16) * 256) + (w mod 256)
        if lit is less than item (slen + s1) of tb_pool:
            set sym to s1
        else:
            subtract item (slen + s1) of tb_pool from lit
            set sym to ((w / 65536) * 16) + (((w / 256) mod 256) / 16)
    set w to item (spat + sym) of tb_pool
    give back (w mod 256) + (((w / 256) mod 256) * 256)

(Directories - tb_dirs holds the path text  - character codes, 0 at the end, several directories are)
(separated by a colon.  Call tb_set_dirs once the text is in tb_dirs.)
routine tb_set_dirs:
    Let a number be called i
    Let a number be called c
    set tb_dirn to 0
    set i to 0
    set c to item 0 of tb_dirs
    if c is not 0:
        set item 0 of tb_dstart to 0
        set tb_dirn to 1
    while c is not 0 and i is less than 510:
        if c is 58:
            if item (i + 1) of tb_dirs is not 0 and tb_dirn is less than 15:
                set item tb_dirn of tb_dstart to i + 1
                add 1 to tb_dirn
        add 1 to i
        set c to item i of tb_dirs
    (forget everything that was cached for an old path)
    for w from 0 to 63:
        set item ((w * 2) + 0) of tb_ctl to 0
        set item ((w * 2) + 1) of tb_ctl to 0
        for e from 0 to 63:
            set item (((w * 64) + e) * 64) of tb_meta to 0

(Position in tb_brd  - 64 squares, a1 = 0 - 0 empty, 1..6 white P N B R Q K, 9..14 black and tb_turn)
(0 white / 1 black to move.  Gives back the raw table value  - WDL - -2..2 for the side to move, DTZ)
(as stored or -1000 when the position has no table, or the DTZ table is for the other side.)
define tb_probe with ty and s:
    Let a number be called sq
    Let a number be called c
    Let a number be called k
    Let a number be called key
    Let a number be called key2
    Let a number be called wb
    Let a number be called mb
    Let a number be called e
    Let a number be called slot
    Let a number be called tries
    Let a number be called flip
    Let a number be called bside
    Let a number be called numt
    Let a number be called t
    Let a number be called eb
    Let a number be called i
    Let a number be called mir
    Let a number be called pc
    Let a number be called col
    Let a number be called code
    Let a number be called pr
    Let a number be called idx
    Let a number be called w
    Let a number be called v
    Let a number be called fl
    Let a number be called tmp
    Let a number be called di
    Let a number be called mp
    Let a number be called n0
    Let a number be called swp
    Let a number be called found
    if tb_wid is at least 64:
        give back -1000
    for c from 0 to 15:
        set item c of tb_cnt to 0
    for sq from 0 to 63:
        set c to item sq of tb_brd
        if c is not 0:
            set k to item c of tb_cnt
            if k is at least 7:
                give back -1000
            set item ((c * 8) + k) of tb_psq to sq
            set item c of tb_cnt to k + 1
    set key to 0
    for c from 1 to 6:
        set key to (key * 16) + item c of tb_cnt
    for c from 9 to 14:
        set key to (key * 16) + item c of tb_cnt
    set key2 to key * 2
    if ty is 2:
        add 1 to key2
    (cache bookkeeping - flush when the slice of this worker is nearly full)
    if item ((tb_wid * 2) + 0) of tb_ctl is greater than 150000 or item ((tb_wid * 2) + 1) of tb_ctl is at least 48:
        set item ((tb_wid * 2) + 0) of tb_ctl to 0
        set item ((tb_wid * 2) + 1) of tb_ctl to 0
        for e from 0 to 63:
            set item (((tb_wid * 64) + e) * 64) of tb_meta to 0
    set wb to tb_wid * 64
    set e to key2 mod 61
    set tries to 0
    set mb to -1
    while tries is less than 64 and mb is -1:
        set slot to ((wb + e) * 64)
        if item slot of tb_meta is key2 + 1:
            set mb to slot
        else if item slot of tb_meta is 0:
            set mb to 0 - slot - 2
        else:
            set e to (e + 1) mod 64
            add 1 to tries
    if mb is -1 or tries is 64:
        give back -1000
    if mb is less than -1:
        (not cached yet: load the header)
        set mb to 0 - mb - 2
        add 1 to item ((tb_wid * 2) + 1) of tb_ctl
        set found to tb_load(key2, ty, mb)
        if found is 0:
            close the file
            set item (mb + 1) of tb_meta to 0
            give back -1000
    else:
        if item (mb + 1) of tb_meta is 0:
            give back -1000
        set flip to item (mb + 11) of tb_meta
        call tb_name with flip and ty and (item (mb + 12) of tb_meta)
        open the file named by tb_fn for reading
        if input_ok is 0:
            give back -1000
    set tb_num to item (mb + 3) of tb_meta
    set tb_haspawns to item (mb + 4) of tb_meta
    set tb_kkenc to item (mb + 6) of tb_meta
    set tb_p0 to item (mb + 7) of tb_meta
    set tb_p1 to item (mb + 8) of tb_meta
    set numt to item (mb + 10) of tb_meta
    set eb to item (mb + 34) of tb_meta
    set flip to item (mb + 11) of tb_meta
    if item (mb + 5) of tb_meta is 1:
        set flip to tb_turn
        set bside to 0
    else:
        set bside to flip
        if tb_turn is 1:
            set bside to 1 - flip
    set mir to 0
    if tb_haspawns is 1 and flip is 1:
        set mir to 56
    set fl to 0
    set t to 0
    set i to 0
    if tb_haspawns is 0:
        if ty is 2:
            set fl to item (mb + 14) of tb_meta
            if (fl mod 2) is not bside and item (mb + 5) of tb_meta is 0:
                close the file
                give back -1001
        else:
            add 24 * bside to eb
        while i is less than tb_num:
            set pc to item (eb + i) of tb_pool
            set col to pc / 8
            if flip is 1:
                set col to 1 - col
            set code to (pc mod 8) + (8 * col)
            set k to item code of tb_cnt
            if k is 0:
                close the file
                give back -1000
            for j from 0 to k - 1:
                set item (i + j) of tb_p to item ((code * 8) + j) of tb_psq
            add k to i
        set idx to tb_encode(eb, 0)
    else:
        (the leading pawns come first, from the first piece order)
        while i is less than tb_p0:
            set pc to item (eb + i) of tb_pool
            set col to pc / 8
            if flip is 1:
                set col to 1 - col
            set code to (pc mod 8) + (8 * col)
            set k to item code of tb_cnt
            if k is 0:
                close the file
                give back -1000
            for j from 0 to k - 1:
                set tmp to item ((code * 8) + j) of tb_psq
                bitwise xor tmp with mir
                set item (i + j) of tb_p to tmp
            add k to i
        for k from 1 to tb_p0 - 1:
            if item (item 0 of tb_p) of tb_flap is greater than item (item k of tb_p) of tb_flap:
                set swp to item 0 of tb_p
                set item 0 of tb_p to item k of tb_p
                set item k of tb_p to swp
        set t to (item 0 of tb_p) mod 8
        if t is greater than 3:
            set t to 7 - t
        if ty is 2:
            set fl to item (mb + 14 + t) of tb_meta
            if (fl mod 2) is not bside and item (mb + 5) of tb_meta is 0:
                close the file
                give back -1001
            set eb to eb + (24 * t)
        else:
            set eb to eb + (24 * (t + (numt * bside)))
        while i is less than tb_num:
            set pc to item (eb + i) of tb_pool
            set col to pc / 8
            if flip is 1:
                set col to 1 - col
            set code to (pc mod 8) + (8 * col)
            set k to item code of tb_cnt
            if k is 0:
                close the file
                give back -1000
            for j from 0 to k - 1:
                set tmp to item ((code * 8) + j) of tb_psq
                bitwise xor tmp with mir
                set item (i + j) of tb_p to tmp
            add k to i
        set idx to tb_encode(eb, 1)
    set pr to item (eb + 21) of tb_pool
    set w to tb_decode(pr, idx)
    if ty is 0:
        close the file
        give back (w mod 256) - 2
    set v to (w mod 256) + (((w / 256) mod 16) * 256)
    if (fl / 2) mod 2 is 1:
        set mp to item (mb + 13) of tb_meta
        set n0 to item (s + 2) of tb_wdl2map
        if (fl / 16) mod 2 is 0:
            set v to tb_at8(mp + item (mb + 18 + (4 * t) + n0) of tb_meta + v)
        else:
            set v to tb_at16(mp + (2 * (item (mb + 18 + (4 * t) + n0) of tb_meta + v)))
    set tmp to 0
    if item (s + 2) of tb_paflags is 8:
        set tmp to (fl / 8) mod 2
    if item (s + 2) of tb_paflags is 4:
        set tmp to (fl / 4) mod 2
    if tmp is 0 or (s mod 2) is not 0:
        set v to v * 2
    close the file
    give back v

(=============================================================================)
(   TABLEBASE LAYER FOR THE ENGINE: capture resolution, DTZ and root moves      )
(   Uses the board of the engine and its own move stacks (plies 24 to 63).      )
(=============================================================================)
Create an array named tb_rootok with 12800 slots
Create an array named tb_w2d with 5 slots
Create a shared array named tb_ca with 1048576 slots
Create a shared array named tb_cb with 1048576 slots
Let a number be called tb_fail
Let a number be called tb_succ
Let a number be called tb_root_on
Let a number be called tb_pdepth
Let a number be called tb_hit_n

routine tb_init_game:
    set item 0 of tb_w2d to -1
    set item 1 of tb_w2d to -101
    set item 2 of tb_w2d to 0
    set item 3 of tb_w2d to 101
    set item 4 of tb_w2d to 1
    set tb_maxmen to 7
    set tb_pdepth to 1
    set tb_on to 0

(Copy the engine board into tb_brd; gives back the number of pieces, or 99 when there are too many)
define tb_fill with side:
    Let a number be called n
    Let a number be called sq
    Let a number be called pc
    Let a number be called kind
    set n to 0
    for r from 0 to 7:
        for f from 0 to 7:
            set pc to item square(r, f) of board
            set sq to (r * 8) + f
            if pc is 0:
                set item sq of tb_brd to 0
            else:
                add 1 to n
                calculate the absolute value of pc and store the result in kind
                if pc is greater than 0:
                    set item sq of tb_brd to kind
                else:
                    set item sq of tb_brd to kind + 8
    if side is 1:
        set tb_turn to 0
    else:
        set tb_turn to 1
    give back n

(1 when the position can be looked up: few enough men and no castling rights)
define tb_usable with side:
    Let a number be called n
    Let a number be called occ
    if tb_on is 0:
        give back 0
    if item 0 of castle is not 0 or item 1 of castle is not 0 or item 2 of castle is not 0 or item 3 of castle is not 0:
        give back 0
    set occ to item 2 of bbo
    count the set bits of occ and store the result in n
    if n is greater than tb_maxmen:
        give back 0
    give back 1

(The raw table value of the position on the board for side, as WDL)
define tb_tab with side:
    Let a number be called n
    Let a number be called v
    set n to tb_fill(side)
    if n is 2:
        give back 0
    set v to tb_probe(0, 0)
    if v is -1000:
        set tb_fail to 1
        give back 0
    give back v

(Is this move a capture, an en passant capture included)
define tb_is_cap with src and dst:
    if item dst of board is not 0:
        give back 1
    if dst is ep_sq and ep_sq is not 0:
        if item src of board is 1 or item src of board is -1:
            give back 1
    give back 0

(probe_ab of Fathom: alpha beta over captures only, then the table)
define tb_ab with lv and alpha and beta and side:
    Let a number be called ply
    Let a number be called n
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called v
    set ply to 24 + lv
    set qmode to 1
    call generate with ply and side
    set qmode to 0
    set n to item ply of mv_count
    for i from 0 to n - 1:
        set slot to ((ply - 1) * 256) + i
        set src to item slot of mv_from
        set dst to item slot of mv_to
        if tb_is_cap(src, dst) is 1:
            call apply_move with ply and src and dst
            set v to 0 - tb_ab(lv + 1, 0 - beta, 0 - alpha, 0 - side)
            call undo_move with ply and src and dst
            if tb_fail is 1:
                give back 0
            if v is greater than alpha:
                if v is at least beta:
                    give back v
                set alpha to v
    set v to tb_tab(side)
    if tb_fail is 1:
        give back 0
    if alpha is at least v:
        give back alpha
    give back v

(probe_wdl of Fathom with capture resolution: -2 loss, -1 cursed loss, 0 draw, 1 cursed win, 2 win)
(tb_succ is 2 when a capture is the best move.  The rare en passant stalemate case is not handled.)
define tb_wdl with side:
    Let a number be called ply
    Let a number be called n
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called v
    Let a number be called best_cap
    Let a number be called best_ep
    Let a number be called isep
    set tb_fail to 0
    set tb_succ to 1
    set ply to 24
    set qmode to 1
    call generate with ply and side
    set qmode to 0
    set n to item ply of mv_count
    set best_cap to -3
    set best_ep to -3
    for i from 0 to n - 1:
        set slot to ((ply - 1) * 256) + i
        set src to item slot of mv_from
        set dst to item slot of mv_to
        if tb_is_cap(src, dst) is 1:
            set isep to 0
            if item dst of board is 0:
                set isep to 1
            call apply_move with ply and src and dst
            set v to 0 - tb_ab(1, -2, 0 - best_cap, 0 - side)
            call undo_move with ply and src and dst
            if tb_fail is 1:
                give back 0
            if v is greater than best_cap:
                if v is 2:
                    set tb_succ to 2
                    give back 2
                if isep is 0:
                    set best_cap to v
                else if v is greater than best_ep:
                    set best_ep to v
    set v to tb_tab(side)
    if tb_fail is 1:
        give back 0
    if best_ep is greater than best_cap:
        if best_ep is greater than v:
            set tb_succ to 2
            give back best_ep
        set best_cap to best_ep
    if best_cap is at least v:
        set tb_succ to 1
        if best_cap is greater than 0:
            set tb_succ to 2
        give back best_cap
    give back v

(The WDL value through a small shared cache keyed by the position)
define tb_wdl_cached with side:
    Let a number be called key
    Let a number be called slot
    Let a number be called ent
    Let a number be called v
    set key to position_key(side)
    set slot to key mod 1048576
    set ent to item slot of tb_ca
    if ent is not 0 and (item slot of tb_cb) + ent is key:
        give back ent - 3
    set v to tb_wdl(side)
    if tb_fail is 1:
        give back 0
    set item slot of tb_ca to v + 3
    set item slot of tb_cb to key - (v + 3)
    give back v

(1 when side to move has no legal move and is in check)
define tb_is_mate with side:
    set qmode to 0
    call generate with 60 and side
    if item 60 of mv_count is 0 and in_check(side) is 1:
        give back 1
    give back 0

(probe_dtz of Fathom: distance to a zeroing move, signed for the side to move.  tb_fail on failure.)
define tb_dtz with lv and side:
    Let a number be called ply
    Let a number be called n
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called v
    Let a number be called wdl
    Let a number be called raw
    Let a number be called best
    Let a number be called kind
    Let a number be called np
    set wdl to tb_wdl(side)
    if tb_fail is 1:
        give back 0
    if wdl is 0:
        give back 0
    if tb_succ is 2:
        give back item (wdl + 2) of tb_w2d
    if lv is at least 7:
        set tb_fail to 1
        give back 0
    set ply to 40 + lv
    set qmode to 0
    call generate with ply and side
    set n to item ply of mv_count
    if wdl is greater than 0:
        for i from 0 to n - 1:
            set slot to ((ply - 1) * 256) + i
            set src to item slot of mv_from
            set dst to item slot of mv_to
            calculate the absolute value of item src of board and store the result in kind
            if kind is 1 and tb_is_cap(src, dst) is 0:
                call apply_move with ply and src and dst
                set v to 0 - tb_wdl(0 - side)
                call undo_move with ply and src and dst
                if tb_fail is 1:
                    give back 0
                if v is wdl:
                    give back item (wdl + 2) of tb_w2d
    set tb_fail to 0
    set np to tb_fill(side)
    set raw to tb_probe(2, wdl)
    if raw is greater than -1000:
        if wdl is greater than 0:
            give back item (wdl + 2) of tb_w2d + raw
        give back item (wdl + 2) of tb_w2d - raw
    if raw is -1000:
        set tb_fail to 1
        give back 0
    (the table holds the other side to move: look one move ahead)
    if wdl is greater than 0:
        set best to 1000000
    else:
        set best to item (wdl + 2) of tb_w2d
    for i from 0 to n - 1:
        set slot to ((ply - 1) * 256) + i
        set src to item slot of mv_from
        set dst to item slot of mv_to
        calculate the absolute value of item src of board and store the result in kind
        if kind is not 1 and tb_is_cap(src, dst) is 0:
            call apply_move with ply and src and dst
            set v to 0 - tb_dtz(lv + 1, 0 - side)
            if tb_fail is 0:
                if v is 1 and tb_is_mate(0 - side) is 1:
                    set best to 1
                else if wdl is greater than 0:
                    if v is greater than 0 and v + 1 is less than best:
                        set best to v + 1
                else:
                    if v - 1 is less than best:
                        set best to v - 1
            call undo_move with ply and src and dst
            if tb_fail is 1:
                give back 0
    give back best

Create an array named tb_rank with 256 slots
Create an array named tb_mid with 256 slots

(Rank the root moves with the tables.  Wins are ranked by how soon the 50 move counter is reset,)
(losses by how late, draws are equal.  Only the best ranked moves stay allowed in the search.)
define tb_root_filter with side:
    Let a number be called ply
    Let a number be called n
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called w
    Let a number be called v
    Let a number be called d
    Let a number be called r
    Let a number be called best
    Let a number be called zero
    Let a number be called kind
    Let a number be called kept
    Let a number be called dtzok
    set tb_root_on to 0
    if tb_usable(side) is 0:
        give back 0
    set ply to 56
    set qmode to 0
    call generate with ply and side
    set n to item ply of mv_count
    if n is 0:
        give back 0
    set best to -100000
    for i from 0 to n - 1:
        set slot to ((ply - 1) * 256) + i
        set src to item slot of mv_from
        set dst to item slot of mv_to
        set item i of tb_mid to (src * 128) + dst
        calculate the absolute value of item src of board and store the result in kind
        set zero to tb_is_cap(src, dst)
        if kind is 1:
            set zero to 1
        call apply_move with ply and src and dst
        set tb_fail to 0
        set w to 0 - tb_wdl(0 - side)
        if tb_fail is 1:
            call undo_move with ply and src and dst
            give back 0
        set dtzok to 1
        set v to 0
        if w is not 0:
            if zero is 1:
                set v to item (w + 2) of tb_w2d
            else:
                set tb_fail to 0
                set d to tb_dtz(0, 0 - side)
                if tb_fail is 1:
                    set dtzok to 0
                else:
                    set v to 0 - d
                    if v is greater than 0:
                        add 1 to v
                    else if v is less than 0:
                        subtract 1 from v
            if v is 2 and tb_is_mate(0 - side) is 1:
                set v to 1
        call undo_move with ply and src and dst
        set tb_fail to 0
        if dtzok is 0:
            set r to w * 400
        else if v is greater than 0:
            set r to 0
            if v is at most 100:
                set r to 1000 - v
        else if v is less than 0:
            set r to 0
            if v is at least -100:
                set r to -1000 - v
        else:
            set r to 0
        set item i of tb_rank to r
        if r is greater than best:
            set best to r
    for i from 0 to 12799:
        set item i of tb_rootok to 0
    set kept to 0
    for i from 0 to n - 1:
        if item i of tb_rank is best:
            set item (item i of tb_mid) of tb_rootok to 1
            add 1 to kept
    set tb_root_on to 1
    if uci_mode is 1:
        print "info string tablebase root: ", kept, " of ", n, " moves kept, rank ", best
    give back kept

(Console and debug: print the table answers for the position on the board)
routine tb_report:
    Let a number be called wdl
    Let a number be called dz
    set tb_fail to 0
    if tb_usable(uside) is 0:
        print "info string tbprobe: position not usable (men, castling or no path)"
    else:
        set wdl to tb_wdl(uside)
        if tb_fail is 1:
            print "info string tbprobe: no table"
        else:
            set tb_fail to 0
            set dz to tb_dtz(0, uside)
            if tb_fail is 1:
                print "info string tbprobe wdl ", wdl, " dtz none"
            else:
                print "info string tbprobe wdl ", wdl, " dtz ", dz

routine tb_read_path:
    Let a number be called c
    Let a number be called n
    read the next byte into c
    while input_ok is 1 and (c is 32 or c is 9):
        read the next byte into c
    set n to 0
    while input_ok is 1 and c is not 10 and c is not 13 and n is less than 510:
        set item n of tb_dirs to c
        add 1 to n
        read the next byte into c
    while input_ok is 1 and c is not 10:
        read the next byte into c
    set item n of tb_dirs to 0
    set tok_end to 1
    set tb_on to 1
    if n is 0:
        set tb_on to 0
    if n is 7 and item 0 of tb_dirs is 60:
        set tb_on to 0
        set item 0 of tb_dirs to 0
    run tb_set_dirs

(The bytes of the weight file are big endian, whole numbers with a sign.)
define nn_s16:
    Let a number be called b0
    Let a number be called b1
    Let a number be called v
    read the next byte into b0
    read the next byte into b1
    set v to (b0 * 256) + b1
    if v is at least 32768:
        set v to v - 65536
    give back v

define nn_s8:
    Let a number be called b0
    read the next byte into b0
    if b0 is at least 128:
        set b0 to b0 - 256
    give back b0

define nn_s32:
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called b3
    Let a number be called v
    read the next byte into b0
    read the next byte into b1
    read the next byte into b2
    read the next byte into b3
    set v to (((((b0 * 256) + b1) * 256) + b2) * 256) + b3
    if v is at least 2147483648:
        set v to v - 4294967296
    give back v

(Version 2 file, after the magic APX2: H, L1, L2, K, buckets - then the feature transformer, then per bucket layer 1, layer 2, output weights, skip weights and output bias.)
define nn_load2:
    Let a number be called h
    Let a number be called l1
    Let a number be called l2
    Let a number be called nb
    set h to nn_s16()
    set l1 to nn_s16()
    set l2 to nn_s16()
    set nn_k to nn_s16()
    set nb to nn_s16()
    if h is less than 2 or h is greater than 64 or (h mod 2) is not 0 or l1 is less than 1 or l1 is greater than 16 or l2 is less than 1 or l2 is greater than 16 or nb is less than 1 or nb is greater than 8:
        close the file
        give back 0
    set nn_h to h
    set nn_l1 to l1
    set nn_l2 to l2
    set nn_nb to nb
    set nn_v2 to 1
    set nn_zr to 22528
    for i from 0 to h - 1:
        set item i of nn_fb to nn_s16()
    for i from 0 to (22528 * h) - 1:
        set item i of nn_fw to nn_s16()
    for i from 22528 * h to (22529 * h) - 1:
        set item i of nn_fw to 0
    for b from 0 to nb - 1:
        for o from 0 to l1 - 1:
            for i from 0 to h - 1:
                set item ((b * h * l1) + (i * l1) + o) of nn_l1w to nn_s16()
        for o from 0 to l1 - 1:
            set item ((b * l1) + o) of nn_l1b to nn_s32()
        for o from 0 to l2 - 1:
            for i from 0 to (2 * l1) - 1:
                set item ((b * 2 * l1 * l2) + (i * l2) + o) of nn_l2w to nn_s16()
        for o from 0 to l2 - 1:
            set item ((b * l2) + o) of nn_l2b to nn_s32()
        for o from 0 to l2 - 1:
            set item ((b * l2) + o) of nn_ow to nn_s16()
        for o from 0 to l1 - 1:
            set item ((b * l1) + o) of nn_sw to nn_s16()
        set item b of nn_obv to nn_s32()
    close the file
    set nn_ready to 1
    give back 1

(Reads the network named in tb_fn - 0 ends the name.  Gives back 1 when a net is loaded.)
define nn_load:
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called b3
    Let a number be called h
    Let a number be called l1
    Let a number be called l2
    set nn_ready to 0
    open the file named by tb_fn for reading
    if input_ok is 0:
        give back 0
    read the next byte into b0
    read the next byte into b1
    read the next byte into b2
    read the next byte into b3
    if b0 is not 65 or b1 is not 80 or b2 is not 88 or (b3 is not 78 and b3 is not 50):
        close the file
        give back 0
    if b3 is 50:
        give back nn_load2()
    set nn_v2 to 0
    set nn_zr to 45056
    set h to (nn_s16() * 1)
    set l1 to nn_s16()
    set l2 to nn_s16()
    set nn_k to nn_s16()
    if h is less than 1 or h is greater than 64 or l1 is less than 1 or l1 is greater than 16 or l2 is less than 1 or l2 is greater than 16:
        close the file
        give back 0
    set nn_h to h
    set nn_l1 to l1
    set nn_l2 to l2
    for i from 0 to h - 1:
        set item i of nn_fb to nn_s16()
    for i from 0 to (45056 * h) - 1:
        set item i of nn_fw to nn_s16()
    for i from 45056 * h to (45057 * h) - 1:
        set item i of nn_fw to 0
    for o from 0 to l1 - 1:
        for i from 0 to (2 * h) - 1:
            set item ((i * l1) + o) of nn_l1w to nn_s16()
    for o from 0 to l1 - 1:
        set item o of nn_l1b to nn_s32()
    for o from 0 to l2 - 1:
        for i from 0 to l1 - 1:
            set item ((i * l2) + o) of nn_l2w to nn_s16()
    for o from 0 to l2 - 1:
        set item o of nn_l2b to nn_s32()
    for o from 0 to l2 - 1:
        set item o of nn_ow to nn_s16()
    set nn_ob to nn_s32()
    close the file
    set nn_ready to 1
    give back 1

(Puts the name apexz.nnue into tb_fn.)
routine nn_default_name:
    set tb_fl to 0
    call tb_put with 97
    call tb_put with 112
    call tb_put with 101
    call tb_put with 120
    call tb_put with 122
    call tb_put with 46
    call tb_put with 110
    call tb_put with 110
    call tb_put with 117
    call tb_put with 101
    call tb_put with 0

(UCI: the rest of the line is a file name.)
routine nn_read_path:
    Let a number be called c
    Let a number be called n
    read the next byte into c
    while input_ok is 1 and (c is 32 or c is 9):
        read the next byte into c
    set n to 0
    while input_ok is 1 and c is not 10 and c is not 13 and n is less than 590:
        set item n of tb_fn to c
        add 1 to n
        read the next byte into c
    while input_ok is 1 and c is not 10:
        read the next byte into c
    set item n of tb_fn to 0
    set tok_end to 1
    if nn_load() is 1:
        set nn_on to 1
        if nn_v2 is 1:
            print "info string NNUE v2 loaded: ", nn_h, " x2 -> ", nn_l1, " -> ", nn_l2, " -> 1, ", nn_nb, " buckets"
        else:
            print "info string NNUE loaded: ", nn_h, " x2 -> ", nn_l1, " -> ", nn_l2, " -> 1"
    else:
        set nn_on to 0
        print "info string NNUE file not loaded"

define search with ply and depth and alpha and beta and side and nullok:
    Let a number be called checked
    Let a number be called improving
    Let a number be called rfp_d
    Let a number be called rfp_m
    Let a number be called nr
    Let a number be called lmp_n
    Let a number be called alpha0
    Let a number be called beta0
    Let a number be called key
    Let a number be called slot_t
    Let a number be called tt_best
    Let a number be called bound
    Let a number be called tscore
    Let a number be called stand
    Let a number be called count
    Let a number be called base
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called moving
    Let a number be called took
    Let a number be called kind
    Let a number be called quiet
    Let a number be called played
    Let a number be called cut
    Let a number be called score
    Let a number be called best
    Let a number be called best_move
    Let a number be called saved_ep
    Let a number be called hslot
    Let a number be called gain
    Let a number be called ent
    Let a number be called now
    Let a number be called tt_d
    Let a number be called tt_bound
    Let a number be called tt_sc
    Let a number be called sbeta
    Let a number be called sext
    Let a number be called mv_id
    Let a number be called tt_ok
    Let a number be called stage
    Let a number be called mi
    Let a number be called seen
    Let a number be called verified
    Let a number be called stg
    Let a number be called ksub
    Let a number be called got
    Let a number be called ntried
    Let a number be called cand
    Let a number be called illegal
    Let a number be called nh
    Let a number be called nq
    Let a number be called nc
    Let a number be called ctxm
    Let a number be called hv
    Let a number be called ctx_at_c1
    Let a number be called cur
    Let a number be called e0
    Let a number be called e1
    Let a number be called d0
    Let a number be called a0
    Let a number be called m0
    Let a number be called m1
    Let a number be called tbw
    Let a number be called rbeta
    Let a number be called pc_n
    Let a number be called pc_i
    Let a number be called pc_base
    Let a number be called pc_mv
    Let a number be called sv
    add 1 to nodes
    if aborted is 1:
        give back 0
    if tm_abort_t is greater than 0 and is_helper is 0 and (nodes mod 2048) is 0:
        read the clock into now
        if now is at least tm_abort_t:
            if floor of (((now - depth_start_t) * 100) / pred_ms) is less than 70 or now is at least tm_cap_t:
                set aborted to 1
                give back 0
    if deadline is greater than 0 and (nodes mod 2048) is 0:
        read the clock into now
        if now is at least deadline:
            set aborted to 1
            give back 0
    if hard_nodes is greater than 0 and nodes is at least hard_nodes:
        set aborted to 1
        give back 0
    if is_helper is 1 and (nodes mod 256) is 0:
        if item 0 of ctl is 1:
            set aborted to 1
            give back 0
    if ply is at least max_ply:
        set nn_stm to side
        give back side * evaluate()
    set checked to in_check(side)
    if checked is 1:
        add 1 to depth
    if depth is at most 0:
        give back quiesce(ply, alpha, beta, side)
    (mate distance pruning: no line can beat a mate that is already closer)
    if feature(2) is 1 and ply is greater than 1:
        if alpha is less than ply - 80000:
            set alpha to ply - 80000
        if beta is greater than 79999 - ply:
            set beta to 79999 - ply
        if alpha is at least beta:
            give back alpha
    set alpha0 to alpha
    set beta0 to beta
    set nh to feature(8192)
    set ctx_at_c1 to item ply of ctx_at
    set nq to 0
    set nc to 0

    (--- repeating a position is a draw ---)
    set key to position_key(side)
    set item ply of path_key to key
    if feature(8) is 1 and ply is greater than 1:
        for j from ply - 2 to 1 by -2:
            if item j of path_key is key:
                give back 0
        for k from 1 to 8:
            set slot to game_n - k
            if slot is at least 0:
                if item slot of game_keys is key:
                    give back 0

    (--- tablebases: an exact result for positions with few men ---)
    if tb_on is 1 and ply is greater than 1 and depth is at least tb_pdepth and item ply of excl is 0:
        if tb_usable(side) is 1:
            set tb_fail to 0
            set tbw to tb_wdl_cached(side)
            if tb_fail is 0:
                if tbw is 2:
                    give back 30000 - ply
                if tbw is -2:
                    give back ply - 30000
                give back 0

    (--- transposition table ---)
    set tt_best to 0
    set tt_d to 0
    set tt_bound to 3
    set tt_sc to 0
    if depth is at least 2 and use(1) is 1:
        set slot_t to (key mod tt_buckets) * 2
        set ent to item slot_t of tt_a
        set tt_ok to 0
        if ent is not 0 and (item slot_t of tt_b) + ent is key:
            set tt_ok to 1
        else:
            add 1 to slot_t
            set ent to item slot_t of tt_a
            if ent is not 0 and (item slot_t of tt_b) + ent is key:
                set tt_ok to 1
        if tt_ok is 1:
            set tt_best to ent mod 16384
            set ent to floor of (ent / 16384)
            set tt_d to ent mod 64
            set ent to floor of (ent / 64)
            set tt_bound to ent mod 4
            set ent to floor of (ent / 4)
            set tt_sc to floor of (ent / 256) - 100000
            if ply is greater than 1 and tt_d is at least depth and item ply of excl is 0:
                if tt_bound is 0:
                    give back tt_sc
                if tt_bound is 1 and tt_sc is greater than alpha:
                    set alpha to tt_sc
                if tt_bound is 2 and tt_sc is less than beta:
                    set beta to tt_sc
                if alpha is at least beta:
                    give back tt_sc

    (internal iterative reduction: with no remembered best move this node is)
    (probably unimportant, so search it a ply shallower)
    if feature(4) is 1 and tt_best is 0 and depth is at least 5:
        subtract 1 from depth

    (--- pruning before looking at any move ---)
    set stand to 0
    set improving to 0
    set item ply of ev_stack to -1000000
    if checked is 0 and ply is greater than 1 and pruning is not 0:
        set nn_stm to side
        set stand to side * evaluate()
        set item ply of ev_stack to stand
        set rfp_d to 3
        set rfp_m to 120
        if feature(2097152) is 1:
            (modern search: is the static evaluation better than two plies ago, for the same side?)
            set rfp_d to 8
            set rfp_m to 85
            if ply is at least 3:
                if item (ply - 2) of ev_stack is greater than -900000 and stand is greater than item (ply - 2) of ev_stack:
                    set improving to 1
        if use(2) is 1 and depth is at most rfp_d and beta is less than 70000 and beta is greater than -70000:
            set gain to stand - (rfp_m * depth)
            if feature(2097152) is 1 and improving is 1:
                add 40 to gain
            if gain is at least beta:
                give back gain
        if use(4) is 1 and depth is at most 2 and stand + (300 * depth) is less than alpha:
            set score to quiesce(ply, alpha - 1, alpha, side)
            if score is less than alpha:
                give back score
        if use(8) is 1 and nullok is 1 and depth is at least 3 and stand is at least beta:
            if has_pieces(side) is 1:
                set saved_ep to ep_sq
                set ep_sq to 0
                set item (ply + 1) of prev_move to 0
                set item (ply + 1) of ctx_at to 0
                if nn_on is 1:
                    call nn_copy with ply
                set nr to 2
                if feature(2097152) is 1:
                    set nr to 2 + floor of (depth / 4) + floor of ((stand - beta) / 180)
                    if nr is greater than 2 + floor of (depth / 4) + 3:
                        set nr to 2 + floor of (depth / 4) + 3
                set score to 0 - search(ply + 1, depth - 1 - nr, 0 - beta, 1 - beta, 0 - side, 0)
                set nn_cur to ply
                set ep_sq to saved_ep
                if score is at least beta:
                    if score is at least 70000:
                        set score to beta
                    give back score

    (singular extension: if the remembered best move is the only good one, that is,)
    (every other move fails well below its score in a shallower search, extend it)
    set sext to 0
    if feature(256) is 1 and ply is greater than 1 and depth is at least 8 and tt_best is not 0 and item ply of excl is 0:
        if tt_bound is less than 2 and tt_d is at least depth - 3 and tt_sc is greater than -70000 and tt_sc is less than 70000:
            set sbeta to tt_sc - (2 * depth)
            set item ply of excl to tt_best
            set score to search(ply, floor of ((depth - 1) / 2), sbeta - 1, sbeta, side, 0)
            set item ply of excl to 0
            if aborted is 1:
                give back 0
            if score is less than sbeta:
                set sext to 1
                if feature(32768) is 1 and score is less than sbeta - 20 and beta - alpha is 1:
                    set sext to 2
            else if sbeta is at least beta:
                give back sbeta
            else if feature(32768) is 1 and tt_sc is at least beta:
                set sext to -1

    (ProbCut: a good capture that still beats beta by a margin in a shallower search will beat it here)
    if feature(8388608) is 1 and beta - alpha is 1 and depth is at least 5 and ply is greater than 1 and checked is 0 and pruning is not 0 and item ply of excl is 0:
        if beta is less than 70000 and beta is greater than -70000:
            set rbeta to beta + 150
            set qmode to 1
            call generate with ply and side
            set qmode to 0
            set pc_n to item ply of mv_count
            call score_moves with ply and side and 0
            set pc_base to (ply - 1) * 256
            for pc_i from 0 to pc_n - 1:
                call pick_best with ply and pc_i and pc_n
                set slot to pc_base + pc_i
                if item slot of mv_score is less than 10000:
                    stop
                set src to item slot of mv_from
                set dst to item slot of mv_to
                if see(src, dst) is less than rbeta - stand:
                    skip
                set moving to item src of board
                set ctxm to ((moving + 6) * 64) + (item dst of m2b) + 1
                call apply_move with ply and src and dst
                if in_check(side) is 1:
                    call undo_move with ply and src and dst
                    skip
                set item (ply + 1) of prev_move to (src * 128) + dst
                set item (ply + 1) of ctx_at to ctxm
                set score to 0 - quiesce(ply + 1, 0 - rbeta, 1 - rbeta, 0 - side)
                if score is at least rbeta:
                    set score to 0 - search(ply + 1, depth - 4, 0 - rbeta, 1 - rbeta, 0 - side, 1)
                call undo_move with ply and src and dst
                if aborted is 1:
                    give back 0
                if score is at least rbeta:
                    give back score

    (--- generate, order, search: in stages when feature 16384 is on ---)
    set base to (ply - 1) * 256
    set best to -999999
    set best_move to 0
    set played to 0
    set stage to 0
    set mi to 0
    set count to 0
    set ntried to 0
    set seen to 0
    set ksub to 0
    set stg to feature(16384)
    while 1 is 1:
        set got to 0
        set verified to 1
        while got is 0:
            if stage is 0:
                set stage to 1
                if stg is 0:
                    set stage to 4
                else if tt_best is not 0:
                    set src to floor of (tt_best / 128)
                    set dst to tt_best mod 128
                    if move_ok(src, dst, side) is 1:
                        set got to 1
                        set verified to 0
                        set item ((ply * 80) + ntried) of tried to tt_best
                        add 1 to ntried
            else if stage is 1:
                set qmode to 1
                call generate with ply and side
                set qmode to 0
                set count to item ply of mv_count
                call score_moves with ply and side and 0
                set mi to 0
                set stage to 2
            else if stage is 2:
                if mi is less than count:
                    call pick_best with ply and mi and count
                    set slot to base + mi
                    add 1 to mi
                    if item slot of mv_score is less than 10000:
                        set stage to 3
                    else:
                        set src to item slot of mv_from
                        set dst to item slot of mv_to
                        if is_tried(ply, (src * 128) + dst, ntried) is 0:
                            set got to 1
                            if ntried is less than 70:
                                set item ((ply * 80) + ntried) of tried to (src * 128) + dst
                                add 1 to ntried
                else:
                    set stage to 3
            else if stage is 3:
                if ksub is 0:
                    set cand to item ply of killer1
                else if ksub is 1:
                    set cand to item ply of killer2
                else if ksub is 2:
                    set cand to 0
                    if feature(16) is 1 and item ply of prev_move is not 0:
                        set cand to item (item ply of prev_move) of counter
                else:
                    set stage to 4
                    set cand to 0
                if stage is 3:
                    add 1 to ksub
                    if cand is not 0 and is_tried(ply, cand, ntried) is 0:
                        set src to floor of (cand / 128)
                        set dst to cand mod 128
                        if item dst of board is 0 and dst is not ep_sq and move_ok(src, dst, side) is 1:
                            set got to 1
                            set verified to 0
                            set item ((ply * 80) + ntried) of tried to cand
                            add 1 to ntried
            else if stage is 4:
                call generate with ply and side
                set count to item ply of mv_count
                call score_moves with ply and side and tt_best
                if ntried is greater than 0:
                    for j from 0 to count - 1:
                        set slot to base + j
                        if is_tried(ply, ((item slot of mv_from) * 128) + (item slot of mv_to), ntried) is 1:
                            set item slot of mv_score to -2000000
                set mi to 0
                set stage to 5
            else:
                if mi is less than count:
                    call pick_best with ply and mi and count
                    set slot to base + mi
                    add 1 to mi
                    if item slot of mv_score is -2000000:
                        set stage to 6
                    else:
                        set src to item slot of mv_from
                        set dst to item slot of mv_to
                        set got to 1
                else:
                    set stage to 6
            if stage is 6:
                set got to -1
        if got is -1:
            stop
        set moving to item src of board
        set took to item dst of board
        set mv_id to (src * 128) + dst
        if tb_root_on is 1 and ply is 1:
            if item mv_id of tb_rootok is 0:
                skip
        if mv_id is item ply of excl:
            set illegal to 0
            if verified is 0:
                call apply_move with ply and src and dst
                set illegal to in_check(side)
                call undo_move with ply and src and dst
            if illegal is 0:
                add 1 to seen
            skip
        calculate the absolute value of moving and store the result in kind
        set quiet to 1
        if took is not 0:
            set quiet to 0
        if kind is 1 and (dst is ep_sq or dst is at least 91 or dst is at most 28):
            set quiet to 0

        if quiet is 1 and checked is 0 and played is greater than 0 and ply is greater than 1 and pruning is not 0:
            if use(16) is 1 and depth is at most 2 and stand + (150 * depth) is at most alpha:
                skip
            set lmp_n to 4 + (depth * depth)
            if feature(2097152) is 1 and improving is 0:
                set lmp_n to floor of (lmp_n / 2) + 1
            if use(32) is 1 and depth is at most 3 and played is at least lmp_n:
                skip

        if feature(4194304) is 1 and checked is 0 and played is greater than 0 and ply is greater than 1 and pruning is not 0 and best is greater than -70000:
            if quiet is 0 and took is not 0 and depth is at most 6:
                if see(src, dst) is less than 0 - (120 * depth):
                    skip
            if quiet is 1 and depth is at most 5:
                if see(src, dst) is less than 0 - (20 * depth * depth):
                    skip
        set sv to 0
        if feature(16777216) is 1 and quiet is 0 and took is not 0 and depth is at least 3 and played is at least 4 and checked is 0:
            set sv to see(src, dst)
        set ctxm to ((moving + 6) * 64) + (item dst of m2b) + 1
        call apply_move with ply and src and dst
        if verified is 0:
            if in_check(side) is 1:
                call undo_move with ply and src and dst
                skip
        add 1 to seen
        set item (ply + 1) of prev_move to (src * 128) + dst
        set item (ply + 1) of ctx_at to ctxm
        if played is 0:
            set score to 0 - search(ply + 1, depth - 1 + (sext * (1 - played)), 0 - beta, 0 - alpha, 0 - side, 1)
        else:
            set cut to 0
            if use(64) is 1 and depth is at least 3 and played is at least 3 and quiet is 1 and checked is 0:
                set cut to 1
                if played is at least 8:
                    set cut to 2
                if feature(128) is 1:
                    set cut to item ((depth * 64) + played) of lmr
                    if depth is at least 32 or played is at least 64:
                        set cut to 2
                    if cut is greater than depth - 2:
                        set cut to depth - 2
                    if cut is less than 1:
                        set cut to 1
                if nh is 1:
                    set hslot to (src * 120) + dst
                    set hv to item hslot of history
                    if ctx_at_c1 is not 0:
                        add item ((ctx_at_c1 * 833) + ctxm) of ch1 to hv
                    if ply is at least 2 and item (ply - 1) of ctx_at is not 0:
                        add item (((item (ply - 1) of ctx_at) * 833) + ctxm) of ch2 to hv
                    if hv is greater than 4000:
                        subtract 1 from cut
                    else if hv is less than -2500 and depth is at least 4:
                        add 1 to cut
                    if cut is less than 0:
                        set cut to 0
                if feature(2097152) is 1:
                    if beta - alpha is greater than 1:
                        subtract 1 from cut
                    if improving is 0:
                        add 1 to cut
                    if cut is greater than depth - 2:
                        set cut to depth - 2
                    if cut is less than 0:
                        set cut to 0
                if feature(32) is 1:
                    set hslot to (src * 120) + dst
                    if item hslot of history is greater than 2500:
                        subtract 1 from cut
                    else if item hslot of history is 0 and played is at least 6 and depth is at least 4:
                        add 1 to cut
            if sv is less than 0:
                set cut to 1
                if depth is at least 6 and played is at least 8:
                    set cut to 2
            set score to 0 - search(ply + 1, depth - 1 - cut, 0 - alpha - 1, 0 - alpha, 0 - side, 1)
            if score is greater than alpha and cut is greater than 0:
                set score to 0 - search(ply + 1, depth - 1, 0 - alpha - 1, 0 - alpha, 0 - side, 1)
            if score is greater than alpha and score is less than beta:
                set score to 0 - search(ply + 1, depth - 1, 0 - beta, 0 - alpha, 0 - side, 1)
        call undo_move with ply and src and dst
        if aborted is 1:
            stop
        add 1 to played

        if score is greater than best:
            set best to score
            set best_move to (src * 128) + dst
            if ply is 1:
                set best_from to src
                set best_to to dst
        if score is greater than alpha:
            set alpha to score
        if alpha is at least beta:
            if quiet is 1:
                set hslot to item ply of prev_move
                if hslot is not 0:
                    set item hslot of counter to best_move
                if item ply of killer1 is not best_move:
                    set item ply of killer2 to item ply of killer1
                    set item ply of killer1 to best_move
                if nh is 1:
                    call hist_cutoff with ply and depth and src and dst and moving and nq
                else:
                    set hslot to (src * 120) + dst
                    add depth * depth to item hslot of history
                    if item hslot of history is greater than 6000:
                        set item hslot of history to 6000
            else if nh is 1 and took is not 0:
                call cap_cutoff with ply and depth and moving and dst and took and nc
            stop
        if nh is 1:
            if quiet is 1:
                if nq is less than 63:
                    set item ((ply * 64) + nq) of q_src to src
                    set item ((ply * 64) + nq) of q_dst to dst
                    add 1 to nq
            else if took is not 0:
                if nc is less than 63:
                    set item ((ply * 64) + nc) of c_src to src
                    set item ((ply * 64) + nc) of c_dst to dst
                    add 1 to nc

    if seen is 0 and aborted is 0:
        if ply is 1:
            set best_from to 0
            set best_to to 0
            give back 0
        if checked is 1:
            give back ply - 80000
        give back 0

    (--- remember the result ---)
    if depth is at least 2 and use(1) is 1 and best is greater than -70000 and best is less than 70000 and item ply of excl is 0:
        set bound to 0
        if best is at most alpha0:
            set bound to 2
        if best is at least beta0:
            set bound to 1
        if aborted is 0:
            set ent to best_move + (16384 * ((depth mod 64) + (64 * (bound + (4 * (tt_age + (256 * (best + 100000))))))))
            set slot_t to (key mod tt_buckets) * 2
            set e0 to item slot_t of tt_a
            set e1 to item (slot_t + 1) of tt_a
            set m0 to 0
            set m1 to 0
            if e0 is not 0 and (item slot_t of tt_b) + e0 is key:
                set m0 to 1
            if e1 is not 0 and (item (slot_t + 1) of tt_b) + e1 is key:
                set m1 to 1
            if m0 is 1:
                set item slot_t of tt_a to ent
                set item slot_t of tt_b to key - ent
            else if m1 is 1:
                set item (slot_t + 1) of tt_a to ent
                set item (slot_t + 1) of tt_b to key - ent
            else:
                set d0 to (floor of (e0 / 16384)) mod 64
                set a0 to (floor of (e0 / 1048576)) mod 256
                if e0 is 0 or a0 is not tt_age or depth is at least d0:
                    if e0 is not 0:
                        set item (slot_t + 1) of tt_b to item slot_t of tt_b
                        set item (slot_t + 1) of tt_a to e0
                    set item slot_t of tt_a to ent
                    set item slot_t of tt_b to key - ent
                else:
                    set item (slot_t + 1) of tt_a to ent
                    set item (slot_t + 1) of tt_b to key - ent
    give back best


(=============================================================================)
(                  AUTOMATIC DEPTH FROM THE NON-PAWN MATERIAL                 )
(=============================================================================)

(NPM = the value of all knights, bishops, rooks and queens of both sides.  The start)
(position has 6400.  The tree grows by a factor of about 1.65 per ply with few pieces)
(and 1.77 with all of them (measured), and the first plies cost a few hundred nodes, so the)
(depth that fits a node budget follows from the NPM.)
define npm_total:
    Let a number be called x
    Let a number be called cnt
    Let a number be called total
    for kind from 2 to 5:
        set x to item (6 + kind) of bbp
        bitwise or x with item (6 - kind) of bbp
        count the set bits of x and store the result in cnt
        add cnt * (item kind of piece_value) to total
    give back total

(Growth of the tree per ply times 100, from the NPM.)
define ebf_for with npmv:
    Let a number be called b
    set b to 165 + floor of ((12 * (npmv - 1000)) / 5400)
    if b is less than 150:
        set b to 150
    if b is greater than 185:
        set b to 185
    give back b

(The depth the NPM model expects to finish within a number of milliseconds at a given nodes per second.)
define est_depth with npmv and rate and millis:
    Let a number be called nodes
    Let a number be called val
    Let a number be called d
    Let a number be called b
    set b to ebf_for(npmv)
    set nodes to floor of ((rate * millis) / 1000)
    set val to 350
    set d to 0
    while d is less than 40 and floor of ((val * b) / 100) is at most nodes:
        set val to floor of ((val * b) / 100)
        add 1 to d
    give back d

(What a quiescence search says about the position after the best move so far, as the side to move sees it.)
(When it disagrees with the search the line ends in a tactic, and the search deserves more time.)
define consult_qs with side:
    Let a number be called v
    if best_from is 0:
        give back 0
    call apply_move with 1 and best_from and best_to
    set v to 0 - quiesce(2, -999999, 999999, 0 - side)
    call undo_move with 1 and best_from and best_to
    give back v

(Iterative deepening: search 1 ply, then 2, ... up to max_depth.  Each round)
(leaves the best moves in the transposition table, which makes the next round)
(prune far more.  From depth 3 on, an aspiration window around the last score)
(is tried first and widened if the score falls outside it.)
define think with limit and side:
    Let a number be called score
    Let a number be called last
    Let a number be called low
    Let a number be called high
    Let a number be called id
    Let a number be called top
    Let a number be called nowt
    Let a number be called tm_on
    Let a number be called tm_stop
    Let a number be called dur
    Let a number be called r100
    Let a number be called unstable
    Let a number be called t_eff
    Let a number be called qv
    set nodes to 0
    set tm_on to 0
    if fast_mode is 0 and soft_ms is greater than 0:
        set tm_on to 1
    set ebf_base to ebf_for(npm_total())
    set ebf100 to ebf_base
    set t_prev_end to search_start
    set dur_prev to 0
    set prev_sc to 0
    set prev_mv to 0
    set pred_ms to 1
    set tm_abort_t to 0
    set tm_cap_t to 0
    set reached_d to 0
    set hash_pieces to scan_hash()
    set aborted to 0
    set is_helper to 0
    set max_ply to 22
    if feature(1048576) is 1:
        set max_ply to 60
    set id to 0
    set tt_age to (tt_age + 1) mod 256
    set tb_wid to 0
    call tb_root_filter with side
    store 0 in ctl at index 0
    (Lazy SMP: every thread searches the same position with the same table, so each)
    (one's discoveries speed up the others.  Worker 0 is the real search; the others)
    (skip some depths, so they are busy on different parts of the tree.)
    if threads is greater than 1:
        start threads workers and store my worker number in id
        if id is greater than 0:
            set is_helper to 1
            set tb_wid to id
    if nn_on is 1:
        call nn_refresh with 1
    set low to -999999
    set high to 999999
    set last to 0
    set top to limit
    if id is greater than 0:
        set top to limit + 1
    for d from 1 to top:
        if id is greater than 0 and ((d + id) mod 4) is 0:
            skip
        if soft_stop is greater than 0 and d is at least 2 and id is 0 and tm_on is 0:
            read the clock into nowt
            if nowt is at least soft_stop:
                stop
        if d is at least 3 and use(128) is 1:
            set low to last - 60
            set high to last + 60
        set score to search(1, d, low, high, side, 0)
        if aborted is 1:
            stop
        if score is at most low or score is at least high:
            set score to search(1, d, -999999, 999999, side, 0)
        if aborted is 1:
            stop
        set last to score
        set tm_stop to 0
        if id is 0:
            set reached_d to d
        if id is 0 and soft_ms is greater than 0:
            read the clock into nowt
            set dur to nowt - t_prev_end
            set t_prev_end to nowt
            if d is at least 4 and dur_prev is at least 4 and dur is at least 4:
                set r100 to floor of ((dur * 100) / dur_prev)
                if r100 is less than floor of ((ebf_base * 80) / 100):
                    set r100 to floor of ((ebf_base * 80) / 100)
                if r100 is greater than floor of ((ebf_base * 140) / 100):
                    set r100 to floor of ((ebf_base * 140) / 100)
                set ebf100 to floor of (((ebf100 * 2) + r100) / 3)
            set dur_prev to dur
            if tm_on is 1:
                (the soft time is a target, not a wall: the depth being searched is finished when it is)
                (70 percent done by then; a shaky best move or a quiescence disagreement buys 50 percent more)
                set unstable to 0
                if prev_mv is not 0 and d is at least 5 and prev_mv is not (best_from * 128) + best_to:
                    set unstable to 1
                if d is at least 5 and prev_sc - score is at least 25:
                    set unstable to 1
                if d is at least 6:
                    set qv to consult_qs(side) - score
                    calculate the absolute value of qv and store the result in qv
                    if qv is at least 40:
                        set unstable to 1
                set t_eff to soft_ms
                if unstable is 1:
                    set t_eff to floor of ((soft_ms * 3) / 2)
                    if hard_ms is greater than 0 and t_eff is greater than hard_ms - 10:
                        set t_eff to hard_ms - 10
                    if t_eff is less than soft_ms:
                        set t_eff to soft_ms
                set pred_ms to floor of ((dur * ebf100) / 100)
                if pred_ms is less than 1:
                    set pred_ms to 1
                set depth_start_t to nowt
                set tm_abort_t to search_start + t_eff
                set tm_cap_t to search_start + floor of ((t_eff * 17) / 10)
                if deadline is greater than 0 and tm_cap_t is greater than deadline:
                    set tm_cap_t to deadline
                if (nowt - search_start) + floor of ((pred_ms * 70) / 100) is greater than t_eff:
                    set tm_stop to 1
            set prev_mv to (best_from * 128) + best_to
            set prev_sc to score
        if uci_mode is 1 and id is 0:
            call uci_info with d and score
            if score is at least 79000 or score is at most -79000:
                stop
        if tm_stop is 1:
            stop
        if best_from is 0:
            stop
    if id is greater than 0:
        finish
    store 1 in ctl at index 0
    wait for the workers
    give back last

(=============================================================================)
(                              OPENING BOOK                                   )
(=============================================================================)

(The book is the text file apexz_book.txt: opening lines written as moves like e2e4,)
(separated by spaces or new lines, every line ending with a full stop.  Black's replies)
(are remembered by the position they follow, so the same position reached by a different)
(move order is still found.  Every move is checked for legality as it is loaded.)
routine load_book:
    Let a number be called c1
    Let a number be called c2
    Let a number be called c3
    Let a number be called c4
    Let a number be called ff
    Let a number be called fr
    Let a number be called tf
    Let a number be called tr
    Let a number be called src
    Let a number be called dst
    Let a number be called n
    Let a number be called alive
    Let a number be called reading
    Let a number be called side
    Let a number be called found
    Let a number be called dup
    Let a number be called count
    Let a number be called key
    Let a number be called bad_lines
    Let a number be called mv
    set book_n to 0
    set book_seed to 20241108
    open the file "apexz_book.txt" for reading
    if input_ok is 0:
        print "(no opening book: apexz_book.txt was not found next to the engine)"
    else:
        set reading to 1
        set alive to 1
        set side to 1
        set n to 0
        while reading is 1:
            read the next character into c1
            if input_ok is 0:
                set reading to 0
            else if c1 is '.':
                for u from n to 1 by -1:
                    call undo_move with u - 1 and item (u - 1) of line_src and item (u - 1) of line_dst
                set n to 0
                set alive to 1
                set side to 1
            else:
                read the next character into c2
                read the next character into c3
                read the next character into c4
                if alive is 1:
                    set ff to file_of(c1)
                    set fr to rank_of(c2)
                    set tf to file_of(c3)
                    set tr to rank_of(c4)
                    set found to 0
                    if ff is at least 0 and fr is at least 0 and tf is at least 0 and tr is at least 0:
                        set src to square(fr, ff)
                        set dst to square(tr, tf)
                        call generate with 1 and side
                        set count to item 1 of mv_count
                        for i from 0 to count - 1:
                            if item i of mv_from is src and item i of mv_to is dst:
                                set found to 1
                                stop
                    if found is 0:
                        set alive to 0
                        add 1 to bad_lines
                    else:
                        if side is -1 and book_n is less than 1024:
                            set key to position_key(-1)
                            set mv to (src * 128) + dst
                            set dup to 0
                            for i from 0 to book_n - 1:
                                if item i of book_key is key and item i of book_move is mv:
                                    set dup to 1
                            if dup is 0:
                                set item book_n of book_key to key
                                set item book_n of book_move to mv
                                add 1 to book_n
                        call apply_move with n and src and dst
                        set item n of line_src to src
                        set item n of line_dst to dst
                        add 1 to n
                        set side to 0 - side
                        if n is at least 20:
                            set alive to 0
        run close_book
        print "Opening book: ", book_n, " Black replies loaded from apexz_book.txt"
        if bad_lines is greater than 0:
            print "   (", bad_lines, " book lines had an illegal or unreadable move and were cut short)"

routine close_book:
    close the file

(A book move for Black in the current position, or 0 when the book has none.  When)
(several moves are known one is picked at random.)
define book_move_for with side:
    Let a number be called key
    Let a number be called count
    Let a number be called pick
    Let a number be called mv
    Let a number be called ok
    Let a number be called seen
    if book_n is 0:
        give back 0
    set key to position_key(side)
    for i from 0 to book_n - 1:
        if item i of book_key is key:
            add 1 to count
    if count is 0:
        give back 0
    set book_seed to ((book_seed * 48271) + game_n) mod 2147483647
    set pick to book_seed mod count
    for i from 0 to book_n - 1:
        if item i of book_key is key:
            if seen is pick:
                set mv to item i of book_move
            add 1 to seen
    (make sure it really is a legal move here)
    call generate with 1 and side
    for i from 0 to item 1 of mv_count - 1:
        if (item i of mv_from * 128) + item i of mv_to is mv:
            set ok to 1
    if ok is 1:
        give back mv
    give back 0

(=============================================================================)
(                         DYNAMIC SEARCH DEPTH                                )
(=============================================================================)

(How deep to search, from the material left: with all the pieces on the board)
(there are the most moves, so the opening gets 13 plies; the middlegame gets 11;)
(with few pieces the tree is narrow and the endgame gets 16.  Material counts)
(knights, bishops, rooks and queens of both sides; the start is 6400.)
define auto_depth:
    Let a number be called total
    Let a number be called sq
    Let a number be called kind
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            calculate the absolute value of item sq of board and store the result in kind
            if kind is at least 2 and kind is at most 5:
                add item kind of piece_value to total
    if total is at least 5600:
        give back 14
    if total is at most 3200:
        give back 17
    give back 13

(=============================================================================)
(                         REAL MOVE EXECUTION                                 )
(=============================================================================)

(Play src -> dst on the real board.  A white pawn reaching the last rank asks)
(what to become; the engine's own pawns always become queens.)
define make_real_move with src and dst:
    Let a number be called answer
    Let a number be called final
    Let a number be called mover
    call apply_move with 0 and src and dst
    if item 0 of u_moving is 1 and dst is at least 91:
        write "Pawn promotion! Choose (q=Queen, r=Rook, b=Bishop, n=Knight) [q]: "
        read the next character into answer
        set final to 5
        if answer is 'r' or answer is 'R':
            set final to 4
        else if answer is 'b' or answer is 'B':
            set final to 3
        else if answer is 'n' or answer is 'N':
            set final to 2
        set item dst of board to final
        run bb_sync

    (remember the position, for spotting repetitions)
    set mover to 1
    if item 0 of u_moving is less than 0:
        set mover to -1
    set hash_pieces to scan_hash()
    if game_n is less than 511:
        set item game_n of game_keys to position_key(0 - mover)
        add 1 to game_n

(=============================================================================)
(                          POLYGLOT OPENING BOOKS                             )
(=============================================================================)

(APEX-Z can read Polyglot .bin books, the format used by most downloadable opening)
(books.  Put one next to the engine called book.bin (or polyglot.bin).  Each entry is)
(16 bytes: a 64-bit position key, a move, a weight and a learn field, sorted by key,)
(so a position is found by binary search with no need to load the file.  The key is)
(the XOR of fixed random numbers for every piece, castling right, en passant file and)
(the side to move.  Zoomy numbers are exact up to 2^53, so a 64-bit key is kept as two)
(32-bit halves and XORed bit by bit.  The 781 random numbers are the Polyglot standard.)

(XOR of two numbers below 2^32.)
define xor32 with u and v:
    Let a number be called r
    Let a number be called p
    Let a number be called x
    Let a number be called y
    if u is 0:
        give back v
    if v is 0:
        give back u
    set p to 1
    set x to u
    set y to v
    for k from 1 to 32:
        if (x mod 2) is not (y mod 2):
            add p to r
        set x to floor of (x / 2)
        set y to floor of (y / 2)
        set p to p * 2
    give back r

routine init_polyglot:
    store 2637767806 in pg_hi at index 0
    store 863464769 in pg_lo at index 0
    store 720845184 in pg_hi at index 1
    store 95069639 in pg_lo at index 1
    store 1155203408 in pg_hi at index 2
    store 610415943 in pg_lo at index 2
    store 2618685246 in pg_hi at index 3
    store 1655139042 in pg_lo at index 3
    store 1971536997 in pg_hi at index 4
    store 1218186377 in pg_lo at index 4
    store 848342074 in pg_hi at index 5
    store 540017087 in pg_lo at index 5
    store 263957791 in pg_hi at index 6
    store 1627660921 in pg_lo at index 6
    store 3896152207 in pg_hi at index 7
    store 4076560586 in pg_lo at index 7
    store 226391645 in pg_hi at index 8
    store 1484086288 in pg_lo at index 8
    store 436746274 in pg_hi at index 9
    store 3467632685 in pg_lo at index 9
    store 2516964848 in pg_hi at index 10
    store 3797861296 in pg_lo at index 10
    store 3491888988 in pg_hi at index 11
    store 3510251221 in pg_lo at index 11
    store 1086189917 in pg_hi at index 12
    store 1248276018 in pg_lo at index 12
    store 18044180 in pg_hi at index 13
