(The Polyglot key of the current board with side to move, left in pg_khi and pg_klo.)
define pg_compute with side:
    Let a number be called sq
    Let a number be called piece
    Let a number be called kind
    Let a number be called idx
    Let a number be called ok
    Let a number be called file
    set pg_khi to 0
    set pg_klo to 0
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            set piece to item sq of board
            if piece is not 0:
                calculate the absolute value of piece and store the result in kind
                set idx to (2 * (kind - 1)) * 64
                if piece is greater than 0:
                    set idx to ((2 * (kind - 1)) + 1) * 64
                set idx to idx + (8 * r) + f
                set pg_khi to xor32(pg_khi, item idx of pg_hi)
                set pg_klo to xor32(pg_klo, item idx of pg_lo)
    for i from 0 to 3:
        if item i of castle is 1:
            set idx to 768 + i
            set pg_khi to xor32(pg_khi, item idx of pg_hi)
            set pg_klo to xor32(pg_klo, item idx of pg_lo)
    if ep_sq is not 0:
        set ok to 0
        if side is 1:
            if item (ep_sq - 9) of board is 1 or item (ep_sq - 11) of board is 1:
                set ok to 1
        else:
            if item (ep_sq + 9) of board is -1 or item (ep_sq + 11) of board is -1:
                set ok to 1
        if ok is 1:
            set file to (ep_sq mod 10) - 1
            set idx to 772 + file
            set pg_khi to xor32(pg_khi, item idx of pg_hi)
            set pg_klo to xor32(pg_klo, item idx of pg_lo)
    if side is 1:
        set pg_khi to xor32(pg_khi, item 780 of pg_hi)
        set pg_klo to xor32(pg_klo, item 780 of pg_lo)
    give back 0

(Read big-endian numbers from the book file.)
define pg_u32:
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called b3
    read the next byte into b0
    read the next byte into b1
    read the next byte into b2
    read the next byte into b3
    give back (((((b0 * 256) + b1) * 256) + b2) * 256) + b3

define pg_u16:
    Let a number be called b0
    Let a number be called b1
    read the next byte into b0
    read the next byte into b1
    give back (b0 * 256) + b1

(The key of entry number idx, left in pg_ehi and pg_elo.)
define pg_key_at with idx:
    move to byte (idx * 16) of the file
    set pg_ehi to pg_u32()
    set pg_elo to pg_u32()
    give back 0

define pg_open:
    open the file "book.bin" for reading
    if input_ok is 1:
        give back 1
    open the file "polyglot.bin" for reading
    if input_ok is 1:
        give back 1
    give back 0

(A move from the Polyglot book for side in the current position, as src * 128 + dst, or)
(0 when there is none.  Moves are picked at random in proportion to their weights.)
define pg_book_move with side:
    Let a number be called size
    Let a number be called n
    Let a number be called lo
    Let a number be called hi
    Let a number be called mid
    Let a number be called idx
    Let a number be called cnt
    Let a number be called going
    Let a number be called m
    Let a number be called w
    Let a number be called tf
    Let a number be called tr
    Let a number be called ff
    Let a number be called fr
    Let a number be called promo
    Let a number be called src
    Let a number be called dst
    Let a number be called legal
    Let a number be called total
    Let a number be called pick
    Let a number be called acc
    if pg_open() is 0:
        give back 0
    read the file size into size
    set n to floor of (size / 16)
    if n is less than 1:
        close the file
        give back 0
    call pg_compute with side
    set lo to 0
    set hi to n
    while lo is less than hi:
        set mid to floor of ((lo + hi) / 2)
        call pg_key_at with mid
        if pg_ehi is less than pg_khi or (pg_ehi is pg_khi and pg_elo is less than pg_klo):
            set lo to mid + 1
        else:
            set hi to mid
    set idx to lo
    set going to 1
    while going is 1 and idx is less than n and cnt is less than 60:
        call pg_key_at with idx
        if pg_ehi is pg_khi and pg_elo is pg_klo:
            set m to pg_u16()
            set w to pg_u16()
            set item cnt of pg_mv to m
            set item cnt of pg_wt to w
            add 1 to cnt
            add 1 to idx
        else:
            set going to 0
    close the file
    if cnt is 0:
        give back 0
    call generate with 1 and side
    for j from 0 to cnt - 1:
        set m to item j of pg_mv
        set tf to m mod 8
        set tr to floor of (m / 8) mod 8
        set ff to floor of (m / 64) mod 8
        set fr to floor of (m / 512) mod 8
        set promo to floor of (m / 4096) mod 8
        set src to square(fr, ff)
        set dst to square(tr, tf)
        if item src of board is 6 or item src of board is -6:
            if src is 25 or src is 95:
                if dst is src + 3:
                    set dst to src + 2
                if dst is src - 4:
                    set dst to src - 2
        set legal to 0
        if promo is 0 or promo is 4:
            for i from 0 to item 1 of mv_count - 1:
                if item i of mv_from is src and item i of mv_to is dst:
                    set legal to 1
                    stop
        if legal is 1 and item j of pg_wt is greater than 0:
            set item j of pg_mv to (src * 128) + dst
            add item j of pg_wt to total
        else:
            set item j of pg_wt to 0
    if total is 0:
        give back 0
    set book_seed to ((book_seed * 48271) + game_n) mod 2147483647
    set pick to book_seed mod total
    for j from 0 to cnt - 1:
        if item j of pg_wt is greater than 0:
            if pick is at least acc and pick is less than acc + item j of pg_wt:
                give back item j of pg_mv
            add item j of pg_wt to acc
    give back 0

(Ask the Polyglot book first, then the built-in text book (which only knows Black).)
define book_pick with side:
    Let a number be called mv
    set mv to pg_book_move(side)
    if mv is not 0:
        set pg_used to 1
        give back mv
    set pg_used to 0
    if side is -1:
        give back book_move_for(-1)
    give back 0

(=============================================================================)
(                    UCI PROTOCOL  - to play inside a chess GUI               )
(=============================================================================)

(Start the engine and type  uci  (or uciok) as the first thing: APEX-Z then speaks the)
(Universal Chess Interface and works with GUIs such as Arena, cutechess-cli and)
(Lichess bots.  Typing anything else plays the console game as before.)

(Read one word from standard input.  Words are separated by spaces; the word is kept)
(in tok, its length in tok_len, a case-blind hash in tok_hash and, when it is a number,)
(its value in tok_num.  tok_end becomes 1 when the line is over.)
routine read_token:
    Let a number be called c
    Let a number be called lc
    Let a number be called going
    set tok_len to 0
    set tok_hash to 0
    set tok_num to 0
    set tok_isnum to 1
    set tok_sign to 1
    set tok_end to 0
    read the next byte into c
    while input_ok is 1 and (c is 32 or c is 9 or c is 13):
        read the next byte into c
    if input_ok is 0:
        set tok_end to 1
        set quit_flag to 1
    else if c is 10:
        set tok_end to 1
    else:
        set going to 1
        while going is 1:
            if tok_len is less than 127:
                set item tok_len of tok to c
            set lc to c
            if c is at least 65 and c is at most 90:
                set lc to c + 32
            set tok_hash to ((tok_hash * 131) + lc) mod 2147483647
            if c is at least 48 and c is at most 57:
                if tok_num is less than 100000000000:
                    set tok_num to (tok_num * 10) + (c - 48)
            else if c is 45 and tok_len is 0:
                set tok_sign to -1
            else:
                set tok_isnum to 0
            add 1 to tok_len
            read the next byte into c
            if input_ok is 0:
                set tok_end to 1
                set quit_flag to 1
                set going to 0
            else if c is 32 or c is 9 or c is 13 or c is 10:
                set going to 0
                if c is 10:
                    set tok_end to 1

routine uci_flush:
    while tok_end is 0:
        run read_token

routine uci_hello:
    print "id name APEX-Z 7.1"
    print "id author Zoomy"
    print "option name Threads type spin default ", ncores, " min 1 max 1024"
    print "option name OwnBook type check default true"
    print "option name Hash type spin default 64 min 1 max 256"
    print "option name Features type spin default 21233615 min 0 max 536870911"
    print "option name SyzygyPath type string default <empty>"
    print "option name SyzygyProbeDepth type spin default 1 min 1 max 100"
    print "option name SyzygyProbeLimit type spin default 7 min 0 max 7"
    print "option name EvalFile type string default apexz.nnue"
    if nn_ready is 1:
        print "option name UseNNUE type check default true"
    else:
        print "option name UseNNUE type check default false"
    print "option name NNDebug type check default false"
    print "uciok"

routine uci_setoption:
    Let a number be called which
    set which to 0
    while tok_end is 0:
        run read_token
        if tok_hash is 1835982604:
            set which to 1
        else if tok_hash is 1545076900:
            set which to 2
        else if tok_hash is 805844653:
            set which to 3
        else if tok_hash is 235481250:
            set which to 4
        else if tok_hash is 763616851:
            set which to 5
        else if tok_hash is 803621351:
            set which to 6
        else if tok_hash is 1021076524:
            set which to 7
        else if tok_hash is 705175970:
            set which to 8
        else if tok_hash is 232172348:
            set which to 9
        else if tok_hash is 546904364:
            set which to 10
        else if tok_hash is 664921361:
            set which to 11
        else if tok_hash is 611185969 and tok_end is 0:
            if which is 5:
                run tb_read_path
            else if which is 8:
                run nn_read_path
            else:
                run read_token
            if which is 9:
                if tok_hash is 262750338 and nn_ready is 1:
                    set nn_on to 1
                if tok_hash is 194154265:
                    set nn_on to 0
            if which is 11:
                set nn_pct to tok_num
            if which is 10:
                set nn_dbg to 0
                if tok_hash is 262750338:
                    set nn_dbg to 1
            if which is 6 and tok_isnum is 1:
                set tb_pdepth to tok_num
                if tb_pdepth is less than 1:
                    set tb_pdepth to 1
            if which is 7 and tok_isnum is 1:
                set tb_maxmen to tok_num
                if tb_maxmen is greater than 7:
                    set tb_maxmen to 7
            if which is 1 and tok_isnum is 1:
                set threads to tok_num
                if threads is less than 1:
                    set threads to 1
                if threads is greater than 1024:
                    set threads to 1024
            if which is 3 and tok_isnum is 1:
                set feat to tok_num
                set use_pext to 0
                if feature(524288) is 1:
                    if pext_ready is 0:
                        run build_pext
                    set use_pext to 1
            if which is 4 and tok_isnum is 1:
                set tt_mb to tok_num
                if tt_mb is less than 1:
                    set tt_mb to 1
                if tt_mb is greater than 256:
                    set tt_mb to 256
                set tt_buckets to tt_mb * 32768
            if which is 2:
                if tok_hash is 262750338:
                    set own_book to 1
                if tok_hash is 194154265:
                    set own_book to 0

routine uci_reset_game:
    set hash_pieces to scan_hash()
    set item 0 of game_keys to position_key(uside)
    set game_n to 1

(Play the move written in tok (like e2e4 or e7e8q) on the real board.)
routine uci_apply_text:
    Let a number be called ff
    Let a number be called fr
    Let a number be called tf
    Let a number be called tr
    Let a number be called src
    Let a number be called dst
    Let a number be called found
    Let a number be called kind
    Let a number be called pc
    Let a number be called mover
    set ff to file_of(item 0 of tok)
    set fr to rank_of(item 1 of tok)
    set tf to file_of(item 2 of tok)
    set tr to rank_of(item 3 of tok)
    if ff is less than 0 or fr is less than 0 or tf is less than 0 or tr is less than 0:
        set uci_bad to 1
    else:
        set src to square(fr, ff)
        set dst to square(tr, tf)
        call generate with 1 and uside
        for i from 0 to item 1 of mv_count - 1:
            if item i of mv_from is src and item i of mv_to is dst:
                set found to 1
                stop
        if found is 0:
            set uci_bad to 1
            print "info string illegal move ignored"
        else:
            call apply_move with 0 and src and dst
            set mover to 1
            if item 0 of u_moving is less than 0:
                set mover to -1
            if tok_len is at least 5:
                set pc to item 4 of tok
                set kind to 0
                if pc is 'q' or pc is 'Q':
                    set kind to 5
                if pc is 'r' or pc is 'R':
                    set kind to 4
                if pc is 'b' or pc is 'B':
                    set kind to 3
                if pc is 'n' or pc is 'N':
                    set kind to 2
                if kind is not 0 and (item 0 of u_moving is 1 or item 0 of u_moving is -1):
                    set item dst of board to kind * mover
                    run bb_sync
            set hash_pieces to scan_hash()
            if game_n is less than 511:
                set item game_n of game_keys to position_key(0 - mover)
                add 1 to game_n
            set uside to 0 - mover

routine uci_read_fen:
    Let a number be called r
    Let a number be called f
    Let a number be called c
    Let a number be called lc
    Let a number be called kind
    for rr from 0 to 7:
        for ff from 0 to 7:
            set item square(rr, ff) of board to 0
    for i from 0 to 3:
        set item i of castle to 0
    set ep_sq to 0
    run read_token
    set r to 7
    set f to 0
    for i from 0 to tok_len - 1:
        set c to item i of tok
        if c is '/':
            subtract 1 from r
            set f to 0
        else if c is at least '1' and c is at most '8':
            add c - 48 to f
        else:
            set kind to 0
            set lc to c
            if c is less than 97:
                set lc to c + 32
            if lc is 'p':
                set kind to 1
            if lc is 'n':
                set kind to 2
            if lc is 'b':
                set kind to 3
            if lc is 'r':
                set kind to 4
            if lc is 'q':
                set kind to 5
            if lc is 'k':
                set kind to 6
            if kind is not 0 and r is at least 0 and r is at most 7 and f is at most 7:
                if c is less than 97:
                    set item square(r, f) of board to kind
                else:
                    set item square(r, f) of board to 0 - kind
                add 1 to f
    run bb_sync
    set uside to 1
    if tok_end is 0:
        run read_token
        if item 0 of tok is 'b':
            set uside to -1
    if tok_end is 0:
        run read_token
        for i from 0 to tok_len - 1:
            set c to item i of tok
            if c is 'K':
                set item 0 of castle to 1
            if c is 'Q':
                set item 1 of castle to 1
            if c is 'k':
                set item 2 of castle to 1
            if c is 'q':
                set item 3 of castle to 1
    if tok_end is 0:
        run read_token
        if tok_len is 2:
            set f to file_of(item 0 of tok)
            set r to rank_of(item 1 of tok)
            if f is at least 0 and (r is 2 or r is 5):
                set ep_sq to square(r, f)

routine uci_position:
    Let a number be called saw_moves
    set uci_bad to 0
    if tok_end is 0:
        run read_token
        if tok_hash is 866750299:
            run init_board
            set uside to 1
        else if tok_hash is 1763763:
            run uci_read_fen
        if tok_end is 0:
            run read_token
        while tok_end is 0 and tok_hash is not 139813129:
            run read_token
        if tok_hash is 139813129:
            set saw_moves to 1
    run uci_reset_game
    if saw_moves is 1:
        while tok_end is 0:
            run read_token
            if tok_len is at least 4 and uci_bad is 0:
                run uci_apply_text
    run uci_flush

(Print the "info" line after a finished search depth.)
define uci_info with d and score:
    Let a number be called t
    Let a number be called n
    if best_from is 0:
        give back 0
    read the clock into t
    write "info depth ", d, " score "
    if score is at least 70000:
        set n to floor of ((80000 - score + 1) / 2)
        write "mate ", n
    else if score is at most -70000:
        set n to floor of ((80000 + score + 1) / 2)
        write "mate -", n
    else:
        write "cp ", score
    write " nodes ", nodes, " time ", t - search_start, " pv "
    call show_square with best_from
    call show_square with best_to
    print ""
    give back 0

routine uci_go:
    Let a number be called wt
    Let a number be called bt
    Let a number be called wi
    Let a number be called bi
    Let a number be called mtg
    Let a number be called mt
    Let a number be called dp
    Let a number be called mytime
    Let a number be called myinc
    Let a number be called alloc
    Let a number be called hard
    Let a number be called limit
    Let a number be called slot
    Let a number be called book_mv
    Let a number be called kind
    set wt to -1
    set bt to -1
    set wi to 0
    set bi to 0
    set mtg to 0
    set mt to 0
    set dp to 0
    while tok_end is 0:
        run read_token
        if tok_end is 0 and tok_isnum is 0:
            (the word before a number)
            if tok_hash is 948347088:
                run read_token
                set wt to tok_num * tok_sign
            else if tok_hash is 1206299688:
                run read_token
                set bt to tok_num * tok_sign
            else if tok_hash is 269339243:
                run read_token
                set wi to tok_num * tok_sign
            else if tok_hash is 222129332:
                run read_token
                set bi to tok_num * tok_sign
            else if tok_hash is 1908546286:
                run read_token
                set mtg to tok_num
            else if tok_hash is 492025254:
                run read_token
                set mt to tok_num
            else if tok_hash is 1761699212:
                run read_token
                set dp to tok_num
    set mytime to wt
    set myinc to wi
    if uside is -1:
        set mytime to bt
        set myinc to bi
    set limit to 12
    set deadline to 0
    set soft_stop to 0
    set soft_ms to 0
    set hard_ms to 0
    set prev_mv to 0
    set soft_nodes to 0
    set hard_nodes to 0
    read the clock into search_start
    if mt is greater than 0:
        set limit to 20
        set hard to mt - 15
        if hard is less than 5:
            set hard to 5
        set deadline to search_start + hard
        set soft_stop to search_start + floor of (mt / 2)
        set soft_ms to floor of (mt / 2)
        set hard_ms to hard
    else if mytime is greater than 0:
        set limit to 20
        set alloc to floor of (mytime / 30)
        if mtg is greater than 0 and mtg is at most 40:
            set alloc to floor of (mytime / (mtg + 1))
        add floor of (myinc * 3 / 4) to alloc
        if alloc is greater than floor of (mytime * 4 / 10):
            set alloc to floor of (mytime * 4 / 10)
        if alloc is less than 5:
            set alloc to 5
        set hard to floor of (alloc * 5 / 2)
        if hard is greater than floor of (mytime / 2):
            set hard to floor of (mytime / 2)
        if hard is less than 5:
            set hard to 5
        set deadline to search_start + hard
        set soft_stop to search_start + floor of (alloc * 45 / 100)
        set soft_ms to floor of (alloc * 45 / 100)
        set hard_ms to hard
    if dp is greater than 0:
        set limit to dp
    if limit is greater than 20:
        set limit to 20
    set best_from to 0
    set best_to to 0
    set book_mv to 0
    if own_book is 1:
        set book_mv to book_pick(uside)
    if book_mv is not 0:
        set best_from to floor of (book_mv / 128)
        set best_to to book_mv mod 128
        if pg_used is 1:
            print "info string book move (Polyglot)"
        else:
            print "info string book move"
    else:
        set slot to think(limit, uside)
    set deadline to 0
    if best_from is 0:
        call generate with 1 and uside
        if item 1 of mv_count is greater than 0:
            set best_from to item 0 of mv_from
            set best_to to item 0 of mv_to
    if best_from is 0:
        print "bestmove 0000"
    else:
        write "bestmove "
        call show_square with best_from
        call show_square with best_to
        set kind to item best_from of board
        if kind is 1 and best_to is at least 91:
            write "q"
        if kind is -1 and best_to is at most 28:
            write "q"
        print ""

routine uci_loop:
    set uci_mode to 1
    set quit_flag to 0
    set own_book to 1
    run uci_hello
    while quit_flag is 0:
        run read_token
        if tok_len is 0:
            set tok_len to 0
        else if tok_hash is 2020911:
            run uci_hello
            run uci_flush
        else if tok_hash is 2020673110:
            print "readyok"
            run uci_flush
        else if tok_hash is 576376730:
            run init_board
            set uside to 1
            run uci_reset_game
            run uci_flush
        else if tok_hash is 562934117:
            run uci_setoption
        else if tok_hash is 1463618150:
            run uci_position
        else if tok_hash is 1005139399:
            call pg_compute with uside
            print "pgkey ", pg_khi, " ", pg_klo
            run uci_flush
        else if tok_hash is 13604:
            run uci_go
        else if tok_hash is 447936237:
            set fast_mode to 1
            print "info string ucifast: bullet mode, the time heuristics are off"
            run uci_flush
        else if tok_hash is 1727743893:
            run tb_report
            run uci_flush
        else if tok_hash is 413738781:
            set fast_mode to 0
            print "info string ucinormal: time heuristics on"
            run uci_flush
        else if tok_hash is 87287233:
            set nn_stm to uside
            print "hceval ", uside * evaluate_hce()
            run uci_flush
        else if tok_hash is 728006747:
            if nn_ready is 1:
                set nn_stm to uside
                call nn_refresh with 1
                print "nneval ", nn_stm * evaluate_nn()
            else:
                print "nneval none"
            run uci_flush
        else if tok_hash is 256055991:
            set quit_flag to 1
        else:
            run uci_flush

(=============================================================================)
(                               MAIN GAME ENTRY                               )
(=============================================================================)

action start:
    read the core count into ncores
    set last_nps to 1000000
    set auto_ms to 1000
    set tt_mb to 64
    set tt_buckets to 2097152
    run init_tables
    run init_bitboards
    run init_eval_masks
    run init_polyglot
    run tb_init_tables
    run tb_init_game
    set nn_pct to 100
    run nn_default_name
    if nn_load() is 1:
        set nn_on to 1
    run init_board
    set hash_pieces to scan_hash()
    set item 0 of game_keys to position_key(1)
    set game_n to 1

    print "=========================================================="
    print "             APEX-Z (v7.1) : CHESS ENGINE                 "
    print "  Static x86-64 ELF - Bitboards - Lazy SMP - Book - PSTs      "
    print "=========================================================="
    print "You play as White (Uppercase). APEX-Z is Black (lowercase)."
    print "Features: Castling (e1g1 / e1c1), En Passant, Promotions."
    print "Type 'q' to forfeit and exit.   (Type uci at the prompt below for UCI mode.)"

    Let a number be called depth_choice
    Let a number be called auto_mode
    write "Select depth in plies: 0=automatic (about 1 second a move), a number of milliseconds like 500 or 3000 = automatic with that time, 4-9, a=10 ... e=14: "
    run read_token
    set depth_choice to item 0 of tok
    if tok_hash is 2020911 or tok_hash is 321129967 or tok_hash is 447936237:
        print ""
        if tok_hash is 447936237:
            set fast_mode to 1
        set threads to ncores
        set feat to 21233615
        set pruning to 511
        set max_depth to 11
        run load_book
        run uci_loop
        finish
    set max_depth to 11
    set auto_mode to 1
    if tok_isnum is 1 and tok_num is at least 100:
        set depth_choice to 48
    if depth_choice is at least '4' and depth_choice is at most '9':
        set max_depth to depth_choice - 48
        set auto_mode to 0
    if depth_choice is at least 'a' and depth_choice is at most 'e':
        set max_depth to depth_choice - 87
        set auto_mode to 0
    if tok_isnum is 1 and tok_num is at least 100 and tok_num is at most 600000:
        set auto_ms to tok_num
    if auto_mode is 1:
        print "Engine configured: automatic depth: it searches as deep as fits in about ", auto_ms, " ms a move (from the non-pawn material and the speed measured)."
    else:
        print "Engine configured: ", max_depth, " plies (iterative deepening)."
    set pruning to 511
    set feat to 21233615
    Let a number be called thread_choice
    write "Search threads (1-1024, 0 = all ", ncores, " cores): "
    read thread_choice
    set threads to thread_choice
    if input_ok is 0 or thread_choice is 0:
        set threads to ncores
    if threads is greater than 1024:
        set threads to 1024
    if threads is less than 1:
        set threads to 1
    print "Engine configured: ", threads, " search thread(s) (Lazy SMP)."
    run load_book

    Let a number be called book_mv
    Let a number be called game_running
    Let a number be called in_check_now
    Let a number be called human_turn_active
    Let a number be called c1
    Let a number be called c2
    Let a number be called c3
    Let a number be called c4
    Let a number be called from_file
    Let a number be called from_rank
    Let a number be called to_file
    Let a number be called to_rank
    Let a number be called u_from
    Let a number be called u_to
    Let a number be called move_found
    Let a number be called move_count
    Let a number be called slot
    Let a number be called npm_now
    Let a number be called t_end
    Let a number be called last_ms
    set game_running to 1
    while game_running is 1:
        run print_board

        (--- 1. Check & legality assessment for the human ---)
        set in_check_now to in_check(1)
        if in_check_now is 1:
            print ">> Notice: Your King is in CHECK! <<"
        call generate with 1 and 1

        if item 1 of mv_count is 0:
            if in_check_now is 1:
                print "CHECKMATE! You have no legal moves. APEX-Z wins!"
            else:
                print "STALEMATE! You have no legal moves. It is a draw!"
            set game_running to 0
        else:
            (--- 2. Human move input ---)
            set human_turn_active to 1
            while human_turn_active is 1:
                write "Your move (e.g. e2e4): "
                read the next character into c1
                if input_ok is 0 or c1 is 'q' or c1 is 'Q':
                    print "Forfeited. Thanks for playing!"
                    set game_running to 0
                    set human_turn_active to 0
                else:
                    read the next character into c2
                    read the next character into c3
                    read the next character into c4
                    set from_file to file_of(c1)
                    set from_rank to rank_of(c2)
                    set to_file to file_of(c3)
                    set to_rank to rank_of(c4)
                    if from_file is less than 0 or from_rank is less than 0 or to_file is less than 0 or to_rank is less than 0:
                        print "Invalid notation! Enter 4 characters, e.g. e2e4."
                    else:
                        set u_from to square(from_rank, from_file)
                        set u_to to square(to_rank, to_file)
                        set move_found to 0
                        set move_count to item 1 of mv_count
                        for i from 0 to move_count - 1:
                            if item i of mv_from is u_from and item i of mv_to is u_to:
                                set move_found to 1
                                stop
                        if move_found is 0:
                            print "Illegal move! That leaves or puts you in check, or is not legal."
                        else:
                            call make_real_move with u_from and u_to
                            set human_turn_active to 0

            (--- 3. Computer AI turn ---)
            if game_running is 1:
                set in_check_now to in_check(-1)
                if in_check_now is 1:
                    print ">> Check! Black King is in check. <<"

                set book_mv to book_pick(-1)
                if book_mv is not 0:
                    set best_from to floor of (book_mv / 128)
                    set best_to to book_mv mod 128
                    set slot to 0
                else:
                    print "APEX-Z is computing search tree with MVV-LVA..."
                    if auto_mode is 1:
                        set npm_now to npm_total()
                        print "   (material ", npm_now, ": the model expects about ", est_depth(npm_now, last_nps, auto_ms), " plies in ", auto_ms, " ms)"
                        read the clock into search_start
                        set soft_ms to auto_ms
                        set hard_ms to floor of ((auto_ms * 5) / 2)
                        set deadline to search_start + hard_ms
                        set soft_stop to 0
                        set slot to think(20, -1)
                        set deadline to 0
                        set soft_ms to 0
                        set max_depth to reached_d
                        read the clock into t_end
                        set last_ms to t_end - search_start
                        set last_nps to floor of ((nodes * 1000) / (last_ms + 1))
                        if last_nps is less than 50000:
                            set last_nps to 50000
                    else:
                        set slot to think(max_depth, -1)

                if best_from is 0 and best_to is 0:
                    run print_board
                    if in_check_now is 1:
                        print "CHECKMATE! APEX-Z has no legal moves. You win!"
                    else:
                        print "STALEMATE! APEX-Z has no legal moves. It is a draw!"
                    set game_running to 0
                else:
                    write "APEX-Z plays: "
                    call show_square with best_from
                    call show_square with best_to
                    print ""
                    if book_mv is not 0:
                        print "   (opening book)"
                    else:
                        if auto_mode is 1:
                            print "   (reached ", max_depth, " plies in ", last_ms, " ms, searched ", nodes, " positions on the main thread, evaluation for White ", 0 - slot, ")"
                        else:
                            print "   (", max_depth, " plies, searched ", nodes, " positions on the main thread, evaluation for White ", 0 - slot, ")"
                    call make_real_move with best_from and best_to
