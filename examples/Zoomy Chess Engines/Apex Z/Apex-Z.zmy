(=============================================================================)
(                               SMALL HELPERS                                 )
(=============================================================================)

(The mailbox square for rank r  - 0..7 and file f  - 0..7.)
define square with r and f:
    give back (r + 2) * 10 + f + 1

(File and rank letters of a typed square, or -1 when they are not valid.)
define file_of with c:
    if c is at least 'a' and c is at most 'h':
        give back c - 97
    if c is at least 'A' and c is at most 'H':
        give back c - 65
    give back -1

define rank_of with c:
    if c is at least '1' and c is at most '8':
        give back c - 49
    give back -1

define show_square with sq:
    Let a number be called row
    set row to sq / 10
    write char 97 + (sq - (row * 10) - 1), char 49 + (row - 2)

(Natural logarithm of x (1 or more) in millionths, by integer fixed-point arithmetic:)
(halve x until it is below 2, then ln m = 2 * (y + y^3/3 + y^5/5 + ...) with y = (m - 1) / (m + 1).)
define ln_of with x:
    Let a number be called m
    Let a number be called k
    Let a number be called y
    Let a number be called y2
    Let a number be called term
    Let a number be called total
    set m to x * 1000000
    while m is at least 2000000:
        set m to m / 2
        add 1 to k
    set y to ((m - 1000000) * 1000000) / (m + 1000000)
    set y2 to (y * y) / 1000000
    set term to y
    for j from 0 to 9:
        add term / ((2 * j) + 1) to total
        set term to (term * y2) / 1000000
    give back (k * 693147) + (2 * total)

routine init_tables:
    store -21 in dirs at index 0
    store -19 in dirs at index 1
    store -12 in dirs at index 2
    store -8 in dirs at index 3
    store 8 in dirs at index 4
    store 12 in dirs at index 5
    store 19 in dirs at index 6
    store 21 in dirs at index 7
    store -11 in dirs at index 8
    store -10 in dirs at index 9
    store -9 in dirs at index 10
    store -1 in dirs at index 11
    store 1 in dirs at index 12
    store 9 in dirs at index 13
    store 10 in dirs at index 14
    store 11 in dirs at index 15
    store -10 in dirs at index 16
    store -1 in dirs at index 17
    store 1 in dirs at index 18
    store 10 in dirs at index 19
    store -11 in dirs at index 20
    store -9 in dirs at index 21
    store 9 in dirs at index 22
    store 11 in dirs at index 23

    store 46 in letters at index 0
    store 80 in letters at index 1
    store 78 in letters at index 2
    store 66 in letters at index 3
    store 82 in letters at index 4
    store 81 in letters at index 5
    store 75 in letters at index 6

    store 0 in piece_value at index 0
    store 100 in piece_value at index 1
    store 320 in piece_value at index 2
    store 330 in piece_value at index 3
    store 500 in piece_value at index 4
    store 900 in piece_value at index 5
    store 20000 in piece_value at index 6

    store 4 in back_rank at index 0
    store 2 in back_rank at index 1
    store 3 in back_rank at index 2
    store 5 in back_rank at index 3
    store 6 in back_rank at index 4
    store 3 in back_rank at index 5
    store 2 in back_rank at index 6
    store 4 in back_rank at index 7

    Let a number be called z
    set z to 12345
    for i from 0 to 1559:
        set z to (z * 48271) mod 2147483647
        set item i of zob to z

    store 0 in cen at index 0
    store 1 in cen at index 1
    store 2 in cen at index 2
    store 3 in cen at index 3
    store 3 in cen at index 4
    store 2 in cen at index 5
    store 1 in cen at index 6
    store 0 in cen at index 7
    store 0 in pass_bonus at index 0
    store 5 in pass_bonus at index 1
    store 10 in pass_bonus at index 2
    store 20 in pass_bonus at index 3
    store 35 in pass_bonus at index 4
    store 60 in pass_bonus at index 5
    store 90 in pass_bonus at index 6
    store 0 in pass_bonus at index 7

    (piece-square tables: one packed number per row, 8 squares of base 21 digits, value = (digit - 10) * 5)
    store 18911429680 in pst_pack at index 8
    store 20891404622 in pst_pack at index 9
    store 20618582996 in pst_pack at index 10
    store 18912244648 in pst_pack at index 11
    store 20807472158 in pst_pack at index 12
    store 22702699668 in pst_pack at index 13
    store 37822859360 in pst_pack at index 14
    store 18911429680 in pst_pack at index 15
    store 188685420 in pst_pack at index 16
    store 4159860518 in pst_pack at index 17
    store 8199444880 in pst_pack at index 18
    store 8117967022 in pst_pack at index 19
    store 8203733164 in pst_pack at index 20
    store 8113678738 in pst_pack at index 21
    store 4159656776 in pst_pack at index 22
    store 188685420 in pst_pack at index 23
    store 11526966660 in pst_pack at index 24
    store 15395018738 in pst_pack at index 25
    store 15489361448 in pst_pack at index 26
    store 15317829164 in pst_pack at index 27
    store 15399510764 in pst_pack at index 28
    store 15313744622 in pst_pack at index 29
    store 15309252596 in pst_pack at index 30
    store 11526966660 in pst_pack at index 31
    store 18911633422 in pst_pack at index 32
    store 17110341138 in pst_pack at index 33
    store 17110341138 in pst_pack at index 34
    store 17110341138 in pst_pack at index 35
    store 17110341138 in pst_pack at index 36
    store 17110341138 in pst_pack at index 37
    store 20892627074 in pst_pack at index 38
    store 18911429680 in pst_pack at index 39
    store 11527170402 in pst_pack at index 40
    store 15309253037 in pst_pack at index 41
    store 15313540901 in pst_pack at index 42
    store 17114629423 in pst_pack at index 43
    store 17114629422 in pst_pack at index 44
    store 15313540880 in pst_pack at index 45
    store 15309252596 in pst_pack at index 46
    store 11527170402 in pst_pack at index 47
    store 26638549784 in pst_pack at index 48
    store 26458848416 in pst_pack at index 49
    store 14949034892 in pst_pack at index 50
    store 11166341472 in pst_pack at index 51
    store 7384055536 in pst_pack at index 52
    store 7384055536 in pst_pack at index 53
    store 7384055536 in pst_pack at index 54
    store 7384055536 in pst_pack at index 55
    store 360217704 in pst_pack at index 56
    store 7590301576 in pst_pack at index 57
    store 7950926764 in pst_pack at index 58
    store 7959503332 in pst_pack at index 59
    store 7959503332 in pst_pack at index 60
    store 7950926764 in pst_pack at index 61
    store 7753664776 in pst_pack at index 62
    store 189092904 in pst_pack at index 63
    Let a number be called px
    Let a number be called pd
    for k from 1 to 7:
        for r from 0 to 7:
            set px to item ((k * 8) + r) of pst_pack
            for f from 0 to 7:
                set pd to px mod 21
                set px to floor of (px / 21)
                set item ((k * 64) + (r * 8) + f) of pst to (pd - 10) * 5

    (late move reductions grow like ln(depth) * ln(moves tried))
    for d from 1 to 31:
        for m from 1 to 63:
            set item ((d * 64) + m) of lmr to ((((ln_of(d) * ln_of(m)) / 1000000) * 4) / 9 + 750000) / 1000000

    store 28 in corner_sq at index 0
    store 21 in corner_sq at index 1
    store 98 in corner_sq at index 2
    store 91 in corner_sq at index 3

routine init_board:
    for i from 0 to 119:
        set item i of board to 99
    for r from 0 to 7:
        for f from 0 to 7:
            Let a number be called sq
            set sq to square(r, f)
            set item sq of board to 0
    for f from 0 to 7:
        set item (21 + f) of board to item f of back_rank
        set item (31 + f) of board to 1
        set item (81 + f) of board to -1
        set item (91 + f) of board to 0 - item f of back_rank
    run bb_sync
    for i from 0 to 3:
        set item i of castle to 1
    set ep_sq to 0

(=============================================================================)
(                              BOARD DISPLAY                                  )
(=============================================================================)

define print_piece with piece:
    Let a number be called kind
    Let a number be called code
    calculate the absolute value of piece and store the result in kind
    set code to item kind of letters
    if piece is less than 0:
        add 32 to code
    write " ", char code

routine print_board:
    print ""
    print "    a b c d e f g h"
    print "  +-----------------+"
    for r from 7 to 0 by -1:
        write char 49 + r, " |"
        for f from 0 to 7:
            Let a number be called sq
            set sq to square(r, f)
            call print_piece with item sq of board
        print " | ", char 49 + r
    print "  +-----------------+"
    print "    a b c d e f g h"
    print ""

(=============================================================================)
(                         CHECK & ATTACK DETECTION                            )
(=============================================================================)

(1 when the first piece met walking from sq along direction d is one of two types of side.)
define ray_hits with sq and d and side and kind1 and kind2:
    Let a number be called s
    Let a number be called pc
    set s to sq + d
    set pc to item s of board
    while pc is 0:
        add d to s
        set pc to item s of board
    if pc is kind1 * side or pc is kind2 * side:
        give back 1
    give back 0

(=============================================================================)
(                             MOVE GENERATION                                 )
(=============================================================================)

(Store a move in the buffer of its ply  - safely, never past 255 moves.)
define push_move with ply and src and dst:
    Let a number be called n
    Let a number be called slot
    set n to item ply of mv_count
    if n is less than 255:
        set slot to (ply - 1) * 256 + n
        set item slot of mv_from to src
        set item slot of mv_to to dst
        set item ply of mv_count to n + 1

(Castling for the king standing on its home square: all squares between must be)
(empty and the king may not start on, cross or land on an attacked square.)
define gen_castle with ply and side and home:
    Let a number be called foe
    Let a number be called right
    set foe to -1 * side
    set right to 0
    if side is -1:
        set right to 2
    if item right of castle is 1:
        if item (home + 1) of board is 0 and item (home + 2) of board is 0:
            if attacked(home, foe) is 0 and attacked(home + 1, foe) is 0 and attacked(home + 2, foe) is 0:
                call push_move with ply and home and home + 2
    if item (right + 1) of castle is 1:
        if item (home - 1) of board is 0 and item (home - 2) of board is 0 and item (home - 3) of board is 0:
            if attacked(home, foe) is 0 and attacked(home - 1, foe) is 0 and attacked(home - 2, foe) is 0:
                call push_move with ply and home and home - 2

(=============================================================================)
(                  BITBOARDS: attack tables and magic lookups                 )
(=============================================================================)

(Next to the mailbox board the engine keeps bitboards: one 64-bit number per kind of)
(piece with a bit for every square it stands on, and one per colour.  Bit 0 is a1,)
(bit 7 is h1, bit 56 is a8.  Sliding pieces look their attacks up with "magic" numbers:)
(the pieces in the way, multiplied by the magic number and shifted, give a table slot.)
(bbp[code + 6] holds the squares of the piece with that code, bbo[0] White, bbo[1] Black,)
(bbo[2] everything.  m2b and b2m convert between mailbox and bitboard squares.)

routine bb_sync:
    Let a number be called sq
    Let a number be called piece
    for i from 0 to 12:
        set item i of bbp to 0
    for i from 0 to 2:
        set item i of bbo to 0
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            set piece to item sq of board
            if piece is not 0:
                call bb_toggle with piece and sq

(Put the piece with this code on a square or take it off again (mailbox square).)
define bb_toggle with piece and msq:
    Let a number be called b
    Let a number be called col
    set b to item msq of m2b
    set col to 0
    if piece is less than 0:
        set col to 1
    bitwise xor item (piece + 6) of bbp with item b of sqbb
    bitwise xor item col of bbo with item b of sqbb
    bitwise xor item 2 of bbo with item b of sqbb
    give back 0

(Walk the rays from a square: the squares a slider reaches with this blocking pieces.)
define ray_attacks with sq and occ and rook:
    Let a number be called r0
    Let a number be called f0
    Let a number be called r
    Let a number be called f
    Let a number be called dr
    Let a number be called df
    Let a number be called att
    Let a number be called d
    Let a number be called going
    Let a number be called s
    Let a number be called t
    set r0 to sq / 8
    set f0 to sq mod 8
    for d from 0 to 3:
        if rook is 1:
            set dr to 0
            set df to 0
            if d is 0:
                set dr to 1
            if d is 1:
                set dr to -1
            if d is 2:
                set df to 1
            if d is 3:
                set df to -1
        else:
            set dr to 1
            set df to 1
            if d is at least 2:
                set dr to -1
            if d is 1 or d is 3:
                set df to -1
        set r to r0 + dr
        set f to f0 + df
        set going to 1
        while going is 1 and r is at least 0 and r is at most 7 and f is at least 0 and f is at most 7:
            set s to (r * 8) + f
            bitwise or att with item s of sqbb
            set t to occ
            shift t right by s bits
            bitwise and t with 1
            if t is 1:
                set going to 0
            add dr to r
            add df to f
    give back att

(The squares whose occupancy matters to a slider: its rays without the last square.)
define slider_mask with sq and rook:
    Let a number be called r0
    Let a number be called f0
    Let a number be called r
    Let a number be called f
    Let a number be called dr
    Let a number be called df
    Let a number be called m
    Let a number be called d
    Let a number be called s
    set r0 to sq / 8
    set f0 to sq mod 8
    for d from 0 to 3:
        if rook is 1:
            set dr to 0
            set df to 0
            if d is 0:
                set dr to 1
            if d is 1:
                set dr to -1
            if d is 2:
                set df to 1
            if d is 3:
                set df to -1
        else:
            set dr to 1
            set df to 1
            if d is at least 2:
                set dr to -1
            if d is 1 or d is 3:
                set df to -1
        set r to r0 + dr
        set f to f0 + df
        while r is at least 0 and r is at most 7 and f is at least 0 and f is at most 7 and (r + dr) is at least 0 and (r + dr) is at most 7 and (f + df) is at least 0 and (f + df) is at most 7:
            set s to (r * 8) + f
            bitwise or m with item s of sqbb
            add dr to r
            add df to f
    give back m

(Fill the attack table of one square for the given magic number.)
define fill_magic with sq and rook and off:
    Let a number be called mask
    Let a number be called bits
    Let a number be called occ
    Let a number be called x
    Let a number be called magic
    Let a number be called sh
    Let a number be called going
    Let a number be called att
    set mask to slider_mask(sq, rook)
    count the set bits of mask and store the result in bits
    set sh to 64 - bits
    if rook is 1:
        set magic to item sq of rmagic
        set item sq of rmask to mask
        set item sq of rshift to sh
        set item sq of roff to off
    else:
        set magic to item sq of bmagic
        set item sq of bmask to mask
        set item sq of bshift to sh
        set item sq of boff to off
    set occ to 0
    set going to 1
    while going is 1:
        set att to ray_attacks(sq, occ, rook)
        set x to occ * magic
        shift x right by sh bits
        if rook is 1:
            set item (off + x) of rtab to att
        else:
            set item (off + x) of btab to att
        set occ to occ - mask
        bitwise and occ with mask
        if occ is 0:
            set going to 0
    set x to 1
    shift x left by bits bits
    give back x

routine init_bitboards:
    Let a number be called b
    Let a number be called r
    Let a number be called f
    Let a number be called s
    Let a number be called t
    Let a number be called na
    Let a number be called off
    Let a number be called dr
    Let a number be called df
    Let a number be called k
    Let a number be called x
    Let a number be called acc
    Let a number be called line_bits
    Let a number be called s2
    set item 0 of rmagic to 36029347315843098
    set item 0 of bmagic to 4504703450874368
    set item 1 of rmagic to 144150926503051280
    set item 1 of bmagic to 220693976085200960
    set item 2 of rmagic to -8034386548708864000
    set item 2 of bmagic to 2308095376105711617
    set item 3 of rmagic to 1261025488320070016
    set item 3 of bmagic to 84513147450331136
    set item 4 of rmagic to 72062026444312832
    set item 4 of bmagic to 4629999759782855746
    set item 5 of rmagic to -8827048671435554432
    set item 5 of bmagic to 1155331702949937152
    set item 6 of rmagic to 1188951401170993280
    set item 6 of bmagic to 4680140099420304
    set item 7 of rmagic to 108104674732687488
    set item 7 of bmagic to 1834264837509632
    set item 8 of rmagic to 7080503178743005440
    set item 8 of bmagic to 2306133314912913474
    set item 9 of rmagic to 2323998420097835008
    set item 9 of bmagic to 6924732989702410
    set item 10 of rmagic to 18437023299801088
    set item 10 of bmagic to 72111474840043520
    set item 11 of rmagic to 1747959674231193634
    set item 11 of bmagic to 4415436100096
    set item 12 of rmagic to -9223231265006419839
    set item 12 of bmagic to 42797545755246625
    set item 13 of rmagic to -9222668272095196160
    set item 13 of bmagic to -9194940280530665471
    set item 14 of rmagic to 95701526508613633
    set item 14 of bmagic to -6196951953355766784
    set item 15 of rmagic to -9061101711698951936
    set item 15 of bmagic to 577026064656769024
    set item 16 of rmagic to 2305878743345791104
    set item 16 of bmagic to 1337041309680144
    set item 17 of rmagic to 36170084800020481
    set item 17 of bmagic to 4612849371791377472
    set item 18 of rmagic to 1229482835845578784
    set item 18 of bmagic to 4503634129790984
    set item 19 of rmagic to -9151031868193243103
    set item 19 of bmagic to 4994632896074498113
    set item 20 of rmagic to 1155174404016048144
    set item 20 of bmagic to 12525653654011904
    set item 21 of rmagic to 2534374336103424
    set item 21 of bmagic to 140738567356416
    set item 22 of rmagic to 301742278840680960
    set item 22 of bmagic to 144701366303983617
    set item 23 of rmagic to 6345574073996943425
    set item 23 of bmagic to 2317172488731141152
    set item 24 of rmagic to 756745623062986760
    set item 24 of bmagic to 2322345863874560
    set item 25 of rmagic to -8930567621462458239
    set item 25 of bmagic to 72343501966410832
    set item 26 of rmagic to 12420087646785792
    set item 26 of bmagic to 73506819150185472
    set item 27 of rmagic to 1442841014087192608
    set item 27 of bmagic to 9015995364556808
    set item 28 of rmagic to 72620569761718288
    set item 28 of bmagic to 621778292290109441
    set item 29 of rmagic to 1300415492988731456
    set item 29 of bmagic to 3028680679538852352
    set item 30 of rmagic to 4630905498869239842
    set item 30 of bmagic to 2402707784635386372
    set item 31 of rmagic to 1225036281839650625
    set item 31 of bmagic to 4760872772608196864
    set item 32 of rmagic to 4611756389327437856
    set item 32 of bmagic to 65337414940498504
    set item 33 of rmagic to 297255168133578752
    set item 33 of bmagic to 11290404407345664
    set item 34 of rmagic to 292742772411073536
    set item 34 of bmagic to 2382426201710135312
    set item 35 of rmagic to 1814950684198441088
    set item 35 of bmagic to -2305838593982594544
    set item 36 of rmagic to 2819149969491970
    set item 36 of bmagic to -6844062942027972064
    set item 37 of rmagic to 21392106828334208
    set item 37 of bmagic to 18297114731872322
    set item 38 of rmagic to 144398896502673409
    set item 38 of bmagic to -8354172908578209648
    set item 39 of rmagic to 5188428281157779618
    set item 39 of bmagic to 4807084164317250
    set item 40 of rmagic to 576601628304506880
    set item 40 of bmagic to 72347900541666560
    set item 41 of rmagic to 13511074296905728
    set item 41 of bmagic to 292876946683994240
    set item 42 of rmagic to 35188805533712
    set item 42 of bmagic to 4684456267933058048
    set item 43 of rmagic to 145260884596490248
    set item 43 of bmagic to 288235057800282240
    set item 44 of rmagic to 6755416621482112
    set item 44 of bmagic to 3710968300734252036
    set item 45 of rmagic to 2316539659893735464
    set item 45 of bmagic to 9042400849174593
    set item 46 of rmagic to 4629982072302796804
    set item 46 of bmagic to 9308474035966464
    set item 47 of rmagic to 2314850485561065505
    set item 47 of bmagic to 77126351301476876
    set item 48 of rmagic to 2413929537713733696
    set item 48 of bmagic to 1172064106275209216
    set item 49 of rmagic to 5188710822345458176
    set item 49 of bmagic to 5357954557673481
    set item 50 of rmagic to 4611767382564676096
    set item 50 of bmagic to 721711187343458304
    set item 51 of rmagic to -8286324247047953152
    set item 51 of bmagic to 576461029396203520
    set item 52 of rmagic to 4614236906887577856
    set item 52 of bmagic to 4809844419295708228
    set item 53 of rmagic to 7494130534612861056
    set item 53 of bmagic to 2462927655305216
    set item 54 of rmagic to 18155140292935808
    set item 54 of bmagic to 19427494423822336
    set item 55 of rmagic to 277092565504
    set item 55 of bmagic to 6360234964465879040
    set item 56 of rmagic to -9222175662977048319
    set item 56 of bmagic to 616149824873710592
    set item 57 of rmagic to 19793360988418
    set item 57 of bmagic to 72057733658452228
    set item 58 of rmagic to 1154206833852809281
    set item 58 of bmagic to 1810728527331854340
    set item 59 of rmagic to 797418643450236929
    set item 59 of bmagic to 1699983493826564
    set item 60 of rmagic to 7318418248441858
    set item 60 of bmagic to -6916262115299802109
    set item 61 of rmagic to 562984581661826
    set item 61 of bmagic to 1234145248239681792
    set item 62 of rmagic to 5066567163871554
    set item 62 of bmagic to 793215244805079168
    set item 63 of rmagic to 5910979376465033
    set item 63 of bmagic to 289672969800917056
    set b to 1
    for s from 0 to 63:
        set item s of sqbb to b
        shift b left by 1 bits
    for r from 0 to 7:
        for f from 0 to 7:
            set item ((r * 8) + f) of b2m to ((r + 2) * 10) + f + 1
            set item (((r + 2) * 10) + f + 1) of m2b to (r * 8) + f
    for s from 0 to 63:
        set r to s / 8
        set f to s mod 8
        for k from 0 to 7:
            set dr to 0
            set df to 0
            if k is 0:
                set dr to 2
                set df to 1
            if k is 1:
                set dr to 2
                set df to -1
            if k is 2:
                set dr to -2
                set df to 1
            if k is 3:
                set dr to -2
                set df to -1
            if k is 4:
                set dr to 1
                set df to 2
            if k is 5:
                set dr to 1
                set df to -2
            if k is 6:
                set dr to -1
                set df to 2
            if k is 7:
                set dr to -1
                set df to -2
            if (r + dr) is at least 0 and (r + dr) is at most 7 and (f + df) is at least 0 and (f + df) is at most 7:
                set t to ((r + dr) * 8) + f + df
                bitwise or item s of knight_att with item t of sqbb
        for k from 0 to 7:
            set dr to 0
            set df to 0
            if k is 0:
                set dr to 1
            if k is 1:
                set dr to -1
            if k is 2:
                set df to 1
            if k is 3:
                set df to -1
            if k is 4:
                set dr to 1
                set df to 1
            if k is 5:
                set dr to 1
                set df to -1
            if k is 6:
                set dr to -1
                set df to 1
            if k is 7:
                set dr to -1
                set df to -1
            if (r + dr) is at least 0 and (r + dr) is at most 7 and (f + df) is at least 0 and (f + df) is at most 7:
                set t to ((r + dr) * 8) + f + df
                bitwise or item s of king_att with item t of sqbb
        if r is less than 7:
            if f is greater than 0:
                bitwise or item s of pawn_att with item (s + 7) of sqbb
            if f is less than 7:
                bitwise or item s of pawn_att with item (s + 9) of sqbb
        if r is greater than 0:
            if f is greater than 0:
                bitwise or item (64 + s) of pawn_att with item (s - 9) of sqbb
            if f is less than 7:
                bitwise or item (64 + s) of pawn_att with item (s - 7) of sqbb
    set off to 0
    for s from 0 to 63:
        set na to fill_magic(s, 1, off)
        add na to off
    set off to 0
    for s from 0 to 63:
        set na to fill_magic(s, 0, off)
        add na to off
    (between and line tables for pins and check evasions)
    for s from 0 to 63:
        set r to s / 8
        set f to s mod 8
        for k from 0 to 7:
            set dr to 0
            set df to 0
            if k is 0:
                set dr to 1
            if k is 1:
                set dr to -1
            if k is 2:
                set df to 1
            if k is 3:
                set df to -1
            if k is 4:
                set dr to 1
                set df to 1
            if k is 5:
                set dr to 1
                set df to -1
            if k is 6:
                set dr to -1
                set df to 1
            if k is 7:
                set dr to -1
                set df to -1
            set acc to 0
            set line_bits to item s of sqbb
            set x to 1
            while (r + (x * dr)) is at least 0 and (r + (x * dr)) is at most 7 and (f + (x * df)) is at least 0 and (f + (x * df)) is at most 7:
                set t to ((r + (x * dr)) * 8) + f + (x * df)
                bitwise or line_bits with item t of sqbb
                add 1 to x
            set x to 1
            while (r - (x * dr)) is at least 0 and (r - (x * dr)) is at most 7 and (f - (x * df)) is at least 0 and (f - (x * df)) is at most 7:
                set t to ((r - (x * dr)) * 8) + f - (x * df)
                bitwise or line_bits with item t of sqbb
                add 1 to x
            set x to 1
            while (r + (x * dr)) is at least 0 and (r + (x * dr)) is at most 7 and (f + (x * df)) is at least 0 and (f + (x * df)) is at most 7:
                set t to ((r + (x * dr)) * 8) + f + (x * df)
                set item ((s * 64) + t) of between to acc
                set item ((s * 64) + t) of line to line_bits
                bitwise or acc with item t of sqbb
                add 1 to x


(PEXT tables: for every square and every pattern of blockers on its mask, the attacks, indexed by the)
(blockers packed with PEXT.  Filled from the magic tables, so both always agree.)
routine build_pext:
    Let a number be called sq
    Let a number be called bits
    Let a number be called n
    Let a number be called j
    Let a number be called occ
    Let a number be called x
    for sq from 0 to 63:
        set bits to 64 - (item sq of rshift)
        set n to 1
        shift n left by bits bits
        set j to 0
        while j is less than n:
            set occ to j
            deposit the bits of occ using mask (item sq of rmask)
            set x to occ
            bitwise and x with item sq of rmask
            set x to x * (item sq of rmagic)
            shift x right by (item sq of rshift) bits
            set item ((item sq of roff) + j) of prtab to item ((item sq of roff) + x) of rtab
            add 1 to j
        set bits to 64 - (item sq of bshift)
        set n to 1
        shift n left by bits bits
        set j to 0
        while j is less than n:
            set occ to j
            deposit the bits of occ using mask (item sq of bmask)
            set x to occ
            bitwise and x with item sq of bmask
            set x to x * (item sq of bmagic)
            shift x right by (item sq of bshift) bits
            set item ((item sq of boff) + j) of pbtab to item ((item sq of boff) + x) of btab
            add 1 to j
    set pext_ready to 1

define rook_att with sq and occ:
    Let a number be called x
    set x to occ
    if use_pext is 1:
        extract the bits of x using mask (item sq of rmask)
        give back item ((item sq of roff) + x) of prtab
    bitwise and x with item sq of rmask
    set x to x * (item sq of rmagic)
    shift x right by (item sq of rshift) bits
    give back item ((item sq of roff) + x) of rtab

define bish_att with sq and occ:
    Let a number be called x
    set x to occ
    if use_pext is 1:
        extract the bits of x using mask (item sq of bmask)
        give back item ((item sq of boff) + x) of pbtab
    bitwise and x with item sq of bmask
    set x to x * (item sq of bmagic)
    shift x right by (item sq of bshift) bits
    give back item ((item sq of boff) + x) of btab

(Is bitboard square b attacked by a piece of colour ac (0 White, 1 Black), pretending)
(that the pieces are on occ and that the pieces in excl are not there?)
define attacked_occ with b and ac and occ and excl:
    Let a number be called x
    Let a number be called y
    Let a number be called sg
    set sg to 1
    if ac is 1:
        set sg to -1
    set x to item (((1 - ac) * 64) + b) of pawn_att
    bitwise and x with item (6 + sg) of bbp
    bitwise and not x with excl
    if x is not 0:
        give back 1
    set x to item b of knight_att
    bitwise and x with item (6 + (2 * sg)) of bbp
    bitwise and not x with excl
    if x is not 0:
        give back 1
    set x to item b of king_att
    bitwise and x with item (6 + (6 * sg)) of bbp
    bitwise and not x with excl
    if x is not 0:
        give back 1
    set y to item (6 + (5 * sg)) of bbp
    set x to item (6 + (3 * sg)) of bbp
    bitwise or x with y
    bitwise and not x with excl
    if x is not 0:
        bitwise and x with bish_att(b, occ)
        if x is not 0:
            give back 1
    set x to item (6 + (4 * sg)) of bbp
    bitwise or x with y
    bitwise and not x with excl
    if x is not 0:
        bitwise and x with rook_att(b, occ)
        if x is not 0:
            give back 1
    give back 0

(1 when a piece of side attacks the mailbox square sq.)
define attacked with sq and side:
    Let a number be called ac
    set ac to 0
    if side is -1:
        set ac to 1
    give back attacked_occ(item sq of m2b, ac, item 2 of bbo, 0)

(The mailbox square of side's king, or 0 when it is not on the board.)
define find_king with side:
    Let a number be called kb
    Let a number be called ks
    set kb to item (6 + (6 * side)) of bbp
    if kb is 0:
        give back 0
    count the trailing zeros of kb and store the result in ks
    give back item ks of b2m

(1 when side is in check.  A king that is not on the board was captured during the)
(search: that side is lost, so it counts as in check.)
define in_check with side:
    Let a number be called kb
    Let a number be called ks
    Let a number be called ac
    set kb to item (6 + (6 * side)) of bbp
    if kb is 0:
        give back 1
    count the trailing zeros of kb and store the result in ks
    set ac to 1
    if side is -1:
        set ac to 0
    give back attacked_occ(ks, ac, item 2 of bbo, 0)

(Push the moves of one piece: src is a bitboard square, att the bitboard of targets.)
define push_targets with ply and src and att:
    Let a number be called dst
    Let a number be called ms
    set ms to item src of b2m
    while att is not 0:
        count the trailing zeros of att and store the result in dst
        clear the lowest bit of att
        call push_move with ply and ms and (item dst of b2m)
    give back 0

(All legal moves of side.  A move is legal when it does not leave the king in check:)
(for ordinary pieces that means it is not pinned (or stays on its pin line) and, when)
(in check, blocks or captures the single checker; the king moves only to safe squares.)
define generate with ply and side:
    Let a number be called col
    Let a number be called own
    Let a number be called opp
    Let a number be called occ
    Let a number be called kb
    Let a number be called ks
    Let a number be called es
    Let a number be called eP
    Let a number be called eN
    Let a number be called eBQ
    Let a number be called eRQ
    Let a number be called checkers
    Let a number be called nchk
    Let a number be called cs
    Let a number be called emask
    Let a number be called tmask
    Let a number be called pinned
    Let a number be called sn
    Let a number be called blk
    Let a number be called t
    Let a number be called x
    Let a number be called ex
    Let a number be called att
    Let a number be called src
    Let a number be called dst
    Let a number be called am
    Let a number be called fwd
    Let a number be called two
    Let a number be called epb
    Let a number be called victim
    Let a number be called occ2
    Let a number be called ec
    set item ply of mv_count to 0
    set col to 0
    if side is -1:
        set col to 1
    set own to item col of bbo
    set opp to item (1 - col) of bbo
    set occ to item 2 of bbo
    set kb to item (6 + (6 * side)) of bbp
    if kb is 0:
        give back 0
    count the trailing zeros of kb and store the result in ks
    set es to 0 - side
    set ec to 1 - col
    set eP to item (6 + es) of bbp
    set eN to item (6 + (2 * es)) of bbp
    set eBQ to item (6 + (3 * es)) of bbp
    bitwise or eBQ with item (6 + (5 * es)) of bbp
    set eRQ to item (6 + (4 * es)) of bbp
    bitwise or eRQ with item (6 + (5 * es)) of bbp
    (who gives check)
    set checkers to item ((col * 64) + ks) of pawn_att
    bitwise and checkers with eP
    set x to item ks of knight_att
    bitwise and x with eN
    bitwise or checkers with x
    set x to bish_att(ks, occ)
    bitwise and x with eBQ
    bitwise or checkers with x
    set x to rook_att(ks, occ)
    bitwise and x with eRQ
    bitwise or checkers with x
    count the set bits of checkers and store the result in nchk
    set emask to -1
    if nchk is 1:
        count the trailing zeros of checkers and store the result in cs
        set emask to item ((ks * 64) + cs) of between
        bitwise or emask with item cs of sqbb
    if nchk is at least 2:
        set emask to 0
    (pieces that may only move along the line to the king)
    set sn to rook_att(ks, 0)
    bitwise and sn with eRQ
    set x to bish_att(ks, 0)
    bitwise and x with eBQ
    bitwise or sn with x
    while sn is not 0:
        count the trailing zeros of sn and store the result in t
        clear the lowest bit of sn
        set blk to item ((ks * 64) + t) of between
        bitwise and blk with occ
        if blk is not 0:
            set x to blk
            clear the lowest bit of x
            if x is 0:
                bitwise and blk with own
                bitwise or pinned with blk
    set tmask to own
    bitwise not tmask
    if qmode is 1:
        set tmask to opp
    (pawns)
    set x to item (6 + side) of bbp
    while x is not 0:
        count the trailing zeros of x and store the result in src
        clear the lowest bit of x
        set am to emask
        set t to pinned
        bitwise and t with item src of sqbb
        if t is not 0:
            bitwise and am with item ((ks * 64) + src) of line
        set fwd to src + (8 * side)
        if qmode is 0:
            set t to occ
            shift t right by fwd bits
            bitwise and t with 1
            if t is 0:
                set t to am
                shift t right by fwd bits
                bitwise and t with 1
                if t is 1:
                    call push_move with ply and (item src of b2m) and (item fwd of b2m)
                set two to src + (16 * side)
                if (side is 1 and src is less than 16) or (side is -1 and src is at least 48):
                    set t to occ
                    shift t right by two bits
                    bitwise and t with 1
                    if t is 0:
                        set t to am
                        shift t right by two bits
                        bitwise and t with 1
                        if t is 1:
                            call push_move with ply and (item src of b2m) and (item two of b2m)
        set att to item ((col * 64) + src) of pawn_att
        set epb to att
        bitwise and att with opp
        bitwise and att with am
        call push_targets with ply and src and att
        if ep_sq is not 0 and ep_sq * side is greater than 50 * side:
            set dst to item ep_sq of m2b
            set t to epb
            shift t right by dst bits
            bitwise and t with 1
            if t is 1:
                set victim to dst - (8 * side)
                set occ2 to occ
                bitwise xor occ2 with item src of sqbb
                bitwise xor occ2 with item victim of sqbb
                bitwise or occ2 with item dst of sqbb
                set ex to bish_att(ks, occ2)
                bitwise and ex with eBQ
                set t to rook_att(ks, occ2)
                bitwise and t with eRQ
                bitwise or ex with t
                set t to item ks of knight_att
                bitwise and t with eN
                bitwise or ex with t
                set t to item ((col * 64) + ks) of pawn_att
                bitwise and t with eP
                bitwise and not t with item victim of sqbb
                bitwise or ex with t
                if ex is 0:
                    call push_move with ply and (item src of b2m) and ep_sq
    (knights, bishops, rooks, queens)
    for kind from 2 to 5:
        set x to item (6 + (kind * side)) of bbp
        while x is not 0:
            count the trailing zeros of x and store the result in src
            clear the lowest bit of x
            if kind is 2:
                set att to item src of knight_att
            else if kind is 3:
                set att to bish_att(src, occ)
            else if kind is 4:
                set att to rook_att(src, occ)
            else:
                set att to bish_att(src, occ)
                bitwise or att with rook_att(src, occ)
            bitwise and att with tmask
            bitwise and att with emask
            set t to pinned
            bitwise and t with item src of sqbb
            if t is not 0:
                bitwise and att with item ((ks * 64) + src) of line
            call push_targets with ply and src and att
    (the king: only to squares nobody attacks, once the king itself is out of the way)
    set att to item ks of king_att
    bitwise and att with tmask
    set occ2 to occ
    bitwise xor occ2 with item ks of sqbb
    while att is not 0:
        count the trailing zeros of att and store the result in dst
        clear the lowest bit of att
        if attacked_occ(dst, ec, occ2, item dst of sqbb) is 0:
            call push_move with ply and (item ks of b2m) and (item dst of b2m)
    if nchk is 0 and qmode is 0:
        if item ks of b2m is 60 - (35 * side):
            call gen_castle with ply and side and (item ks of b2m)
    give back 0

(=============================================================================)
(                MOVE ORDERING: TT MOVE, MVV-LVA, KILLERS, HISTORY            )
(=============================================================================)


(History tables with gravity: a bonus pulls the value up, but the nearer it is to the limit 3000 the less it moves)
define upd_hist with idx and bon:
    Let a number be called old
    Let a number be called ab
    set old to item idx of history
    calculate the absolute value of bon and store the result in ab
    set item idx of history to (old + bon) - floor of ((old * ab) / 3000)
    give back 0

define upd_ch1 with idx and bon:
    Let a number be called old
    Let a number be called ab
    set old to item idx of ch1
    calculate the absolute value of bon and store the result in ab
    set item idx of ch1 to (old + bon) - floor of ((old * ab) / 3000)
    give back 0

define upd_ch2 with idx and bon:
    Let a number be called old
    Let a number be called ab
    set old to item idx of ch2
    calculate the absolute value of bon and store the result in ab
    set item idx of ch2 to (old + bon) - floor of ((old * ab) / 3000)
    give back 0

define upd_cap with idx and bon:
    Let a number be called old
    Let a number be called ab
    set old to item idx of caph
    calculate the absolute value of bon and store the result in ab
    set item idx of caph to (old + bon) - floor of ((old * ab) / 3000)
    give back 0

(A quiet move caused a cutoff: reward it in all three tables, punish the quiet moves tried before it.)
define hist_cutoff with ply and depth and src and dst and moving and nq:
    Let a number be called bon
    Let a number be called c1
    Let a number be called c2
    Let a number be called cur
    Let a number be called k
    Let a number be called s2
    Let a number be called d2
    Let a number be called p2
    set bon to depth * depth * 3
    if bon is greater than 700:
        set bon to 700
    set c1 to item ply of ctx_at
    set c2 to 0
    if ply is at least 2:
        set c2 to item (ply - 1) of ctx_at
    call upd_hist with ((src * 120) + dst) and bon
    set cur to ((moving + 6) * 64) + (item dst of m2b) + 1
    if c1 is not 0:
        call upd_ch1 with ((c1 * 833) + cur) and bon
    if c2 is not 0:
        call upd_ch2 with ((c2 * 833) + cur) and bon
    set k to 0
    while k is less than nq:
        set s2 to item ((ply * 64) + k) of q_src
        set d2 to item ((ply * 64) + k) of q_dst
        set p2 to item s2 of board
        call upd_hist with ((s2 * 120) + d2) and (0 - bon)
        set cur to ((p2 + 6) * 64) + (item d2 of m2b) + 1
        if c1 is not 0:
            call upd_ch1 with ((c1 * 833) + cur) and (0 - bon)
        if c2 is not 0:
            call upd_ch2 with ((c2 * 833) + cur) and (0 - bon)
        add 1 to k
    give back 0

(A capture caused a cutoff: reward it, punish the captures tried before it.)
define cap_cutoff with ply and depth and moving and dst and took and nc:
    Let a number be called bon
    Let a number be called k
    Let a number be called s2
    Let a number be called d2
    Let a number be called p2
    Let a number be called v2
    set bon to depth * depth * 3
    if bon is greater than 700:
        set bon to 700
    calculate the absolute value of took and store the result in v2
    call upd_cap with ((((moving + 6) * 448) + (v2 * 64)) + (item dst of m2b)) and bon
    set k to 0
    while k is less than nc:
        set s2 to item ((ply * 64) + k) of c_src
        set d2 to item ((ply * 64) + k) of c_dst
        set p2 to item s2 of board
        set v2 to item d2 of board
        calculate the absolute value of v2 and store the result in v2
        call upd_cap with ((((p2 + 6) * 448) + (v2 * 64)) + (item d2 of m2b)) and (0 - bon)
        add 1 to k
    give back 0


(Could this move exist in the position?  Pieces, geometry and the target square are checked;)
(whether it leaves the king in check is found out when the move is made.)
define move_ok with src and dst and side:
    Let a number be called piece
    Let a number be called target
    Let a number be called kind
    Let a number be called diff
    Let a number be called fwd
    Let a number be called bs
    Let a number be called bd
    Let a number be called x
    Let a number be called occ
    set piece to item src of board
    if piece is 0 or piece is 99:
        give back 0
    if piece * side is less than 1:
        give back 0
    set target to item dst of board
    if target is 99:
        give back 0
    if target * side is greater than 0:
        give back 0
    calculate the absolute value of target and store the result in x
    if x is 6:
        give back 0
    calculate the absolute value of piece and store the result in kind
    set diff to dst - src
    if kind is 1:
        set fwd to 10 * side
        if diff is fwd:
            if target is 0:
                give back 1
            give back 0
        if diff is 2 * fwd:
            if target is 0 and item (src + fwd) of board is 0:
                if side is 1 and src is at least 31 and src is at most 38:
                    give back 1
                if side is -1 and src is at least 81 and src is at most 88:
                    give back 1
            give back 0
        if diff is fwd + 1 or diff is fwd - 1:
            if target * side is less than 0:
                give back 1
            if target is 0 and dst is ep_sq:
                give back 1
        give back 0
    set bs to item src of m2b
    set bd to item dst of m2b
    set occ to item 2 of bbo
    if kind is 2:
        set x to item bs of knight_att
    else if kind is 3:
        set x to bish_att(bs, occ)
    else if kind is 4:
        set x to rook_att(bs, occ)
    else if kind is 5:
        set x to bish_att(bs, occ)
        bitwise or x with rook_att(bs, occ)
    else:
        set x to item bs of king_att
    logical shift x right by bd bits
    bitwise and x with 1
    give back x

define is_tried with ply and mid and nt:
    Let a number be called k
    set k to 0
    while k is less than nt:
        if item ((ply * 80) + k) of tried is mid:
            give back 1
        add 1 to k
    give back 0

(Order of trying: the move the transposition table remembers, good captures)
(by MVV-LVA  - Most Valuable Victim, Least Valuable Attacker, killer moves,)
(then quiet moves by history and centre control.  Captures a cheaper piece)
(could take back  - SEE-lite are demoted below the quiet moves.)
define score_moves with ply and side and tt_best:
    Let a number be called count
    Let a number be called base
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called victim
    Let a number be called attacker
    Let a number be called value
    Let a number be called packed
    Let a number be called hist
    Let a number be called nh
    Let a number be called c1
    Let a number be called c2
    Let a number be called cur
    Let a number be called kv1
    Let a number be called kv2
    set nh to feature(8192)
    set c1 to item ply of ctx_at
    set c2 to 0
    if ply is at least 2:
        set c2 to item (ply - 1) of ctx_at
    set kv1 to 9000
    set kv2 to 8500
    if nh is 1:
        set kv1 to 9500
        set kv2 to 9200
    set count to item ply of mv_count
    set base to (ply - 1) * 256
    for i from 0 to count - 1:
        set slot to base + i
        set src to item slot of mv_from
        set dst to item slot of mv_to
        set packed to (src * 128) + dst
        set victim to item dst of board
        calculate the absolute value of victim and store the result in victim
        set attacker to item src of board
        calculate the absolute value of attacker and store the result in attacker
        set value to 0
        if packed is tt_best:
            set value to 1000000
        else if victim is greater than 0 and victim is not 99:
            set value to 10000 + (victim * 100) - attacker
            if nh is 1:
                add floor of ((item ((((item src of board) + 6) * 448) + (victim * 64) + (item dst of m2b)) of caph) / 32) to value
            if attacker is greater than victim:
                if attacked(dst, -1 * side) is 1:
                    subtract 5000 from value
        else if attacker is 1 and dst is ep_sq:
            set value to 10099
        else if attacker is 1 and (dst is at least 91 or dst is at most 28) and feature(16384) is 1:
            set value to 9800
        else if packed is item ply of killer1:
            set value to kv1
        else if packed is item ply of killer2:
            set value to kv2
        else if feature(16) is 1 and packed is item (item ply of prev_move) of counter and item ply of prev_move is not 0:
            set value to 8000
        else:
            set hist to (src * 120) + dst
            set value to item hist of history
            if nh is 1:
                set cur to (((item src of board) + 6) * 64) + (item dst of m2b) + 1
                if c1 is not 0:
                    add item ((c1 * 833) + cur) of ch1 to value
                if c2 is not 0:
                    add item ((c2 * 833) + cur) of ch2 to value
            if dst is 54 or dst is 55 or dst is 64 or dst is 65:
                add 50 to value
            else if dst is 43 or dst is 46 or dst is 73 or dst is 76:
                add 20 to value
        set item slot of mv_score to value

define pick_best with ply and i and total:
    Let a number be called base
    Let a number be called slot
    Let a number be called best
    Let a number be called top
    Let a number be called other
    Let a number be called f1
    Let a number be called t1
    Let a number be called s1
    set base to (ply - 1) * 256
    set best to i
    set slot to base + i
    set top to item slot of mv_score
    for j from i + 1 to total - 1:
        set other to base + j
        if item other of mv_score is greater than top:
            set top to item other of mv_score
            set best to j
    if best is not i:
        set other to base + best
        set f1 to item slot of mv_from
        set t1 to item slot of mv_to
        set s1 to item slot of mv_score
        set item slot of mv_from to item other of mv_from
        set item slot of mv_to to item other of mv_to
        set item slot of mv_score to item other of mv_score
        set item other of mv_from to f1
        set item other of mv_to to t1
        set item other of mv_score to s1

(=============================================================================)
(                           STATIC EVALUATION                                 )
(=============================================================================)

(The v3.0 evaluation: material, pawn advancement and knight centralisation, from White's point of view.)
define evaluate_basic:
    Let a number be called total
    Let a number be called sq
    Let a number be called piece
    Let a number be called sign
    Let a number be called kind
    Let a number be called value
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            set piece to item sq of board
            if piece is not 0:
                set sign to 1
                if piece is less than 0:
                    set sign to -1
                calculate the absolute value of piece and store the result in kind
                set value to item kind of piece_value
                if kind is 1:
                    if sign is 1:
                        add r * 8 to value
                    else:
                        add (7 - r) * 8 to value
                if kind is 2 and r is at least 2 and r is at most 5:
                    if f is at least 2 and f is at most 5:
                        add 25 to value
                add value * sign to total
    give back total


(The v3.1 evaluation, from White's point of view.  Besides material it knows:)
(  pawns: advancement, the centre, doubled, isolated and passed pawns)
(  knights and bishops: centralisation, and the bishop pair)
(  rooks: open and half-open files, the seventh rank)
(  kings: a pawn shield and staying home in the middlegame, walking to the)
(  centre in the endgame; and that bare minor pieces cannot win (a draw).)
define evaluate_full:
    Let a number be called total
    Let a number be called sq
    Let a number be called piece
    Let a number be called sign
    Let a number be called kind
    Let a number be called value
    Let a number be called rel
    Let a number be called own
    Let a number be called foe
    Let a number be called ok
    Let a number be called w_npm
    Let a number be called b_npm
    Let a number be called pawns
    Let a number be called w_bishops
    Let a number be called b_bishops
    Let a number be called w_king
    Let a number be called b_king
    Let a number be called endgame
    Let a number be called r2
    Let a number be called ff
    Let a number be called shield
    Let a number be called use_pst
    set use_pst to feature(64)
    for i from 0 to 9:
        set item i of wcount to 0
        set item i of bcount to 0
        set item i of wmin to 9
        set item i of bmax to -1
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            set piece to item sq of board
            if piece is 1:
                add 1 to item (f + 1) of wcount
                if r is less than item (f + 1) of wmin:
                    set item (f + 1) of wmin to r
            if piece is -1:
                add 1 to item (f + 1) of bcount
                if r is greater than item (f + 1) of bmax:
                    set item (f + 1) of bmax to r
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            set piece to item sq of board
            if piece is not 0:
                set sign to 1
                set rel to r
                if piece is less than 0:
                    set sign to -1
                    set rel to 7 - r
                calculate the absolute value of piece and store the result in kind
                set value to item kind of piece_value
                if kind is 1:
                    add 1 to pawns
                    if use_pst is 1:
                        add item (64 + (rel * 8) + f) of pst to value
                    else:
                        add rel * 6 to value
                        if f is 3 or f is 4:
                            add 6 to value
                    set own to item (f + 1) of wcount
                    set foe to item (f + 1) of bcount
                    if sign is -1:
                        set own to item (f + 1) of bcount
                        set foe to item (f + 1) of wcount
                    if own is greater than 1:
                        subtract 8 from value
                    if item f of wcount + item (f + 2) of wcount is 0 and sign is 1:
                        subtract 10 from value
                    if item f of bcount + item (f + 2) of bcount is 0 and sign is -1:
                        subtract 10 from value
                    set ok to 0
                    if sign is 1:
                        if item f of bmax is at most r and item (f + 1) of bmax is at most r and item (f + 2) of bmax is at most r:
                            set ok to 1
                    else:
                        if item f of wmin is at least r and item (f + 1) of wmin is at least r and item (f + 2) of wmin is at least r:
                            set ok to 1
                    if ok is 1:
                        add item rel of pass_bonus to value
                else if kind is 2:
                    set value to 305 + (5 * (item r of cen + item f of cen))
                    if use_pst is 1:
                        set value to 305 + item (128 + (rel * 8) + f) of pst
                    if sign is 1:
                        add 320 - 305 to w_npm
                    else:
                        add 320 - 305 to b_npm
                else if kind is 3:
                    set value to 325 + (3 * (item r of cen + item f of cen))
                    if use_pst is 1:
                        set value to 325 + item (192 + (rel * 8) + f) of pst
                    if sign is 1:
                        add 1 to w_bishops
                    else:
                        add 1 to b_bishops
                else if kind is 4:
                    set own to item (f + 1) of wcount
                    set foe to item (f + 1) of bcount
                    if sign is -1:
                        set own to item (f + 1) of bcount
                        set foe to item (f + 1) of wcount
                    if own is 0 and foe is 0:
                        add 20 to value
                    else if own is 0:
                        add 10 to value
                    if rel is 6:
                        add 15 to value
                    if use_pst is 1:
                        add item (256 + (rel * 8) + f) of pst to value
                else if kind is 5:
                    if use_pst is 1:
                        add item (320 + (rel * 8) + f) of pst to value
                else if kind is 6:
                    set value to 0
                    if sign is 1:
                        set w_king to sq
                    else:
                        set b_king to sq
                if kind is at least 2 and kind is at most 5:
                    if sign is 1:
                        add item kind of piece_value to w_npm
                    else:
                        add item kind of piece_value to b_npm
                add value * sign to total
    (neither side can win with so little: a draw)
    if pawns is 0 and w_npm is at most 330 + 15 and b_npm is at most 330 + 15:
        give back 0
    if w_bishops is at least 2:
        add 30 to total
    if b_bishops is at least 2:
        subtract 30 from total
    set endgame to 0
    if w_npm + b_npm is at most 3000:
        set endgame to 1
    (kings, one after the other: White first, then Black)
    for k from 1 to 2:
        set sq to w_king
        set sign to 1
        if k is 2:
            set sq to b_king
            set sign to -1
        set r2 to sq / 10
        set ff to sq - (r2 * 10) - 1
        set r2 to r2 - 2
        set rel to r2
        if sign is -1:
            set rel to 7 - r2
        if use_pst is 1 and endgame is 1:
            add (item (448 + (rel * 8) + ff) of pst) * sign to total
        else if endgame is 1:
            add (6 * (item r2 of cen + item ff of cen)) * sign to total
        else:
            if use_pst is 1:
                add (item (384 + (rel * 8) + ff) of pst) * sign to total
            else:
                subtract (8 * rel) * sign from total
            set shield to 0
            for df from -1 to 1:
                if ff + df is at least 0 and ff + df is at most 7 and r2 + sign is at least 0 and r2 + sign is at most 7:
                    if item square(r2 + sign, ff + df) of board is sign:
                        add 8 to shield
            add shield * sign to total
    give back total

(=============================================================================)
(        v6 EVALUATION: tapered, safe mobility, king safety, pawn cache       )
(  feature bits: 512 tapered evaluation (the rest need it), 1024 safe mobility, )
(  2048 king safety, 4096 pawn-structure cache                               )
(=============================================================================)

(Masks built once: file masks, rank masks, neighbour-file masks, passed-pawn masks)
routine init_eval_masks:
    Let a number be called bit
    Let a number be called s
    Let a number be called t
    for f from 0 to 7:
        set item f of filemask to 0
        set item f of rankmask to 0
        set item f of adjmask to 0
    for r from 0 to 7:
        for f from 0 to 7:
            set s to (r * 8) + f
            set bit to item s of sqbb
            bitwise or item f of filemask with bit
            bitwise or item r of rankmask with bit
    for f from 0 to 7:
        if f is at least 1:
            bitwise or item f of adjmask with item (f - 1) of filemask
        if f is at most 6:
            bitwise or item f of adjmask with item (f + 1) of filemask
    for r from 0 to 7:
        for f from 0 to 7:
            set s to (r * 8) + f
            set item s of passmask to 0
            set item (64 + s) of passmask to 0
            for rr from 0 to 7:
                for ff from 0 to 7:
                    set t to (rr * 8) + ff
                    if ff is at least f - 1 and ff is at most f + 1:
                        if rr is greater than r:
                            bitwise or item s of passmask with item t of sqbb
                        if rr is less than r:
                            bitwise or item (64 + s) of passmask with item t of sqbb
    for i from 0 to 15:
        set item i of ev_k to 0
    for r from 0 to 7:
        for f from 0 to 7:
            set bit to item ((r * 8) + f) of sqbb
            if r is at least 4:
                bitwise or item 0 of ev_k with bit
            if r is at most 3:
                bitwise or item 1 of ev_k with bit
            if f is at least 2 and f is at most 5:
                if r is at least 1 and r is at most 3:
                    bitwise or item 2 of ev_k with bit
                if r is at least 4 and r is at most 6:
                    bitwise or item 3 of ev_k with bit
            if (r + f) mod 2 is 0:
                bitwise or item 4 of ev_k with bit
            if r is 0:
                bitwise or item 5 of ev_k with bit
            if r is 7:
                bitwise or item 6 of ev_k with bit
            if r is at least 3 and r is at most 5:
                bitwise or item 7 of ev_k with bit
            if r is at least 2 and r is at most 4:
                bitwise or item 8 of ev_k with bit
    set item 0 of ev_w to 0
    set item 2 of ev_w to 2
    set item 3 of ev_w to 2
    set item 4 of ev_w to 3
    set item 5 of ev_w to 5
    for i from 0 to 16383:
        set item i of pc_wp to -1
        set item i of pc_bp to -1

(Pawn structure, White minus Black, into ev_pmg and ev_peg.  Depends on the pawns only.)
define eval_pawns with wp and bp:
    Let a number be called col
    Let a number be called sg
    Let a number be called own
    Let a number be called foe
    Let a number be called bb
    Let a number be called s
    Let a number be called r
    Let a number be called f
    Let a number be called rel
    Let a number be called cnt
    Let a number be called mg
    Let a number be called eg
    Let a number be called tm
    Let a number be called te
    Let a number be called x
    for col from 0 to 1:
        set sg to 1
        set own to wp
        set foe to bp
        if col is 1:
            set sg to -1
            set own to bp
            set foe to wp
        set bb to own
        set tm to 0
        set te to 0
        while bb is not 0:
            count the trailing zeros of bb and store the result in s
            clear the lowest bit of bb
            set r to floor of (s / 8)
            set f to s - (r * 8)
            set rel to r
            if col is 1:
                set rel to 7 - r
            set x to item (64 + (rel * 8) + f) of pst
            add 100 + x to tm
            add 108 + x to te
            set x to own
            bitwise and x with item f of filemask
            count the set bits of x and store the result in cnt
            if cnt is greater than 1:
                subtract 8 from tm
                subtract 12 from te
            set x to own
            bitwise and x with item f of adjmask
            if x is 0:
                subtract 10 from tm
                subtract 14 from te
            set x to foe
            bitwise and x with item ((col * 64) + s) of passmask
            if x is 0:
                add item rel of pass_bonus to tm
                add 2 * (item rel of pass_bonus) to te
                if feature(268435456) is 1:
                    subtract 31 from tm
                    subtract 21 from te
        add tm * sg to mg
        add te * sg to eg
    set ev_pmg to mg
    set ev_peg to eg
    give back 0

(One side's pieces: values, piece-square tables, rook files, safe mobility, and the)
(attack units on the enemy king zone.  Adds into ev_mg and ev_eg from White's side.)
define eval_pieces with col:
    Let a number be called sg
    Let a number be called foe
    Let a number be called own_occ
    Let a number be called blocked
    Let a number be called occ
    Let a number be called zone
    Let a number be called bb
    Let a number be called s
    Let a number be called r
    Let a number be called f
    Let a number be called rel
    Let a number be called kind
    Let a number be called att
    Let a number be called x
    Let a number be called cnt
    Let a number be called mob
    Let a number be called mg
    Let a number be called eg
    Let a number be called units
    Let a number be called attackers
    Let a number be called own_pawns
    Let a number be called foe_pawns
    Let a number be called fm
    Let a number be called aacc
    set sg to 1
    if col is 1:
        set sg to -1
    set foe to 1 - col
    set own_occ to item col of bbo
    set occ to item 2 of bbo
    set blocked to own_occ
    bitwise or blocked with item foe of ev_pat
    set zone to item foe of ev_zone
    set own_pawns to item (6 + sg) of bbp
    set foe_pawns to item (6 - sg) of bbp
    set fm to feature(1024)
    set aacc to 0
    for kind from 2 to 5:
        set bb to item (6 + (sg * kind)) of bbp
        while bb is not 0:
            count the trailing zeros of bb and store the result in s
            clear the lowest bit of bb
            set r to floor of (s / 8)
            set f to s - (r * 8)
            set rel to r
            if col is 1:
                set rel to 7 - r
            if kind is 2:
                set att to item s of knight_att
                add 305 + (item (128 + (rel * 8) + f) of pst) to mg
                add 305 + (item (128 + (rel * 8) + f) of pst) to eg
            else if kind is 3:
                set att to bish_att(s, occ)
                add 325 + (item (192 + (rel * 8) + f) of pst) to mg
                add 325 + (item (192 + (rel * 8) + f) of pst) to eg
            else if kind is 4:
                set att to rook_att(s, occ)
                add 500 + (item (256 + (rel * 8) + f) of pst) to mg
                add 500 + (item (256 + (rel * 8) + f) of pst) to eg
                set x to own_pawns
                bitwise and x with item f of filemask
                if x is 0:
                    set x to foe_pawns
                    bitwise and x with item f of filemask
                    if x is 0:
                        add 20 to mg
                        add 20 to eg
                    else:
                        add 10 to mg
                        add 10 to eg
                if rel is 6:
                    add 15 to mg
                    add 25 to eg
            else:
                set att to bish_att(s, occ)
                bitwise or att with rook_att(s, occ)
                add 900 + (item (320 + (rel * 8) + f) of pst) to mg
                add 900 + (item (320 + (rel * 8) + f) of pst) to eg
            if fm is 1:
                set x to att
                bitwise and not x with blocked
                count the set bits of x and store the result in mob
                if kind is 2:
                    add (mob - 4) * 4 to mg
                    add (mob - 4) * 4 to eg
                else if kind is 3:
                    add (mob - 6) * 5 to mg
                    add (mob - 6) * 5 to eg
                else if kind is 4:
                    add (mob - 6) * 2 to mg
                    add (mob - 6) * 4 to eg
                else:
                    add (mob - 10) * 1 to mg
                    add (mob - 10) * 2 to eg
            bitwise or aacc with att
            set x to att
            bitwise and x with zone
            if x is not 0:
                count the set bits of x and store the result in cnt
                add cnt * (item kind of ev_w) to units
                add 1 to attackers
    add mg * sg to ev_mg
    add eg * sg to ev_eg
    set item col of ev_aa to aacc
    set item foe of ev_units to units
    set item foe of ev_att to attackers
    give back 0

define evaluate_tapered:
    Let a number be called col
    Let a number be called sg
    Let a number be called kb
    Let a number be called ks
    Let a number be called r
    Let a number be called f
    Let a number be called rel
    Let a number be called x
    Let a number be called y
    Let a number be called cnt
    Let a number be called wp
    Let a number be called bp
    Let a number be called h
    Let a number be called phase
    Let a number be called units
    Let a number be called pen
    Let a number be called mg
    Let a number be called eg
    Let a number be called nb
    Let a number be called nr
    Let a number be called nq
    Let a number be called wn
    Let a number be called bn
    Let a number be called own_occ
    Let a number be called ks_fm
    Let a number be called ksf
    Let a number be called e_p
    Let a number be called e_x
    Let a number be called e_y
    Let a number be called e_m
    Let a number be called e_g
    Let a number be called e_c
    Let a number be called e_s
    Let a number be called e_b
    Let a number be called e_d
    set wp to item 7 of bbp
    set bp to item 5 of bbp
    set ev_mg to 0
    set ev_eg to 0
    (pawn attack sets)
    set x to wp
    set y to wp
    shift x left by 9 bits
    bitwise and not x with item 0 of filemask
    shift y left by 7 bits
    bitwise and not y with item 7 of filemask
    bitwise or x with y
    set item 0 of ev_pat to x
    set x to bp
    set y to bp
    logical shift x right by 7 bits
    bitwise and not x with item 0 of filemask
    logical shift y right by 9 bits
    bitwise and not y with item 7 of filemask
    bitwise or x with y
    set item 1 of ev_pat to x
    (king zones)
    set item 0 of ev_zone to 0
    set item 1 of ev_zone to 0
    set kb to item 12 of bbp
    if kb is not 0:
        count the trailing zeros of kb and store the result in ks
        set x to item ks of king_att
        bitwise or x with kb
        set item 0 of ev_zone to x
    set kb to item 0 of bbp
    if kb is not 0:
        count the trailing zeros of kb and store the result in ks
        set x to item ks of king_att
        bitwise or x with kb
        set item 1 of ev_zone to x
    set item 0 of ev_units to 0
    set item 1 of ev_units to 0
    set item 0 of ev_att to 0
    set item 1 of ev_att to 0
    call eval_pieces with 0
    call eval_pieces with 1
    if feature(4096) is 1:
        set h to (wp * 2654435761) + (bp * 2246822507)
        logical shift h right by 50 bits
        if item h of pc_wp is wp and item h of pc_bp is bp:
            set ev_pmg to item h of pc_mg
            set ev_peg to item h of pc_eg
        else:
            call eval_pawns with wp and bp
            set item h of pc_wp to wp
            set item h of pc_bp to bp
            set item h of pc_mg to ev_pmg
            set item h of pc_eg to ev_peg
    else:
        call eval_pawns with wp and bp
    add ev_pmg to ev_mg
    add ev_peg to ev_eg
    set ksf to feature(2048)
    for col from 0 to 1:
        set sg to 1
        set kb to item 12 of bbp
        set own_occ to item 0 of bbo
        if col is 1:
            set sg to -1
            set kb to item 0 of bbp
            set own_occ to item 1 of bbo
        if kb is not 0:
            count the trailing zeros of kb and store the result in ks
            set r to floor of (ks / 8)
            set f to ks - (r * 8)
            set rel to r
            if col is 1:
                set rel to 7 - r
            add (item (384 + (rel * 8) + f) of pst) * sg to ev_mg
            add (item (448 + (rel * 8) + f) of pst) * sg to ev_eg
            if r + sg is at least 0 and r + sg is at most 7:
                set x to item (6 + sg) of bbp
                bitwise and x with item ks of king_att
                bitwise and x with item (r + sg) of rankmask
                count the set bits of x and store the result in cnt
                add 8 * cnt * sg to ev_mg
            if ksf is 1:
                set units to item col of ev_units
                set pen to units
                if item col of ev_att is at least 2:
                    set pen to floor of ((units * units) / 10)
                if pen is greater than 350:
                    set pen to 350
                if item (6 - (5 * sg)) of bbp is 0:
                    set pen to floor of (pen / 2)
                set x to rook_att(ks, item 2 of bbo)
                bitwise or x with bish_att(ks, item 2 of bbo)
                bitwise and not x with own_occ
                count the set bits of x and store the result in cnt
                if cnt is greater than 7:
                    add (cnt - 7) * 3 to pen
                subtract pen * sg from ev_mg
    (phase: knights and bishops 1, rooks 2, queens 4; 24 is the full board)
    set x to item 8 of bbp
    bitwise or x with item 9 of bbp
    bitwise or x with item 4 of bbp
    bitwise or x with item 3 of bbp
    count the set bits of x and store the result in nb
    set x to item 10 of bbp
    bitwise or x with item 2 of bbp
    count the set bits of x and store the result in nr
    set x to item 11 of bbp
    bitwise or x with item 1 of bbp
    count the set bits of x and store the result in nq
    set x to item 8 of bbp
    bitwise or x with item 9 of bbp
    count the set bits of x and store the result in wn
    set x to item 4 of bbp
    bitwise or x with item 3 of bbp
    count the set bits of x and store the result in bn
    if wp is 0 and bp is 0 and nr is 0 and nq is 0 and wn is at most 1 and bn is at most 1:
        give back 0
    set x to item 9 of bbp
    count the set bits of x and store the result in cnt
    if cnt is at least 2:
        add 30 to ev_mg
        add 45 to ev_eg
    set x to item 3 of bbp
    count the set bits of x and store the result in cnt
    if cnt is at least 2:
        subtract 30 from ev_mg
        subtract 45 from ev_eg
    if feature(268435456) is 1:
        (v8 terms, weights fitted on game results of 600000 TCEC positions and shrunk by a quarter)
        for col from 0 to 1:
            set sg to 1
            if col is 1:
                set sg to -1
            set e_m to 0
            set e_g to 0
            set e_p to item (6 + sg) of bbp
            set e_x to e_p
            bitwise and e_x with item col of ev_pat
            bitwise and e_x with item col of ev_k
            count the set bits of e_x and store the result in cnt
            add 33 * cnt to e_m
            set e_x to item (2 + col) of ev_k
            bitwise and not e_x with item (1 - col) of ev_pat
            set e_y to item 2 of bbo
            bitwise and not e_y with e_p
            bitwise and not e_x with e_y
            count the set bits of e_x and store the result in cnt
            add 10 * cnt to e_m
            subtract 3 * cnt from e_g
            set e_x to e_p
            bitwise and e_x with item 4 of ev_k
            count the set bits of e_x and store the result in e_c
            count the set bits of e_p and store the result in e_d
            set e_b to item (6 + (3 * sg)) of bbp
            while e_b is not 0:
                count the trailing zeros of e_b and store the result in e_s
                clear the lowest bit of e_b
                set e_x to item e_s of sqbb
                bitwise and e_x with item 4 of ev_k
                if e_x is not 0:
                    subtract 4 * e_c from e_m
                    subtract 4 * e_c from e_g
                else:
                    subtract 4 * (e_d - e_c) from e_m
                    subtract 4 * (e_d - e_c) from e_g
            set kb to item (6 + (6 * sg)) of bbp
            if kb is not 0:
                count the trailing zeros of kb and store the result in ks
                set e_x to item ks of king_att
                bitwise or e_x with kb
                bitwise or e_x with item col of ev_aa
                bitwise or e_x with item col of ev_pat
                bitwise and e_x with item (1 - col) of ev_zone
                count the set bits of e_x and store the result in cnt
                add 13 * cnt to e_m
                add 2 * cnt to e_g
                set f to ks mod 8
                set e_x to e_p
                bitwise and e_x with item f of filemask
                if e_x is 0:
                    subtract 14 from e_m
                    subtract 2 from e_g
                    set e_y to item (6 - sg) of bbp
                    bitwise and e_y with item f of filemask
                    if e_y is 0:
                        subtract 14 from e_m
                        subtract 2 from e_g
                for rr from 0 to 1:
                    set r to f - 1 + (2 * rr)
                    if r is at least 0 and r is at most 7:
                        set e_x to e_p
                        bitwise and e_x with item r of filemask
                        if e_x is 0:
                            subtract 8 from e_m
                            add 4 to e_g
            set e_x to item (6 + (4 * sg)) of bbp
            count the set bits of e_x and store the result in cnt
            if cnt is at least 2:
                subtract 59 from e_m
                subtract 29 from e_g
                set e_b to 0
                for r from 0 to 7:
                    set e_y to e_x
                    bitwise and e_y with item r of filemask
                    count the set bits of e_y and store the result in cnt
                    if cnt is at least 2:
                        set e_b to 1
                if e_b is 1:
                    add 26 to e_m
                    add 19 to e_g
            set e_x to item (6 + (2 * sg)) of bbp
            set e_y to item (6 + (3 * sg)) of bbp
            count the set bits of e_x and store the result in cnt
            if cnt is at least 2:
                subtract 10 from e_m
                subtract 12 from e_g
            set e_b to e_x
            bitwise or e_b with e_y
            bitwise and e_b with item (5 + col) of ev_k
            count the set bits of e_b and store the result in cnt
            subtract 10 * cnt from e_m
            subtract 12 * cnt from e_g
            set e_b to item (1 - col) of ev_pat
            set e_c to e_b
            if col is 0:
                logical shift e_c right by 8 bits
                bitwise or e_b with e_c
                set e_c to e_b
                logical shift e_c right by 16 bits
                bitwise or e_b with e_c
                set e_c to e_b
                logical shift e_c right by 32 bits
                bitwise or e_b with e_c
            else:
                shift e_c left by 8 bits
                bitwise or e_b with e_c
                set e_c to e_b
                shift e_c left by 16 bits
                bitwise or e_b with e_c
                set e_c to e_b
                shift e_c left by 32 bits
                bitwise or e_b with e_c
            set e_d to item (7 + col) of ev_k
            bitwise and not e_d with e_b
            bitwise and e_d with item col of ev_pat
            set e_x to e_d
            bitwise and e_x with item (6 + (2 * sg)) of bbp
            count the set bits of e_x and store the result in cnt
            add 20 * cnt to e_m
            add 22 * cnt to e_g
            set e_x to e_d
            bitwise and e_x with item (6 + (3 * sg)) of bbp
            count the set bits of e_x and store the result in cnt
            add 31 * cnt to e_m
            add 25 * cnt to e_g
            add e_m * sg to ev_mg
            add e_g * sg to ev_eg
    if feature(134217728) is 1:
        (threats: pieces hit by a pawn, and pieces that are attacked and not defended)
        for col from 0 to 1:
            set sg to 1
            if col is 1:
                set sg to -1
            set y to item (6 - (2 * sg)) of bbp
            bitwise or y with item (6 - (3 * sg)) of bbp
            bitwise or y with item (6 - (4 * sg)) of bbp
            bitwise or y with item (6 - (5 * sg)) of bbp
            set x to y
            bitwise and x with item col of ev_pat
            count the set bits of x and store the result in cnt
            add cnt * 40 * sg to ev_mg
            add cnt * 30 * sg to ev_eg
            set x to y
            bitwise and x with item col of ev_aa
            bitwise and not x with item (1 - col) of ev_aa
            bitwise and not x with item (1 - col) of ev_pat
            count the set bits of x and store the result in cnt
            add cnt * 20 * sg to ev_mg
            add cnt * 15 * sg to ev_eg
    if feature(67108864) is 1:
        add 16 * nn_stm to ev_mg
        add 10 * nn_stm to ev_eg
    set phase to nb + (2 * nr) + (4 * nq)
    if phase is greater than 24:
        set phase to 24
    give back floor of (((ev_mg * phase) + (ev_eg * (24 - phase))) / 24)

(Features added in v7.1, all measured against the default over 100 ms games: 4194304 static exchange)
(evaluation, used to prune losing captures in quiescence and, at low depth, in the main search, +49 +- 55;)
(16777216 reductions for late losing captures, +45 +- 52 on top of the first; both are on by default, and)
(together +45 +- 39 over 200 games.  Off by default, no measurable gain: 8388608 ProbCut, +14 +- 57;)
(67108864 tempo bonus, -7 +- 54; 134217728 threats on pieces, -14 +- 52.)
(Which evaluation and extras are on: feat is a sum of 1 the v3.1 evaluation, 2 mate)
(distance pruning, 4 internal iterative reduction, 8 repetition draws, 16 counter)
(moves, 32 history-aware reductions; 15 is the default (counter moves and history reductions did not help in matches), 63 is everything, 0 is v3.0.)
(=============================================================================)
(      NNUE - v7.0: HalfKAv2 features, two accumulators, small dense layers   )
(=============================================================================)
(The evaluation can be a neural network that is updated move by move - an efficiently updatable)
(neural network.  Input: HalfKAv2 - for each side's point of view one feature for every piece on)
(a square, relative to that side's king square: 64 king squares x 11 piece planes x 64 squares =)
(45056 features, the board turned over for Black.  Layer 1 - the feature transformer, H values per)
(side, whole numbers: 254 means 1.0 is kept in an accumulator for every ply and changed by adding)
(and taking away only the features a move changes; a king move rebuilds that side's accumulator.)
(The two accumulators - side to move first go through clipped ReLU, then dense layers with)
(8 bit weights: 2H -> L1 -> L2 -> 1.  Weights come from apexz.nnue - format: nnue/nnue.py.)
Create a shared array named nn_fw with 2883648 slots
Create a shared array named nn_fb with 64 slots
Create a shared array named nn_l1w with 8192 slots
Create a shared array named nn_l1b with 128 slots
Create a shared array named nn_l2w with 4096 slots
Create a shared array named nn_l2b with 128 slots
Create a shared array named nn_ow with 128 slots
Create a shared array named nn_sw with 128 slots
Create a shared array named nn_obv with 8 slots
Create an array named nn_acc with 10752 slots
Create an array named nn_ks with 168 slots
Create an array named nn_x with 128 slots
Create an array named nn_s1 with 16 slots
Create an array named nn_s2 with 16 slots
Create an array named nn_q with 16 slots
(nn_ready: a net is loaded.  nn_on: use it.  nn_dbg: check the updated accumulators against a rebuild.)
Let a number be called nn_ready
Let a number be called nn_on
Let a number be called nn_dbg
Let a number be called nn_h
Let a number be called nn_l1
Let a number be called nn_l2
Let a number be called nn_ob
Let a number be called nn_k
Let a number be called nn_cur
Let a number be called nn_bad
Let a number be called max_ply
Let a number be called nn_pct
Let a number be called nn_v2
Let a number be called nn_nb
Let a number be called nn_zr

(The row of nn_fw, as an offset, of the feature: perspective - 0 white, 1 black, that side's king)
(square - 0..63, already turned over for Black, piece code pc - +-1..6 and mailbox square m.)
define nn_row with persp and ksq and pc and m:
    Let a number be called kind
    Let a number be called plane
    Let a number be called s
    Let a number be called kf
    calculate the absolute value of pc and store the result in kind
    if kind is 6:
        set plane to 10
    else:
        set plane to 2 * (kind - 1)
        if (pc is greater than 0 and persp is 1) or (pc is less than 0 and persp is 0):
            add 1 to plane
    set s to (floor of (m / 10) - 2) * 8
    set s to s + ((m mod 10) - 1)
    if persp is 1:
        set s to (s mod 8) + ((7 - floor of (s / 8)) * 8)
    if nn_v2 is 1:
        set kf to ksq mod 8
        if kf is at least 4:
            set s to s - (2 * (s mod 8)) + 7
            set kf to 7 - kf
        give back (((floor of (ksq / 8) * 4) + kf) * 704 + (plane * 64) + s) * nn_h
    give back ((ksq * 704) + (plane * 64) + s) * nn_h

(Rebuild one side's accumulator for ply from the board.)
define nn_refresh_p with ply and persp:
    Let a number be called base
    Let a number be called ksq
    Let a number be called r
    Let a number be called f
    Let a number be called m
    Let a number be called pc
    Let a number be called row
    set base to ((ply * 2) + persp) * nn_h
    set ksq to item ((ply * 2) + persp) of nn_ks
    for i from 0 to nn_h - 1:
        set item (base + i) of nn_acc to item i of nn_fb
    for r from 0 to 7:
        for f from 0 to 7:
            set m to 21 + (r * 10) + f
            set pc to item m of board
            if pc is not 0:
                set row to nn_row(persp, ksq, pc, m)
                for i from 0 to nn_h - 1:
                    set item (base + i) of nn_acc to item (base + i) of nn_acc + item (row + i) of nn_fw
    give back 0

(Rebuild both accumulators for ply from the board.)
define nn_refresh with ply:
    Let a number be called r
    Let a number be called f
    Let a number be called pc
    for r from 0 to 7:
        for f from 0 to 7:
            set pc to item (21 + (r * 10) + f) of board
            if pc is 6:
                set item (ply * 2) of nn_ks to (r * 8) + f
            if pc is -6:
                set item ((ply * 2) + 1) of nn_ks to ((7 - r) * 8) + f
    call nn_refresh_p with ply and 0
    call nn_refresh_p with ply and 1
    set nn_cur to ply
    give back 0

(Called at the end of apply_move: the accumulators of ply + 1 from those of ply.)
define nn_update with ply and moving and took and src and dst and final and special:
    Let a number be called kind
    Let a number be called col
    Let a number be called s
    Let a number be called persp
    Let a number be called nb
    Let a number be called ob
    Let a number be called ks
    Let a number be called rs
    Let a number be called ra
    Let a number be called rc
    Let a number be called rk
    Let a number be called from2
    Let a number be called to2
    if ply is less than 1:
        give back 0
    calculate the absolute value of moving and store the result in kind
    set col to 0
    if moving is less than 0:
        set col to 1
    set item ((ply + 1) * 2) of nn_ks to item (ply * 2) of nn_ks
    set item (((ply + 1) * 2) + 1) of nn_ks to item ((ply * 2) + 1) of nn_ks
    if kind is 6:
        set s to (floor of (dst / 10) - 2) * 8
        set s to s + ((dst mod 10) - 1)
        if col is 1:
            set s to (s mod 8) + ((7 - floor of (s / 8)) * 8)
        set item (((ply + 1) * 2) + col) of nn_ks to s
    for persp from 0 to 1:
        if kind is 6 and persp is col:
            call nn_refresh_p with (ply + 1) and persp
        else:
            set nb to (((ply + 1) * 2) + persp) * nn_h
            set ob to ((ply * 2) + persp) * nn_h
            set ks to item ((ply * 2) + persp) of nn_ks
            set rs to nn_row(persp, ks, moving, src)
            set ra to nn_row(persp, ks, final, dst)
            set rc to nn_zr * nn_h
            if special is 3:
                set rc to nn_row(persp, ks, 0 - moving, dst - (10 * moving))
            else if took is not 0:
                set rc to nn_row(persp, ks, took, dst)
            for i from 0 to nn_h - 1:
                set item (nb + i) of nn_acc to (item (ob + i) of nn_acc) - (item (rs + i) of nn_fw) + (item (ra + i) of nn_fw) - (item (rc + i) of nn_fw)
            if special is 1 or special is 2:
                set rk to 4 * moving / 6
                set from2 to src + 3
                set to2 to src + 1
                if special is 2:
                    set from2 to src - 4
                    set to2 to src - 1
                set rs to nn_row(persp, ks, rk, from2)
                set ra to nn_row(persp, ks, rk, to2)
                for i from 0 to nn_h - 1:
                    set item (nb + i) of nn_acc to (item (nb + i) of nn_acc) - (item (rs + i) of nn_fw) + (item (ra + i) of nn_fw)
    set nn_cur to ply + 1
    give back 0

(Accumulators hold 254 for 1.0, dense weights are 1024 for 1.0, layer 1 divides by 2048, later layers hold 127 for 1.0. Static evaluation from the accumulators of nn_cur, in centipawns for White.)
(Version 2 network: king buckets with the board mirrored left to right, pairwise product of the two halves of each accumulator, a clipped and a squared copy of layer 1 feeding layer 2, a skip from layer 1 to the output, and one set of dense layers per piece count bucket.)
define evaluate_nn2:
    Let a number be called h
    Let a number be called hh
    Let a number be called bs
    Let a number be called bo
    Let a number be called v
    Let a number be called w
    Let a number be called xv
    Let a number be called row
    Let a number be called out
    Let a number be called pcs
    Let a number be called bk
    Let a number be called o1
    Let a number be called o2
    set h to nn_h
    set hh to floor of (h / 2)
    if nn_stm is 1:
        set bs to nn_cur * 2 * h
        set bo to bs + h
    else:
        set bo to nn_cur * 2 * h
        set bs to bo + h
    set pcs to 0
    for r from 0 to 7:
        for f from 0 to 7:
            if item (21 + (r * 10) + f) of board is not 0:
                add 1 to pcs
    set bk to floor of ((pcs - 1) / 4)
    if bk is greater than nn_nb - 1:
        set bk to nn_nb - 1
    if bk is less than 0:
        set bk to 0
    for i from 0 to hh - 1:
        set v to item (bs + i) of nn_acc
        if v is less than 0:
            set v to 0
        if v is greater than 254:
            set v to 254
        set w to item (bs + hh + i) of nn_acc
        if w is less than 0:
            set w to 0
        if w is greater than 254:
            set w to 254
        set item i of nn_x to floor of ((v * w) / 254)
        set v to item (bo + i) of nn_acc
        if v is less than 0:
            set v to 0
        if v is greater than 254:
            set v to 254
        set w to item (bo + hh + i) of nn_acc
        if w is less than 0:
            set w to 0
        if w is greater than 254:
            set w to 254
        set item (hh + i) of nn_x to floor of ((v * w) / 254)
    set o1 to bk * h * nn_l1
    for o from 0 to nn_l1 - 1:
        set item o of nn_s1 to item ((bk * nn_l1) + o) of nn_l1b
    for i from 0 to h - 1:
        set xv to item i of nn_x
        if xv is not 0:
            set row to o1 + (i * nn_l1)
            for o from 0 to nn_l1 - 1:
                set item o of nn_s1 to (item o of nn_s1) + ((item (row + o) of nn_l1w) * xv)
    set out to item bk of nn_obv
    for o from 0 to nn_l1 - 1:
        set v to floor of (((item o of nn_s1) + 1024) / 2048)
        if v is less than 0:
            set v to 0
        if v is greater than 127:
            set v to 127
        set item o of nn_s1 to v
        set item o of nn_q to floor of ((v * v) / 127)
        set out to out + (v * item ((bk * nn_l1) + o) of nn_sw)
    set o2 to bk * 2 * nn_l1 * nn_l2
    for o from 0 to nn_l2 - 1:
        set item o of nn_s2 to item ((bk * nn_l2) + o) of nn_l2b
    for i from 0 to nn_l1 - 1:
        set xv to item i of nn_s1
        if xv is not 0:
            set row to o2 + (i * nn_l2)
            for o from 0 to nn_l2 - 1:
                set item o of nn_s2 to (item o of nn_s2) + ((item (row + o) of nn_l2w) * xv)
        set xv to item i of nn_q
        if xv is not 0:
            set row to o2 + ((nn_l1 + i) * nn_l2)
            for o from 0 to nn_l2 - 1:
                set item o of nn_s2 to (item o of nn_s2) + ((item (row + o) of nn_l2w) * xv)
    for o from 0 to nn_l2 - 1:
        set v to floor of (((item o of nn_s2) + 512) / 1024)
        if v is less than 0:
            set v to 0
        if v is greater than 127:
            set v to 127
        set out to out + ((item ((bk * nn_l2) + o) of nn_ow) * v)
    set v to (out * nn_k) / 130048
    if nn_stm is -1:
        set v to 0 - v
    give back v

define evaluate_nn:
    if nn_v2 is 1:
        give back evaluate_nn2()
    Let a number be called h
    Let a number be called bs
    Let a number be called bo
    Let a number be called v
    Let a number be called xv
    Let a number be called row
    Let a number be called out
    set h to nn_h
    if nn_stm is 1:
        set bs to nn_cur * 2 * h
        set bo to bs + h
    else:
        set bo to nn_cur * 2 * h
        set bs to bo + h
    for i from 0 to h - 1:
        set v to item (bs + i) of nn_acc
        if v is less than 0:
            set v to 0
        if v is greater than 254:
            set v to 254
        set item i of nn_x to v
        set v to item (bo + i) of nn_acc
        if v is less than 0:
            set v to 0
        if v is greater than 254:
            set v to 254
        set item (h + i) of nn_x to v
    for o from 0 to nn_l1 - 1:
        set item o of nn_s1 to item o of nn_l1b
    for i from 0 to (2 * h) - 1:
        set xv to item i of nn_x
        if xv is not 0:
            set row to i * nn_l1
            for o from 0 to nn_l1 - 1:
                set item o of nn_s1 to (item o of nn_s1) + ((item (row + o) of nn_l1w) * xv)
    for o from 0 to nn_l1 - 1:
        set v to item o of nn_s1
        if v is less than 1:
            set v to 0
        else:
            set v to floor of ((v + 1024) / 2048)
            if v is greater than 127:
                set v to 127
        set item o of nn_s1 to v
    for o from 0 to nn_l2 - 1:
        set item o of nn_s2 to item o of nn_l2b
    for i from 0 to nn_l1 - 1:
        set xv to item i of nn_s1
        if xv is not 0:
            set row to i * nn_l2
            for o from 0 to nn_l2 - 1:
                set item o of nn_s2 to (item o of nn_s2) + ((item (row + o) of nn_l2w) * xv)
    set out to nn_ob
    for o from 0 to nn_l2 - 1:
        set v to item o of nn_s2
        if v is less than 1:
            set v to 0
        else:
            set v to floor of ((v + 512) / 1024)
            if v is greater than 127:
                set v to 127
        set out to out + ((item o of nn_ow) * v)
    set v to (out * nn_k) / 130048
    if nn_stm is -1:
        set v to 0 - v
    give back v

(Debug aid - UCI option NNDebug: rebuild the accumulators of nn_cur in a spare slot and compare.)
define nn_check:
    Let a number be called ok
    Let a number be called cur
    Let a number be called b1
    Let a number be called b2
    set cur to nn_cur
    set ok to 1
    call nn_refresh with 79
    for p from 0 to 1:
        set b1 to ((cur * 2) + p) * nn_h
        set b2 to ((79 * 2) + p) * nn_h
        for i from 0 to nn_h - 1:
            if item (b1 + i) of nn_acc is not item (b2 + i) of nn_acc:
                set ok to 0
    set nn_cur to cur
    if ok is 0:
        add 1 to nn_bad
        print "info string NNUE MISMATCH at ply ", cur
    give back ok

(A null move changes nothing in the accumulators: ply + 1 gets the same ones.)
define nn_copy with ply:
    Let a number be called a
    Let a number be called b
    set item ((ply + 1) * 2) of nn_ks to item (ply * 2) of nn_ks
    set item (((ply + 1) * 2) + 1) of nn_ks to item ((ply * 2) + 1) of nn_ks
    set a to ply * 2 * nn_h
    set b to (ply + 1) * 2 * nn_h
    for i from 0 to (2 * nn_h) - 1:
        set item (b + i) of nn_acc to item (a + i) of nn_acc
    set nn_cur to ply + 1
    give back 0

define feature with bit:
    Let a number be called q
    set q to floor of (feat / bit)
    give back q mod 2

define evaluate_hce:
    if feature(512) is 1:
        give back evaluate_tapered()
    if feature(1) is 1:
        give back evaluate_full()
    give back evaluate_basic()

(With a network loaded, the evaluation is the hand-written one plus what the network adds.)
define evaluate:
    if nn_on is 1:
        if nn_dbg is 1:
            call nn_check
        give back evaluate_hce() + floor of ((evaluate_nn() * nn_pct) / 100)
    give back evaluate_hce()

(=============================================================================)
(                   HASHING, MAKING AND UNMAKING MOVES                        )
(=============================================================================)

(A number that identifies the position  - pieces, castling rights, en passant,)
(who moves.  Sums of random numbers stay exact in a Zoomy number.)
define scan_hash:
    Let a number be called total
    Let a number be called sq
    Let a number be called piece
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            set piece to item sq of board
            if piece is not 0:
                add item (((piece + 6) * 120) + sq) of zob to total
    give back total

(The key of the current position: the piece hash plus castling rights, en passant)
(and who moves.)
define position_key with side:
    Let a number be called total
    set total to hash_pieces
    for i from 0 to 3:
        if item i of castle is 1:
            add item (1540 + i) of zob to total
    add ep_sq * 7919 to total
    if side is 1:
        add 91827364 to total
    give back total

(Which pruning techniques are on: pruning is a sum of 1 transposition table, 2 reverse)
(futility, 4 razoring, 8 null move, 16 futility, 32 late-move pruning, 64 late-move)
(reductions, 128 aspiration windows, 256 quiescence pruning; 511 is everything, 0 is)
(plain alpha-beta with quiescence.  use gives 1 when a technique is on.)
define use with bit:
    Let a number be called q
    set q to floor of (pruning / bit)
    give back q mod 2

(1 when side still has a knight, bishop, rook or queen.)
define has_pieces with side:
    Let a number be called sq
    Let a number be called kind
    for r from 0 to 7:
        for f from 0 to 7:
            set sq to square(r, f)
            if item sq of board * side is greater than 0:
                calculate the absolute value of item sq of board and store the result in kind
                if kind is at least 2 and kind is at most 5:
                    give back 1
    give back 0

(Play src -> dst, remembering in slot ply of the undo arrays what is needed to)
(take it back: castling  - the rook comes too, en passant, promotion to a queen,)
(castling rights and the en passant square.)
define apply_move with ply and src and dst:
    Let a number be called moving
    Let a number be called took
    Let a number be called kind
    Let a number be called final
    Let a number be called diff
    Let a number be called special
    Let a number be called corner
    Let a number be called rook
    set moving to item src of board
    set took to item dst of board
    calculate the absolute value of moving and store the result in kind
    set diff to dst - src
    set final to moving
    set special to 0
    set item ply of u_moving to moving
    set item ply of u_took to took
    set item ply of u_ep to ep_sq
    for i from 0 to 3:
        set item ((ply * 4) + i) of u_castle to item i of castle
    set item src of board to 0
    if kind is 6 and diff is 2:
        set item (src + 3) of board to 0
        set item (src + 1) of board to 4 * moving / 6
        set special to 1
    if kind is 6 and diff is -2:
        set item (src - 4) of board to 0
        set item (src - 1) of board to 4 * moving / 6
        set special to 2
    if kind is 1 and dst is ep_sq and took is 0:
        set item (dst - (10 * moving)) of board to 0
        set special to 3
    set ep_sq to 0
    if kind is 1 and (diff is 20 or diff is -20):
        set ep_sq to src + (diff / 2)
    if moving is 6:
        set item 0 of castle to 0
        set item 1 of castle to 0
    if moving is -6:
        set item 2 of castle to 0
        set item 3 of castle to 0
    for i from 0 to 3:
        set corner to item i of corner_sq
        if src is corner or dst is corner:
            set item i of castle to 0
    if moving is 1 and dst is at least 91:
        set final to 5
    if moving is -1 and dst is at most 28:
        set final to -5
    set item ply of u_special to special
    (keep the piece hash up to date)
    set item ply of u_hash to hash_pieces
    subtract item (((moving + 6) * 120) + src) of zob from hash_pieces
    if took is not 0:
        subtract item (((took + 6) * 120) + dst) of zob from hash_pieces
    add item (((final + 6) * 120) + dst) of zob to hash_pieces
    set rook to 4 * moving / 6
    if special is 1:
        subtract item (((rook + 6) * 120) + src + 3) of zob from hash_pieces
        add item (((rook + 6) * 120) + src + 1) of zob to hash_pieces
    if special is 2:
        subtract item (((rook + 6) * 120) + src - 4) of zob from hash_pieces
        add item (((rook + 6) * 120) + src - 1) of zob to hash_pieces
    if special is 3:
        subtract item ((((0 - moving) + 6) * 120) + dst - (10 * moving)) of zob from hash_pieces
    call bb_toggle with moving and src
    if took is not 0:
        call bb_toggle with took and dst
    call bb_toggle with final and dst
    if special is 1:
        call bb_toggle with rook and (src + 3)
        call bb_toggle with rook and (src + 1)
    if special is 2:
        call bb_toggle with rook and (src - 4)
        call bb_toggle with rook and (src - 1)
    if special is 3:
        call bb_toggle with (0 - moving) and (dst - (10 * moving))
    set item dst of board to final
    if nn_on is 1:
        call nn_update with ply and moving and took and src and dst and final and special

define undo_move with ply and src and dst:
    Let a number be called moving
    Let a number be called special
    Let a number be called final
    Let a number be called took
    Let a number be called rook
    set moving to item ply of u_moving
    set special to item ply of u_special
    set took to item ply of u_took
    set final to item dst of board
    set rook to 4 * moving / 6
    call bb_toggle with final and dst
    if took is not 0:
        call bb_toggle with took and dst
    call bb_toggle with moving and src
    if special is 1:
        call bb_toggle with rook and (src + 3)
        call bb_toggle with rook and (src + 1)
    if special is 2:
        call bb_toggle with rook and (src - 4)
        call bb_toggle with rook and (src - 1)
    if special is 3:
        call bb_toggle with (0 - moving) and (dst - (10 * moving))
    set item src of board to moving
    set item dst of board to item ply of u_took
    if special is 1:
        set item (src + 1) of board to 0
        set item (src + 3) of board to 4 * moving / 6
    if special is 2:
        set item (src - 1) of board to 0
        set item (src - 4) of board to 4 * moving / 6
    if special is 3:
        set item (dst - (10 * moving)) of board to -1 * moving
    set ep_sq to item ply of u_ep
    set hash_pieces to item ply of u_hash
    for i from 0 to 3:
        set item i of castle to item ((ply * 4) + i) of u_castle
    set nn_cur to ply

(=============================================================================)
(                  QUIESCENCE SEARCH: SETTLE THE CAPTURES                     )
(=============================================================================)

(Scores are always from the point of view of the side to move  - negamax.)
(Instead of trusting a static evaluation in the middle of an exchange, keep)
(capturing until the position is quiet.  Pruning here: "stand pat"  - the side)
(to move can always decline to capture, delta pruning  - a capture that cannot)
(lift the score to alpha even with a bonus is skipped and SEE pruning  - a)
(capture a cheaper piece can answer is skipped.)
Create an array named see_g with 40 slots

(Every piece of either colour that attacks bitboard square t when the pieces are on occ,)
(sliders looking through whatever is no longer in occ.)
define attackers_to with t and occ:
    Let a number be called x
    Let a number be called y
    Let a number be called z
    set x to item (64 + t) of pawn_att
    bitwise and x with item 7 of bbp
    set y to item t of pawn_att
    bitwise and y with item 5 of bbp
    bitwise or x with y
    set y to item t of knight_att
    set z to item 8 of bbp
    bitwise or z with item 4 of bbp
    bitwise and y with z
    bitwise or x with y
    set y to item t of king_att
    set z to item 12 of bbp
    bitwise or z with item 0 of bbp
    bitwise and y with z
    bitwise or x with y
    set z to item 11 of bbp
    bitwise or z with item 1 of bbp
    set y to item 9 of bbp
    bitwise or y with item 3 of bbp
    bitwise or y with z
    bitwise and y with bish_att(t, occ)
    bitwise or x with y
    set y to item 10 of bbp
    bitwise or y with item 2 of bbp
    bitwise or y with z
    bitwise and y with rook_att(t, occ)
    bitwise or x with y
    bitwise and x with occ
    give back x

(Static exchange evaluation of the capture src to dst, in piece values from the mover's point)
(of view: both sides keep recapturing with their cheapest piece and stop when it no longer pays.)
define see with src and dst:
    Let a number be called t
    Let a number be called fs
    Let a number be called occ
    Let a number be called att
    Let a number be called d
    Let a number be called attv
    Let a number be called stm
    Let a number be called sg
    Let a number be called kind
    Let a number be called found
    Let a number be called x
    Let a number be called s2
    Let a number be called v
    Let a number be called mover
    set t to item dst of m2b
    set fs to item src of m2b
    set v to item dst of board
    calculate the absolute value of v and store the result in v
    set mover to item src of board
    set stm to 1
    if mover is less than 0:
        set stm to 0
    calculate the absolute value of mover and store the result in mover
    if v is 0 and mover is 1 and dst is ep_sq:
        set v to 1
    set item 0 of see_g to item v of piece_value
    set attv to item mover of piece_value
    set occ to item 2 of bbo
    set x to 1
    shift x left by fs bits
    bitwise and not occ with x
    set att to attackers_to(t, occ)
    set d to 0
    while d is less than 30:
        set sg to 1
        if stm is 1:
            set sg to -1
        set found to 0
        set x to 0
        for kind from 1 to 6:
            if found is 0:
                set x to att
                bitwise and x with item (6 + (sg * kind)) of bbp
                if x is not 0:
                    set found to kind
        if found is 0:
            stop
        add 1 to d
        set item d of see_g to attv - (item (d - 1) of see_g)
        set attv to item found of piece_value
        count the trailing zeros of x and store the result in s2
        set x to 1
        shift x left by s2 bits
        bitwise and not occ with x
        set att to attackers_to(t, occ)
        set stm to 1 - stm
    while d is greater than 0:
        set x to 0 - (item (d - 1) of see_g)
        if item d of see_g is greater than x:
            set x to item d of see_g
        set item (d - 1) of see_g to 0 - x
        subtract 1 from d
    give back item 0 of see_g

define quiesce with ply and alpha and beta and side:
    Let a number be called stand
    Let a number be called count
    Let a number be called base
    Let a number be called slot
    Let a number be called src
    Let a number be called dst
    Let a number be called score
    Let a number be called gain
    Let a number be called victim
    add 1 to nodes
    set nn_stm to side
    set stand to side * evaluate()
    if ply is at least max_ply:
        give back stand
    if stand is at least beta:
        give back stand
    if use(256) is 1 and stand + 1000 is less than alpha:
        give back alpha
    if stand is greater than alpha:
        set alpha to stand
    set qmode to 1
    call generate with ply and side
    set qmode to 0
    set count to item ply of mv_count
    call score_moves with ply and side and 0
    set base to (ply - 1) * 256
    for i from 0 to count - 1:
        call pick_best with ply and i and count
        set slot to base + i
        set src to item slot of mv_from
        set dst to item slot of mv_to
        if use(256) is 1:
            set victim to item dst of board
            calculate the absolute value of victim and store the result in victim
            set gain to item victim of piece_value
            if victim is 0:
                set gain to 100
            if stand + gain + 200 is less than alpha:
                skip
            if item slot of mv_score is less than 10000:
                skip
        if feature(4194304) is 1:
            set victim to item dst of board
            calculate the absolute value of victim and store the result in victim
            if victim is not 0:
                set gain to item src of board
                calculate the absolute value of gain and store the result in gain
                if (item victim of piece_value) is less than (item gain of piece_value):
                    if see(src, dst) is less than 0:
                        skip
        call apply_move with ply and src and dst
        set score to 0 - quiesce(ply + 1, 0 - beta, 0 - alpha, 0 - side)
        call undo_move with ply and src and dst
        if score is at least beta:
            give back score
        if score is greater than alpha:
            set alpha to score
    give back alpha

(=============================================================================)
(                         THE SEARCH  - NEGAMAX, PVS                           )
(=============================================================================)

(Ply 1 is the move being chosen, ply 2 the reply, and so on; side is 1 for White and -1 for)
(Black.  The score is from the point of view of the side to move, so after each)
(move it is negated and the window turned round.  depth counts the plies still)
(to search; at depth 0 the quiescence search takes over.  The best first move)
(for Black is left in best_from and best_to.)
(Techniques, in the order they appear:)
(  check extension          search one ply deeper when in check)
(  transposition table      reuse results for positions reached before)
(  reverse futility         far above beta at low depth: stop, it will fail high)
(  razoring                 far below alpha at low depth: confirm with quiescence)
(  null-move pruning        pass the turn; still above beta: stop, it will fail high)
(  futility pruning         quiet moves at low depth that cannot reach alpha)
(  late-move pruning        quiet moves tried very late at low depth)
(  late-move reductions     late quiet moves are searched shallower first)
(  PVS                      later moves get a one-point window, re-searched if needed)
(  killers and history      remember quiet moves that caused cutoffs)
(=============================================================================)
(      SYZYGY TABLEBASE PROBER  - WDL  - .rtbw AND DTZ  - .rtbz, 3 TO 7 MEN       )
(  A Zoomy port of the table decoding of Fathom, checked against python-chess.  )
(  Tables are read from disk on demand  - nothing is loaded up front, headers    )
(  are kept in a small cache per worker, and every probe opens, reads, closes.  )
(=============================================================================)
Create an array named tb_offdiag with 64 slots
Create an array named tb_triangle with 64 slots
Create an array named tb_flipdiag with 64 slots
Create an array named tb_lower with 64 slots
Create an array named tb_diag with 64 slots
Create an array named tb_flap with 128 slots
Create an array named tb_twist with 128 slots
Create an array named tb_kk with 640 slots
Create an array named tb_binom with 448 slots
Create an array named tb_pidx with 288 slots
Create an array named tb_pff with 24 slots
Create an array named tb_pfr with 36 slots
Create an array named tb_p with 8 slots
Create an array named tb_wdl2map with 8 slots
Create an array named tb_paflags with 8 slots
Create an array named tb_cnt with 16 slots
Create an array named tb_psq with 128 slots
Create an array named tb_brd with 64 slots
Create an array named tb_fn with 600 slots
Create an array named tb_dirs with 520 slots
Create an array named tb_dstart with 16 slots
Create a shared array named tb_meta with 262144 slots
Create a shared array named tb_pool with 12800000 slots
Create a shared array named tb_ctl with 256 slots
Let a number be called tb_turn
Let a number be called tb_wid
Let a number be called tb_dirn
Let a number be called tb_min
Let a number be called tb_fl
Let a number be called tb_np
Let a number be called tb_sz0
Let a number be called tb_sz1
Let a number be called tb_sz2
Let a number be called tb_num
Let a number be called tb_haspawns
Let a number be called tb_kkenc
Let a number be called tb_p0
Let a number be called tb_p1
Let a number be called tb_on
Let a number be called tb_maxmen
Let a number be called tb_probes
Let a number be called tb_hits

(Little-endian reads from the open file)
define tb_at8 with foff:
    Let a number be called b
    move to byte foff of the file
    read the next byte into b
    give back b

define tb_at16 with foff:
    Let a number be called b0
    Let a number be called b1
    move to byte foff of the file
    read the next byte into b0
    read the next byte into b1
    give back b0 + (b1 * 256)

define tb_at32 with foff:
    Let a number be called b0
    Let a number be called b1
    Let a number be called b2
    Let a number be called b3
    move to byte foff of the file
    read the next byte into b0
    read the next byte into b1
    read the next byte into b2
    read the next byte into b3
    give back b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)

(Room in this worker's slice of the shared pool - returns the first slot)
define tb_alloc with n:
    Let a number be called at
    set at to item ((tb_wid * 2) + 0) of tb_ctl
    set item ((tb_wid * 2) + 0) of tb_ctl to at + n
    give back (tb_wid * 200000) + at

(Counts k like pieces on n squares)
define tb_subfactor with k and n:
    Let a number be called f
    Let a number be called l
    set f to n
    set l to 1
    for i from 1 to k - 1:
        set f to f * (n - i)
        set l to l * (i + 1)
    give back f / l

routine tb_init_consts:
    set item 0 of tb_triangle to 6
    set item 2 of tb_triangle to 1
    set item 3 of tb_triangle to 2
    set item 4 of tb_triangle to 2
    set item 5 of tb_triangle to 1
    set item 7 of tb_triangle to 6
    set item 9 of tb_triangle to 7
    set item 10 of tb_triangle to 3
    set item 11 of tb_triangle to 4
    set item 12 of tb_triangle to 4
    set item 13 of tb_triangle to 3
    set item 14 of tb_triangle to 7
    set item 16 of tb_triangle to 1
    set item 17 of tb_triangle to 3
    set item 18 of tb_triangle to 8
    set item 19 of tb_triangle to 5
    set item 20 of tb_triangle to 5
    set item 21 of tb_triangle to 8
    set item 22 of tb_triangle to 3
    set item 23 of tb_triangle to 1
    set item 24 of tb_triangle to 2
    set item 25 of tb_triangle to 4
    set item 26 of tb_triangle to 5
    set item 27 of tb_triangle to 9
    set item 28 of tb_triangle to 9
    set item 29 of tb_triangle to 5
    set item 30 of tb_triangle to 4
    set item 31 of tb_triangle to 2
    set item 32 of tb_triangle to 2
    set item 33 of tb_triangle to 4
    set item 34 of tb_triangle to 5
    set item 35 of tb_triangle to 9
    set item 36 of tb_triangle to 9
    set item 37 of tb_triangle to 5
    set item 38 of tb_triangle to 4
